from fbt.util import safe_add_option


def _instantiate_vars():
    vars = SConscript("site_scons/commandline.scons")
    vars.AddVariables(
        BoolVariable(
            "SIL917_INSECURE",
            help="Set for insecure (non-secure-boot) Si917 devices; disables key wrapping during provisioning",
            default=True,
        ),
        (
            "INTERCOM_FORCE_VERSION",
            "Force intercom handshake version string (overrides the default git-hash based check)",
            "",
        ),
    )
    return vars


commandline_vars = _instantiate_vars()

commandline_vars.AddVariables(
    ("SIL_TARGET_HW", "Target definition for Silabs chip", "65"),
    ("U5_TARGET_HW", "Target definition for STM32U5 chip", "22"),
)

_TARGET_OPTIONS = {
    "flash_usb": [
        ("--resources",    {"dest": "flash_resources", "action": "store_true",  "help": "Include U5 resources"}),
        ("--no-resources", {"dest": "flash_resources", "action": "store_false", "help": "Exclude U5 resources"}),
        ("--sil-m4",       {"dest": "flash_sil_m4",    "action": "store_true",  "help": "Include Si917 M4 firmware"}),
        ("--no-sil-m4",    {"dest": "flash_sil_m4",    "action": "store_false", "help": "Exclude Si917 M4 firmware"}),
        ("--sil-nwp",      {"dest": "flash_sil_nwp",   "action": "store_true",  "help": "Include Si917 NWP radio firmware"}),
        ("--no-sil-nwp",   {"dest": "flash_sil_nwp",   "action": "store_false", "help": "Exclude Si917 NWP radio firmware"}),
        ("--signed",       {"dest": "flash_signed",    "action": "store_true",  "help": "Use signed Si917 images"}),
        ("--unsigned",     {"dest": "flash_signed",    "action": "store_false", "help": "Use unsigned Si917 images"}),
    ],
}

for _target, _options in _TARGET_OPTIONS.items():
    if any(isinstance(t, str) and _target in t for t in BUILD_TARGETS):
        for _opt, _optkw in _options:
            safe_add_option(_opt, **_optkw)

###################


def ConfigureBsbDistTargets(env, u5_env, sil_env):
    for dist_module in [
        "update",
    ]:
        dist_script = env.GetComponent(f"bsbdist_{dist_module}")
        env.SConscript(
            dist_script,
            exports={
                "DIST_ENV": env,
                "U5_ENV": u5_env,
                "SIL_ENV": sil_env,
            },
        )


##################

project_env = Environment(tools=[], variables=commandline_vars)
if project_env.subst("$TARGET_HW") == "":
    SetOption("fullenv", True)
    # print("No target specified, building project")
    sil_dist = SConscript(
        "#target_dist.scons",
        exports={
            "TARGET_BUILD_OPTS": {
                "COMMANDLINE_VARS": _instantiate_vars(),
                "TARGET_OVERRIDES": {
                    "TARGET_HW": project_env.subst("$SIL_TARGET_HW"),
                },
                "SKIP_TARGET_DIST": True,
            },
        },
    )

    u5_dist = SConscript(
        "#target_dist.scons",
        exports={
            "TARGET_BUILD_OPTS": {
                "COMMANDLINE_VARS": _instantiate_vars(),
                "TARGET_OVERRIDES": {
                    "TARGET_HW": project_env.subst("$U5_TARGET_HW"),
                },
                # "SKIP_TARGET_DIST": True,
            }
        },
    )

    ConfigureBsbDistTargets(u5_dist, u5_dist, sil_dist)


else:
    # print(f"Target specified, building just for it")
    SConscript(
        "#target_dist.scons",
        exports={
            "TARGET_BUILD_OPTS": {
                "COMMANDLINE_VARS": _instantiate_vars(),
            }
        },
    )
