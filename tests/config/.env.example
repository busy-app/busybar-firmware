# BSB Firmware Tests Configuration
# Copy this file to .env and update with your values for local testing

# Device settings
BUSYBAR_IP=10.0.4.20
DEVICE_CHECK_PORT=80

# DAPLink serial numbers
DAPLINK_U5_ID=
DAPLINK_917_ID=

# Paths
BSB_FIRMWARE_PATH=~/Projects/bsb-firmware/
PROJECT_WORKSPACE=/home/runner/_work

# Crash detection
CRASH_FLAG_PATH=/tmp/crash_detected.flag
