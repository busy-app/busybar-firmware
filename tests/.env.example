# Sample local overrides for the integration test suite.
# Copy to `.env` and fill in the real values. `.env` is gitignored.
#
# Loaded automatically by pytest-dotenv before any fixtures run.

# --- WiFi network used by the WiFi integration tests ------------------------
WIFI_SSID=
WIFI_PASSWORD=
WIFI_SECURITY=WPA2

# --- Device endpoints (uncomment to override defaults from conftest) --------
# CLI_HOST=10.0.4.20
# CLI_PORT=23
# WEB_BASE_URL=http://10.0.4.20
