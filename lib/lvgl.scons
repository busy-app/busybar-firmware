Import("env")

env.AppendUnique(
    CPPPATH=[
        Dir("lvgl").srcnode(),
        Dir("lvgl/src").srcnode(),
    ],
    CPPDEFINES=[
        "LV_CONF_INCLUDE_SIMPLE",
    ],
)

libenv = env.Clone(FW_LIB_NAME="lvgl")
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CPPFLAGS=[
        "-Wno-redundant-decls",
        "-Wno-type-limits",
    ]
)

sources = []
sources += libenv.Glob("lvgl/src/*.c", source=True)
sources += libenv.Glob("lvgl/src/core/*.c", source=True)
sources += libenv.Glob("lvgl/src/display/*.c", source=True)
sources += libenv.Glob("lvgl/src/draw/*.c", source=True)
sources += libenv.Glob("lvgl/src/draw/sw/*.c", source=True)
sources += libenv.Glob("lvgl/src/draw/sw/blend/*.c", source=True)
sources += libenv.Glob("lvgl/src/font/*.c", source=True)
sources += libenv.Glob("lvgl/src/indev/*.c", source=True)
sources += libenv.Glob("lvgl/src/layouts/*.c", source=True)
sources += libenv.Glob("lvgl/src/layouts/*/*.c", source=True)
sources += libenv.Glob("lvgl/src/libs/bin_decoder/*.c", source=True)
sources += libenv.Glob("lvgl/src/misc/*.c", source=True)
sources += libenv.Glob("lvgl/src/misc/cache/*.c", source=True)
sources += libenv.Glob("lvgl/src/stdlib/*.c", source=True)
sources += libenv.Glob("lvgl/src/stdlib/clib/*.c", source=True)
sources += libenv.Glob("lvgl/src/osal/*.c", source=True)
sources += libenv.Glob("lvgl/src/themes/*.c", source=True)
sources += libenv.Glob("lvgl/src/themes/*/*.c", source=True)
sources += libenv.Glob("lvgl/src/tick/*.c", source=True)
sources += libenv.Glob("lvgl/src/widgets/*/*.c", source=True)
sources += libenv.Glob("lvgl/src/libs/lodepng/*.c", source=True)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
