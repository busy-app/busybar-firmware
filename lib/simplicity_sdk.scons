Import("env")

SDK_DIR = "simplicity_sdk"
SDK_INCDIR = f"#/lib/{SDK_DIR}"

FREERTOS_DIR = "FreeRTOS-Kernel"
FREERTOS_INCDIR = f"#/lib/{FREERTOS_DIR}"

WISECONNECT_DIR = "wiseconnect/components"
WISECONNECT_INCDIR = f"#/lib/{WISECONNECT_DIR}"

env.Append(
    CPPPATH=[
        Dir(f"{SDK_INCDIR}/platform/common/inc").rdir(),
        # SDK Wifi Silabs
        Dir(f"{SDK_INCDIR}/platform/emlib/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/common/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/service/mem_pool/inc").rdir(),
        # Break cyclic dependency on FreeRTOS
        Dir(f"{FREERTOS_INCDIR}/include").rdir(),
        Dir(f"{FREERTOS_INCDIR}/portable/GCC/ARM_CM4F").rdir(),
        # Break cyclic dependency on WiseConnect
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/mcu/core/config").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/mcu/core/chip/inc").rdir(),
        # NVM3
        Dir(f"{SDK_INCDIR}/platform/emdrv/common/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/emdrv/nvm3/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/emdrv/nvm3/config").rdir(),
        #Mbed TLS
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/aead/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/ecdh/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/ecdsa/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/mac/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/sha/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/crypto_utility/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/aes/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/wrap/inc").rdir(), #Todo no matter
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/wrap/config").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/hmac/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/gcm/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/ccm/inc").rdir(),
        Dir(f"{WISECONNECT_INCDIR}/device/silabs/si91x/wireless/crypto/trng/inc").rdir(),
        Dir(
            f"{SDK_INCDIR}/platform/security/sl_component/sl_mbedtls_support/inc"
        ).rdir(),
        Dir(
            f"{SDK_INCDIR}/platform/security/sl_component/sl_mbedtls_support/config"
        ).rdir(),
        Dir(f"{SDK_INCDIR}/util/third_party/mbedtls/include/").rdir(),
        Dir(f"{SDK_INCDIR}/util/third_party/openthread/include").rdir(),
        Dir(f"{SDK_INCDIR}/util/third_party/mbedtls/library").rdir(),
        Dir(
            f"{SDK_INCDIR}/platform/security/sl_component/sl_mbedtls_support/config/preset"
        ).rdir(),
        Dir(
            f"{SDK_INCDIR}/platform/security/sl_component/sl_mbedtls_support/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/security/sl_component/sl_psa_driver/inc").rdir(),
        Dir(f"{SDK_INCDIR}/platform/security/sl_component/sli_psec_osal/inc").rdir(),
    ],
    CPPDEFINES=[
        # SDK Wifi Silabs
        "SI917",
        "SLI_SI917",
        "SLI_SI917B0",
        "SLI_SI91X_ENABLE_IPV6",
        # "PRINT_DEBUG_LOG",
        "SIWG917M111MGTBA",
        "SL_CODE_COMPONENT_CORE=core",
        "SL_COMPONENT_CATALOG_PRESENT=1",
        "configNUM_SDK_THREAD_LOCAL_STORAGE_POINTERS=2",
        "configNUM_USER_THREAD_LOCAL_STORAGE_POINTERS=0",
        "FLASH_PAGE_SIZE=4096",
        "DEBUG_EFM",
        ("MBEDTLS_CONFIG_FILE", '\\"sl_mbedtls_config.h\\"'),
        ("MBEDTLS_PSA_CRYPTO_CONFIG_FILE", '\\"psa_crypto_config.h\\"'),
        "SL_CODE_COMPONENT_PSEC_OSAL=psec_osal",
        "SLI_AEAD_DEVICE_SI91X=1",
        #"SLI_CODE_CLASSIFICATION_DISABLE=1",
        "SLI_ECDH_DEVICE_SI91X=1",
        "SLI_ECDSA_DEVICE_SI91X=1",
        "SLI_MAC_DEVICE_SI91X=1",
        "SLI_SECURE_KEY_STORAGE_DEVICE_SI91X=1",
        "SLI_SHA_DEVICE_SI91X=1",
        "SLI_TRNG_DEVICE_SI91X=1",
    ],
)

libenv = env.Clone(FW_LIB_NAME="simplicity_sdk")
libenv.ApplyLibFlags()

sources = [
