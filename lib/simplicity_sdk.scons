    f"{SDK_DIR}/platform/security/sl_component/sl_psa_driver/src/sli_se_version_dependencies.c",
    f"{SDK_DIR}/platform/security/sl_component/sli_psec_osal/src/sli_psec_osal_cmsis_rtos2.c",
