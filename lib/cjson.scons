Import("env")

env.Append(
    CPPPATH=[
        "#/lib/lwip/cjson",
    ],
)

libenv = env.Clone(FW_LIB_NAME="cjson")
libenv.ApplyLibFlags()

sources = libenv.Glob("cjson/cJSON.c", source=True)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
