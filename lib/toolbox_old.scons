# TODO: Isolate everything in this file to separate libraries

Import("env")

LIB_DIR = "toolbox"

env.Append(
    SDK_HEADERS=[
        File(f"{LIB_DIR}/compress.h"),
        File(f"{LIB_DIR}/dir_walk.h"),
        File(f"{LIB_DIR}/fetch/fetch_client.h"),
        File(f"{LIB_DIR}/fetch/fetch_file_save.h"),
        File(f"{LIB_DIR}/fetch/fetch_loader.h"),
        File(f"{LIB_DIR}/path.h"),
        File(f"{LIB_DIR}/stream/buffered_file_stream.h"),
        File(f"{LIB_DIR}/stream/file_stream.h"),
        File(f"{LIB_DIR}/stream/stream.h"),
        File(f"{LIB_DIR}/stream/string_stream.h"),
        File(f"{LIB_DIR}/tar/tar_archive.h"),
        File(f"{LIB_DIR}/update_fw_tar.h"),
    ],
)

libenv = env.Clone(FW_LIB_NAME=f"{LIB_DIR}_old")
libenv.ApplyLibFlags()

sources = [
    f"{LIB_DIR}/compress.c",
    f"{LIB_DIR}/dir_walk.c",
    f"{LIB_DIR}/json_helper.c",
    f"{LIB_DIR}/path.c",
    f"{LIB_DIR}/tzutil.c",
]

sources += libenv.Glob(f"{LIB_DIR}/tar/*.c", source=True)
sources += libenv.Glob(f"{LIB_DIR}/fetch/*.c", source=True)
sources += libenv.Glob(f"{LIB_DIR}/stream/*.c", source=True)
sources += libenv.Glob(f"{LIB_DIR}/update_lib/*.c", source=True)
sources += libenv.Glob(f"{LIB_DIR}/update_lib/resources/*.c", source=True)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
