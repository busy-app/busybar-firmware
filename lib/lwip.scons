Import("env")

env.Append(
    CPPPATH=[
        "#/lib/lwip/src/include",
        "#/lib/lwip/src/include/lwip/apps",
    ],
    CPPDEFINES=[
        '"LWIP_PROVIDE_ERRNO"',  # TODO:
    ],
)

libenv = env.Clone(FW_LIB_NAME="lwip")
libenv.ApplyLibFlags()

sources = libenv.Glob("lwip/src/core/*.c", source=True)
sources += libenv.Glob("lwip/src/core/ipv4/*.c", source=True)
sources += libenv.Glob("lwip/src/core/ipv6/*.c", source=True)
sources += libenv.Glob("lwip/src/netif/*.c", source=True)
sources += libenv.Glob("lwip/src/api/*.c", source=True)

sources += [
    "lwip/src/apps/mdns/mdns.c",
    "lwip/src/apps/mdns/mdns_domain.c",
    "lwip/src/apps/mdns/mdns_out.c",
    "lwip/src/apps/lwiperf/lwiperf.c",
]

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
