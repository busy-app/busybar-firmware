Import("env")

for libname in [
    "internal_assets",
    "drivers",
    "tinyusb",
    "nema_gfx",
    "lwip",
    "cjson",
    "thorvg",
    "lvgl",
    "lvgl_addons",
    "network",
    "mongoose",
    "fw_updater_opts",
    "lib_base",
    "microtar",
    "mbedtls",
    "icon_assets",
    "toolbox",
    "flipper_format",
    "flipper_application",
    "nanopb",
    "heatshrink",
    "ext_applications",
    "firmware_applications_f20",
    ## SI917
    "sl_glue",
    "simplicity_sdk",
    "wiseconnect",
    "toolbox_f64",
    "firmware_applications_f64",
]:
    env.RegisterComponent(f"fwlib_{libname}", env.FindComponentSconscript(libname))


env.Append(
    CPPPATH=[
        Dir(".").srcnode(),
    ],
)
