Import("env")

LIB_FOLDER = "matter_ext"
LIB_INCDIR = f"#/lib/{LIB_FOLDER}"

LIB_ZAP_FOLDER = "matter_zap"
LIB_ZAP_INCDIR = f"#/lib/{LIB_ZAP_FOLDER}"

env.Append(
    CPPPATH=[
        Dir(LIB_FOLDER).srcnode(),
        ####
        Dir(f"{LIB_INCDIR}/slc/inc").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/matter_sdk/src").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/matter_sdk/src/include").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/matter_sdk/examples/platform/silabs/").rdir(),
        Dir(f"{LIB_ZAP_INCDIR}/zap-generated").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/nlassert/include/").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/nlio/include").rdir(),
        Dir(f"{LIB_INCDIR}/third_party/matter_sdk/src/platform/silabs/rs911x").rdir(),
    
    ],
    CPPFLAGS=[
        #"-Wno-error",
        "-Wno-unused-parameter",
        #"-Wno-missing-field-initializers",
    ],
    CPPDEFINES=[
        "CHIP_HAVE_CONFIG_H=1",
    ],
)

libenv = env.Clone(FW_LIB_NAME=LIB_FOLDER)
libenv.ApplyLibFlags()


libenv.AppendUnique(
    CPPPATH=[
        Dir("matter_ext/slc/inc").srcnode(),
        Dir("matter_ext/slc/config").srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src").srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src/include").srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src/lwip/freertos").srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src/platform/silabs/SiWx917").srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src/platform/silabs/rs911x").srcnode(),
        Dir(
            "matter_ext/third_party/matter_sdk/third_party/lwip/repo/lwip/src/include"
        ).srcnode(),
        Dir("matter_ext/third_party/matter_sdk/src/lwip/silabs/").srcnode(),
        Dir("matter_ext/third_party/nlassert/include/").srcnode(),
        Dir("matter_ext/third_party/nlio/include").srcnode(),
        ####
        Dir("matter_zap/zap-generated").srcnode(),
    ],
    CPPFLAGS=[
        "-Wno-error",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
    ],
    CPPDEFINES=[
        "__STARTUP_CLEAR_BSS=1",
        "__STATIC_INLINE=static inline",
        "_WANT_REENT_SMALL=1",
        "CCP_SI917_BRINGUP=1",
        "CHIP_9117=1",
        (
            "CHIP_ADDRESS_RESOLVE_IMPL_INCLUDE_HEADER",
            '\\"lib/address_resolve/AddressResolve_DefaultImpl.h\\"',
        ),
        "CHIP_CRYPTO_KEYSTORE_RAW=1",
        "CHIP_CRYPTO_PLATFORM=1",
        "CHIP_DEVICE_CONFIG_ENABLE_EXAMPLE_CREDENTIALS=1",
        "CHIP_DNSSD_DEFAULT_MINIMAL=1",
        "CHIP_HAVE_CONFIG_H=1",
        "CHIP_MINMDNS_DEFAULT_POLICY=1",
        "CHIP_MINMDNS_HIGH_VERBOSITY=0",
        "CHIP_MINMDNS_USE_EPHEMERAL_UNICAST_PORT=0",
        "CLOCK_ROMDRIVER_PRESENT=1",
        "configNUM_SDK_THREAD_LOCAL_STORAGE_POINTERS=2",
        "CRC_ROMDRIVER_PRESENT=1",
        "CURRENT_TIME_NOT_IMPLEMENTED=1",
        "DEBUG_ENABLE=1",
        "DEBUG_UART=1",
        "DISPLAY_ENABLED=1",
        "ENABLE_CHIP_SHELL=1",
        "ENABLE_DEBUG_MODULE=1",
        "ENABLE_WSTK_LEDS=1",
        "FLASH_PAGE_SIZE=4096",
        "KVS_MAX_ENTRIES=255",
        "LWIP_IPV6=1",
        "LWIP_NETIF_API=1",
        "NON_SPEC_COMPLIANT_OTA_ACTION_DELAY_FLOOR=-1",
        "NVM3_DEFAULT_MAX_OBJECT_SIZE=4092",
        "NVM3_DEFAULT_NVM_SIZE=40960",
        "NVM3_LOCK_OVERRIDE=1",
        "PLAT=EMBER_PLATFORM_CORTEXM3",
        "PLATFORM_HEADER=platform-header.h",
        "PLL_ROMDRIVER_PRESENT=1",
        "QR_CODE_ENABLED=1",
        "RADIO_CONFIG_DMP_SUPPORT=1",
        "RS911X_WIFI=1",
        "RTT_USE_ASM=0",
        "SI917=1",
        "SI917_MEMLCD=1",
        "SI917_SOC=1",
        "SI91X_PLATFORM=1",
        "SI91X_SYSRTC_PRESENT=1",
        "SILABS_LOG_OUT_UART=1",
        "SILABS_OTA_ENABLED=1",
        "SIWG917M111MGTBA=1",
        "SIWX_917=1",
        "SL_CODE_COMPONENT_CORE=core",
        "SL_CODE_COMPONENT_FREERTOS_KERNEL=freertos_kernel",
        "SL_CODE_COMPONENT_PSEC_OSAL=psec_osal",
        "SL_CODE_COMPONENT_SLEEPTIMER=sleeptimer",
        "SL_COMPONENT_CATALOG_PRESENT=1",
        "SL_HEAP_SIZE=0",
        "SL_MATTER_CLI_ARG_PARSER=1",
        "SL_MATTER_GN_BUILD=0",
        "SL_MATTER_TEST_EVENT_TRIGGER_ENABLED=1",
        "SL_MBEDTLS_USE_TINYCRYPT=1",
        "SL_NET_COMPONENT_INCLUDED=1",
        "SL_SI91X_BOARD_INIT=1",
        "SL_SI91x_DUAL_INTERRUPTS_ERRATA=1",
        "SL_SI91X_ENABLE_LITTLE_ENDIAN=1",
        "SL_SLEEP_TIMER=1",
        "SL_ULP_TIMER=1",
        "SL_WFX_CONFIG_SCAN=1",
        "SL_WIFI=1",
        "SL_WIFI_COMPONENT_INCLUDED=1",
        "SLI_AEAD_DEVICE_SI91X=1",
        "SLI_CODE_CLASSIFICATION_DISABLE=1",
        "SLI_ECDH_DEVICE_SI91X=1",
        "SLI_ECDSA_DEVICE_SI91X=1",
        "SLI_MAC_DEVICE_SI91X=1",
        "SLI_SECURE_KEY_STORAGE_DEVICE_SI91X=1",
        "SLI_SHA_DEVICE_SI91X=1",
        "SLI_SI917=1",
        "SLI_SI917B0=1",
        "SLI_SI91X_ENABLE_BLE=1",
        "SLI_SI91X_ENABLE_OS=1",
        "SLI_SI91X_LWIP_HOSTED_NETWORK_STACK=1",
        "SLI_SI91X_MCU_COMMON_FLASH_MODE=1",
        "SLI_SI91X_MCU_CONFIG_RADIO_BOARD_BASE_VER=1",
        "SLI_SI91X_MCU_CONFIG_RADIO_BOARD_VER2=1",
        "SLI_SI91X_MCU_ENABLE_FLASH_BASED_EXECUTION=1",
        "SLI_SI91X_MCU_ENABLE_IPMU_APIS=1",
        "SLI_SI91X_MCU_EXTERNAL_LDO_FOR_PSRAM=1",
        "SLI_SI91X_MCU_INTERFACE=1",
        "SLI_SI91X_MCU_INTR_BASED_RX_ON_UART=1",
        "SLI_TRNG_DEVICE_SI91X=1",
        "SPI_MULTI_SLAVE=1",
        "SRAM_BASE=0x0cUL",
        "SRAM_SIZE=0x4fc00UL",
        "SUPPORT_CPLUSPLUS=1",
        "TA_DEEP_SLEEP_COMMON_FLASH=1",
        "TIME_SYNC_ENABLE_TSC_FEATURE=1",
        "TIMER_ROMDRIVER_PRESENT=1",
        "UDMA_ROMDRIVER_PRESENT=1",
        "ULPSS_CLOCK_ROMDRIVER_PRESENT=1",
        'SL_BOARD_NAME="BRD4002A"',
        'SL_BOARD_REV="A07"',
        ("MBEDTLS_CONFIG_FILE", '\\"sl_mbedtls_config.h\\"'),
        ("MBEDTLS_PSA_CRYPTO_CONFIG_FILE", '\\"psa_crypto_config.h\\"'),
        ("MBEDTLS_USER_CONFIG_FILE", '\\"siwx917-chip-mbedtls-config.h\\"'),
        # "__WEAK=__attribute__((weak))",
        # "CHIP_ADDRESS_RESOLVE_IMPL_INCLUDE_HEADER=<lib/address_resolve/AddressResolve_DefaultImpl.h>",
        # "MBEDTLS_CONFIG_FILE=<sl_mbedtls_config.h>",
        # "MBEDTLS_PSA_CRYPTO_CONFIG_FILE=<psa_crypto_config.h>",
        # "MBEDTLS_USER_CONFIG_FILE=<siwx917-chip-mbedtls-config.h>",
        # "SEGGER_RTT_SECTION="SEGGER_RTT"",
        # "SL_SI91X_SI917_RAM_MEM_CONFIG=3",
    ],
)

sources = []
sources.extend(env.GlobRecursive("*.c*", "matter_zap"))

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
