Import("env")

# Matter extension

LIB_DIR = "matter_ext"
LIB_INCDIR = f"#/lib/{LIB_DIR}"

THIRD_PARTY_DIR = f"{LIB_DIR}/third_party"
THIRD_PARTY_INCDIR = f"#/lib/{THIRD_PARTY_DIR}"

MATTER_SDK_DIR = f"{THIRD_PARTY_DIR}/matter_sdk"
MATTER_SDK_INCDIR = f"#/lib/{MATTER_SDK_DIR}"

MATTER_SUPPORT_DIR = f"{THIRD_PARTY_DIR}/matter_support"
MATTER_SUPPORT_INCDIR = f"#/lib/{MATTER_SUPPORT_DIR}"

# Matter platform glue

MATTER_GLUE_DIR = "matter_glue"
MATTER_GLUE_INCDIR = f"#/lib/{MATTER_GLUE_DIR}"

# ZAP generated files

ZAP_DIR = "matter_zap"
ZAP_INCDIR = f"#/lib/{ZAP_DIR}"

ZAP_GENERATED_DIR = f"{ZAP_DIR}/zap-generated"
ZAP_GENERATED_INCDIR = f"#/lib/{ZAP_GENERATED_DIR}"

env.Append(
    CPPPATH=[
        # Matter extension
        Dir(f"{MATTER_SDK_INCDIR}/src").rdir(),
        Dir(f"{MATTER_SDK_INCDIR}/src/include").rdir(),
        # Dir(f"{MATTER_SUPPORT_INCDIR}/provision").rdir(),
        Dir(f"{MATTER_SUPPORT_INCDIR}/tinycrypt/inc").rdir(),
        Dir(f"{THIRD_PARTY_INCDIR}/nlio/include").rdir(),
        Dir(f"{THIRD_PARTY_INCDIR}/nlassert/include").rdir(),

        # Matter platform glue
        Dir(f"{MATTER_GLUE_INCDIR}").rdir(),
        Dir(f"{MATTER_GLUE_INCDIR}/config").rdir(),

        # ZAP generated files
        Dir(f"{ZAP_GENERATED_INCDIR}").rdir(),
        Dir(f"{ZAP_INCDIR}").rdir(),
    ],
    CPPDEFINES=[
        "CHIP_HAVE_CONFIG_H=1",
        "CHIP_CRYPTO_KEYSTORE_RAW=1",
    ],
    LIBPATH=[
        Dir(f"{MATTER_SUPPORT_DIR}/provision/libs/").srcnode(),
    ],
    FW_LIBS=[
        "stdc++",
    ],
    LINT_SOURCES=[
        Dir(MATTER_GLUE_DIR).srcnode(),
    ],
)

libenv = env.Clone(FW_LIB_NAME="matter_ext")
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CPPPATH=[
    ],
    CPPFLAGS=[
        "-Wno-error",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
    ],
    CPPDEFINES=[
        "CHIP_CRYPTO_PLATFORM=1",
        "CHIP_DNSSD_DEFAULT_MINIMAL=1",
        "CHIP_MINMDNS_DEFAULT_POLICY=1",
        "CHIP_MINMDNS_HIGH_VERBOSITY=0",
        "CHIP_MINMDNS_USE_EPHEMERAL_UNICAST_PORT=0",
        "SL_MBEDTLS_USE_TINYCRYPT=1",
    ],
)

