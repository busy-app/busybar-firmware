project_name: "wisun_bt_dmp_soc_empty"
label: "Wi-SUN Bluetooth DMP - SoC Empty"
description: >
  The Wi-SUN Bluetooth DMP - SoC Empty sample application is a bare-bones application.
  This application can be used as a template to develop a Wi-SUN - BLE DMP (Dynamic Multiprotocol) application.
  Can be tested with the Simplicity Connect mobile app.
package: "wisun_sdk_sample_app"
category: "Wi-SUN Examples"
quality: "evaluation"

component:
# for wisun stack and default components
  - id: "segger_rtt_printf"
  - id: "wisun_stack"
  - id: "wisun_stack_lfn"
  - id: "wisun_stack_ffn"
  - id: "wisun_stack_debug"
  - id: "sl_main"
  - id: "clock_manager"
  - id: "device_init"
  - id: "board_control"
    condition:
      - "hardware_board"
  - id: "sleeptimer"
  - id: "nvm3_default"
  - id: "freertos"
  - id: "iostream_recommended_stream"
  - id: "iostream_retarget_stdio"
  - id: "iostream_stdlib_config"
  - id: "printf"
  - id: "simple_button"
    instance:
      - "btn0"
      - "btn1"
  - id: "simple_led"
    instance:
      - "led0"
      - "led1"
# wisun config
  - id: "wisun_config"
# radio config
  - id: "radio_config_brd_wisun_singlephy"
  - id: "restrictions_profile_wisun_han"
  - id: "restrictions_profile_wisun_fan_1_0"
  - id: "restrictions_profile_wisun_fan_1_1"
# BLE components
  - id: "bluetooth_stack"
  - id: "gatt_configuration"
  - id: "gatt_service_device_information_override"
  - id: "bluetooth_feature_system"
  - id: "bluetooth_feature_legacy_advertiser"
  - id: "bluetooth_feature_extended_advertiser"
  - id: "bluetooth_feature_connection_role_peripheral"
  - id: "bluetooth_feature_gatt_server"
  - id: "bluetooth_feature_sm"
# SDK components
  - id: "sl_wisun_app_core"
  - id: "sl_wisun_trace_util"
  - id: "sl_wisun_ble_dmp_advertise_controller"

requires:
  - name: "cmsis_rtos2"
  - name: "freertos_heap_3"
    condition:
      - "freertos"

source:
  - path: "app.c"
  - path: "app_init.c"
  - path: "app_custom_callback.c"

include:
  - path: "."
    file_list:
    - path: "app.h"
    - path: "app_custom_callback.h"

define:
  - name: "DEBUG_EFM"

configuration:
  - name: "SL_WISUN_APP_CORE_MAIN_STACK_SIZE_WORD"
    value: "2048"
  - name: "SL_MAIN_START_TASK_STACK_SIZE_BYTES"
    value: "2048"
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
  - name: "SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE"
    value: "usartHwFlowControlCtsAndRts"
    condition:
      - "iostream_usart"
  - name: "SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF"
    value: "1"
    condition:
      - "iostream_usart"
  - name: "SL_CLI_LOCAL_ECHO"
    value: "1"
  - name: "SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE"
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition:
      - "iostream_eusart"
  - name: "SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF"
    value: "1"
    condition:
      - "iostream_eusart"
  - name: "SL_IOSTREAM_LEUART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF"
    value: "1"
    condition:
      - "iostream_leuart"
  - name: "configUSE_POSIX_ERRNO"
    value: "1"
    condition:
      - "freertos"
  - name: "OS_CFG_APP_HOOKS_EN"
    value: "1"
    condition:
      - "micriumos_kernel"
  - name: "OS_CFG_ERRNO_EN"
    value: "1"
    condition:
      - "micriumos_kernel"
  - name: "OS_CFG_SCHED_ROUND_ROBIN_EN"
    value: "1"
    unless:
      - "wisun_low_power"
  - name: "OS_CFG_STAT_TASK_EN"
    value: "1"
    unless:
      - "wisun_low_power"
  - name: "OS_CFG_TASK_PROFILE_EN"
    value: "1"
    unless:
      - "wisun_low_power"
  - name: "CPU_CFG_TS_32_EN"
    value: "1"
  - name: "OS_CFG_DBG_EN"
    value: "1"
  - name: "OS_CFG_TS_EN"
    value: "1"
  - name: "SL_RAIL_UTIL_PTI_BAUD_RATE_HZ"
    value: "3200000"
  - name: "BUFFER_SIZE_UP"
    value: "4096"
  - name: "BUFFER_SIZE_DOWN"
    value: "64"
  - name: "SL_BT_CONFIG_USER_ADVERTISERS"
    value: "1"
  - name: "SL_BT_CONFIG_MAX_CONNECTIONS"
    value: "1"
  - name: "BLE_PEER_MANAGER_COMMON_MAX_ALLOWED_CONN_COUNT"
    value: "1"
  - name: "BLE_PEER_MANAGER_PERIPHERAL_CONFIG_ADV_PHY"
    value: "sl_bt_gap_phy_1m" # BLE legacy advertisement
  - name: "SL_MBEDTLS_SSL_IN_CONTENT_LEN"
    value: "1024"
  - name: "APP_PROJECT_INFO_WISUN_VERSION_ENABLED"
    value: "1"
  - name: "APP_PROJECT_INFO_MBEDTLS_VERSION_ENABLED"
    value: "1"
  - name: SL_SLEEPTIMER_WALLCLOCK_CONFIG
    value: "1"
    condition:
      - "sl_wisun_ota_dfu"

  # LFN related peripheral and energy saver setup
  - name: "SL_SLEEPTIMER_PERIPHERAL"
    value: "SL_SLEEPTIMER_PERIPHERAL_BURTC"
    condition:
      - "wisun_low_power"
  - name: "SL_IOSTREAM_EUSART_INSTANCE_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION"
    value: "0"
    condition:
      - "iostream_eusart"
      - "wisun_low_power"
  - name: "SL_IOSTREAM_EUSART_VCOM_BAUDRATE"
    value: "9600"
    condition:
      - "iostream_eusart"
      - "wisun_low_power"
  - name: "SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY"
    value: "0"
    condition:
      - "iostream_eusart"
      - "wisun_low_power"
  - name: "SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION"
    value: "1"      # Disable this so that the chip can enter EM2/3/4
                    # and be woken by other wake sources, setting this
                    # to true adds an EM1 requirement to the Power Manager.
    condition:
      - "iostream_eusart"
  - name: "SL_IOSTREAM_USART_VCOM_RX_BUFFER_SIZE"
    value: "128" # Increase from default 32 to account for automated command
                 # storage entry and for when long command strings are
                 # interrupted by chip interrupts.
    condition:
      - "iostream_usart"
  - name: "SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE"
    value: "128" # Increase from default 32 to account for automated command
                 # storage entry and for when long command strings are
                 # interrupted by chip interrupts.
    condition:
      - "iostream_eusart"
  - name: "SL_IOSTREAM_LEUART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION"
    value: "0"
    condition:
      - "iostream_leuart"
  - name: "SL_IOSTREAM_LEUART_VCOM_RX_BUFFER_SIZE"
    value: "128" # Increase from default 32 to account for automated command
                 # storage entry and for when long command strings are
                 # interrupted by chip interrupts.
    condition:
      - "iostream_leuart"
  - name: "SL_CLOCK_MANAGER_EUSART0CLK_SOURCE"
    value: "CMU_EUSART0CLKCTRL_CLKSEL_LFXO"
    condition:
      - "iostream_leuart"
      - "wisun_low_power"
  - name: "SL_CLOCK_MANAGER_EUSART0CLK_SOURCE"
    value: "CMU_EUSART0CLKCTRL_CLKSEL_LFXO"
    condition:
    - "iostream_eusart"
    - "wisun_low_power"

  # SDK Application version
  - name: "APP_PROJECT_INFO_APP_VERSION_MAJOR"
    value: "1"
  - name: "APP_PROJECT_INFO_APP_VERSION_MINOR"
    value: "0"
  - name: "APP_PROJECT_INFO_APP_VERSION_PATCH"
    value: "0"

readme:
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme.md"

config_file:
  - override:
      component: "gatt_configuration"
      file_id: "gatt_configuration_file_id"
    path: "gatt_configuration.btconf"
    directory: "btconf"

other_file:
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme_img0.png"
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme_img1.png"
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme_img2.png"
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme_img3.png"
  - path: "../../documentation/example/wisun_bt_dmp_soc_empty/readme_img4.png"
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

ui_hints:
  highlight:
    - path: "config/wisun/wisun_settings.wisunconf"
    - path: "config/btconf/gatt_configuration.btconf"
    - path: "readme.md"
      focus: true

#--------------------- HWFILTER ------------------------
tag:
  - hwfilter:board:hardware:has:pti
  - hwfilter:ram:95k
  - hwfilter:flash:711k
  - hwfilter:!device:device_generic_family_efr32xg25

#-------------- Template Contribution ----------------

#---------------- Component Catalog ------------------

#--------------------- Toolchain ------------------------
toolchain_settings:
  - option: "optimize"
    value: "debug"

filter:
  - name: "Wireless Technology"
    value: ["Wi-SUN", "Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Capability"
    value: ["Multiprotocol"]
  - name: "Project Difficulty"
    value: ["Advanced"]
