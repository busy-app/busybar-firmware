id: wisun_ncp_recommended_interface
label: Wi-SUN NCP Interface Recommendation
description: >
  Recommends the correct NCP interface (CPC or UART) for Wi-SUN NCP applications.
  If the CPC secondary component is present, recommends CPC; otherwise, recommends UART.
package: wisun
category: "Wi-SUN|Application|Wi-SUN NCP"
quality: production
root_path: wisun/./app/wisun_ncp

provides:
- name: wisun_ncp_recommended_interface

requires:
- name: wisun_ncp_interface

recommends:
- id: wisun_ncp_cpc

  vendor: silabs
ui_hints:
  visibility: never

metadata:
  sbom:
    license: MSLA
