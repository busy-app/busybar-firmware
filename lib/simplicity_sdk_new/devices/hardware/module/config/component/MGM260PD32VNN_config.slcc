!!omap
- id: MGM260PD32VNN_config
- label: MGM260PD32VNN config
- description: Configuration files for MGM260PD32VNN
- package: devices
- category: Platform|Device|MGM26|Config
- quality: production
- metadata:
    sbom:
      license: Zlib
- ui_hints:
    visibility: never
- root_path: devices/hardware/module/config
- requires:
  - name: mgm260pd32vnn
- provides:
  - name: MGM260PD32VNN_config
- config_file:
  - override:
      component: clock_manager
      file_id: clock_manager_oscillator_config
      vendor: silabs
    path: MGM260PD32VNN/sl_clock_manager_oscillator_config.h
    unless:
    - hardware_board
  - override:
      component: clock_manager
      file_id: clock_manager_tree_config
      vendor: silabs
    path: MGM260PD32VNN/sl_clock_manager_tree_config.h
    unless:
    - hardware_board
  - override:
      component: device_init_dpll
      file_id: device_init_dpll_config
      vendor: silabs
    path: MGM260PD32VNN/sl_device_init_dpll_config.h
    unless:
    - hardware_board
  - override:
      component: device_init_hfxo
      file_id: device_init_hfxo_config
      vendor: silabs
    path: MGM260PD32VNN/sl_device_init_hfxo_config.h
    unless:
    - hardware_board
  - override:
      component: rail_util_pa
      file_id: rail_util_pa_config
      vendor: silabs
    path: MGM260PD32VNN/sl_rail_util_pa_config.h
  - override:
      component: sl_rail_util_pa
      file_id: sl_rail_util_pa_config
      vendor: silabs
    path: MGM260PD32VNN/sl_rail_util_pa_config.h
