project_name: cpc_secondary_vcom_security_device_recovery
package: cpc_app
quality: production
label: Platform - CPC Secondary Device Recovery - VCOM
description: >
  This simple example project implements the function sl_cpc_security_on_unbind_request(),
  allowing the secondary device to be unbound from the host.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app.c
  - path: cpc_app.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: cpc_app.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: cpc_secondary
  - id: cpc_secondary_recommended_uart_interface
  - id: cpc_security_secondary
define:
  - name: DEBUG_EFM
configuration:
  - name: SL_CPC_SECURITY_ENABLED
    value: 1
  - name: SL_CPC_SECURITY_BINDING_KEY_METHOD
    value: SL_CPC_SECURITY_BINDING_KEY_ECDH
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hwfilter:ram:40k
  - hwfilter:device:device_has_uart
  - hwfilter:!device:device_generic_family_efr32xg22
  - hwfilter:!device:device_generic_family_efr32xg25
  - hwfilter:!device:device_generic_family_efr32xg26
  - hwfilter:!device:device_generic_family_efr32xg29
  - hwfilter:board:hardware:has:vcom
