label: ZWave_SoC_SwitchOnOff_Solution
description: >
  Demonstrates Switch On/Off application combined with OTA bootloader.
  The Z-Wave certified Switch On/Off application shows a switch
  implementation that turns on any device that is connected to power.
  Examples include lights, appliances, and so on.
package: zwave_sample_app
quality: production
project:
  - path: ../zwave_soc_switch_on_off/zwave_soc_switch_on_off.slcp
    id: application
    output: application
  - path: ../bootloaders/bootloader-storage-internal-single-zwave-ota.slcp
    id: bootloader
    output: bootloader
post_build:
  profile: zwave_workspace
