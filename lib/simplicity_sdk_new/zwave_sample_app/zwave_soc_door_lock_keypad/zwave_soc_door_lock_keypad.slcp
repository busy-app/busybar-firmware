project_name: zwave_soc_door_lock_keypad
label: Z-Wave - SoC Door Lock Keypad
category: Z-Wave|Apps
description: >
  The Z-Wave certified Door Lock application shows a lock implementation. It will support user
  codes to open a door and thereby eliminate the need for traditional keys. It is possible to both
  lock and unlock the door remotely through the Z-Wave protocol.

  For certain devices, the application supports and uses the User Credential Command Class. See README file for details.
package: zwave_sample_app
quality: production
component:
  - id: emlib_letimer
  - id: emlib_timer
  - id: emlib_msc
  - id: gpiointerrupt
  - id: zw_role_type_sleeping_listening
  - id: zaf_soc
  - id: zw_core
  - id: zw_zaf
  - id: zw_true_status
  - id: zw_ota
  - id: zw_cc_association
  - id: zw_cc_basic
  - id: zw_cc_battery
  - id: zw_cc_battery_nvm
  - id: zw_cc_common
  - id: zw_cc_deviceresetlocally
  - id: zw_cc_door_lock
  - id: zw_cc_door_lock_nvm
  - id: zw_cc_firmwareupdate
  - id: zw_cc_indicator
  - id: zw_cc_manufacturerspecific
  - id: zw_cc_multi_channel_control
  - id: zw_cc_powerlevel
  - id: zw_cc_supervision
  - id: zw_cc_user_code
  - id: zw_cc_user_code_nvm
  - id: zw_cc_user_credential
    condition: [device_sdid_235]
  - id: zw_cc_user_credential_nvm
    condition: [zw_cc_user_credential]
  - id: zw_cc_notification
    condition: [zw_cc_user_credential]
  - id: zw_cc_version
  - id: zw_cc_zwaveplusinfo
  - id: zw_appshw
  - id: zw_appshw_cc_battery_callbacks
  - id: sl_main
  - id: device_init
  - id: mpu # disable execution from RAM
  - id: ZW_MIGRATION_TO_7_19
  - id: app_button_press
  - id: app_assert
  - id: simple_button
    instance: [btn0, btn1]
  - id: simple_led
    instance: [led0, led1]
  - id: zw_cli_common
    condition: [zw_stack_release_libraries]
  - id: clock_manager

source:
  - path: app.c
  - path: app_cc_event_handlers.c
  - path: app_credentials.c
    condition: [zw_cc_user_credential]
  - path: app_cli.c
    condition: [zw_cli_common]
  - path: app_cli_cc_user_credential.c
    condition: [zw_cli_common, zw_cc_user_credential]
  - path: app_btn_handler.c
    condition: [simple_button]
  - path: app_cc_door_lock_callbacks.c

include:
  - path: .
    file_list:
      - path: app_credentials.h
      - path: events.h

configuration:
  - name: SHORT_BUTTON_PRESS_DURATION_MS
    value: (400)
  - name: MEDIUM_BUTTON_PRESS_DURATION_MS
    value: (1500)
  - name: ZAF_CONFIG_REQUEST_KEY_S0
    value: 1
  - name: ZAF_CONFIG_REQUEST_KEY_S2_ACCESS
    value: 1
  - name: ZAF_CONFIG_GENERIC_TYPE
    value: GENERIC_TYPE_ENTRY_CONTROL
  - name: ZAF_CONFIG_SPECIFIC_TYPE
    value: SPECIFIC_TYPE_DOOR_LOCK
  - name: ZAF_CONFIG_PRODUCT_ID
    value: 1 # Silicon Labs Z-Wave Door Lock Keypad product ID
  - name: ZAF_CONFIG_USER_ICON_TYPE
    value: ICON_TYPE_GENERIC_DOOR_LOCK_KEYPAD
  - name: ZAF_CONFIG_INSTALLER_ICON_TYPE
    value: ICON_TYPE_GENERIC_DOOR_LOCK_KEYPAD
  - name: CC_DOOR_LOCK_HANDLE_1
    value: DOOR_INSIDE
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: 1900
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 100
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: configUSE_IDLE_HOOK
    value: 1
  - name: configTIMER_TASK_PRIORITY
    value: 55
  - name: configMAX_SYSCALL_INTERRUPT_PRIORITY
    value: 16
    condition: [device_series_2]
  - name: configKERNEL_INTERRUPT_PRIORITY
    value: 112
    condition: [device_series_2]
  - name: configTIMER_QUEUE_LENGTH
    value: 8
  - name: SL_PSA_ITS_USER_MAX_FILES
    value: 32
    condition: ["device_series_2", "device_security_vault"]
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: 14
    condition: ["device_series_2", "device_security_vault"]
  - name: SL_SLEEPTIMER_PERIPHERAL
    value: SL_SLEEPTIMER_PERIPHERAL_BURTC
    condition: ["device_series_2"]
  - name: CC_ASSOCIATION_MAX_GROUPS_PER_ENDPOINT
    value: 1
  - name: CC_ASSOCIATION_MAX_NODES_IN_GROUP
    value: 5
  - name: ZAF_CONFIG_SECURE_ONLY
    value: 1
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 1
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 1
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: ZAF_APP_NAME
    value: '"door_lock_keypad"'
  - name: U3C_BUFFER_SIZE_CREDENTIAL_DATA
    value: 32
  # USART configuration
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0    # UART RX shouldn't prevent EM2
  # EUSART configuration
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0    # EUSART RX shouldn't prevent EM2
    unless: [brd4204a]
  - name: SL_IOSTREAM_EUSART_INSTANCE_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
  - name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
    value: 9600 # In EM2 the eusart is working only with 9600 baud
  - name: SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY # Disable high frequency mode for EUSART to work in EM2
    value: 0
    unless: [brd4204a]
  - name: SL_CLOCK_MANAGER_WDOG0CLK_SOURCE
    value: CMU_WDOG0CLKCTRL_CLKSEL_LFRCO
  - name: SL_CLOCK_MANAGER_EUSART0CLK_SOURCE
    value: CMU_EUSART0CLKCTRL_CLKSEL_LFRCO
    unless: [brd4204a]
  # BRD4204A uses PORTD for EUSART that cannot work in EM2, so we configure EUSART to apply lock for EM1
  - name: SL_CLOCK_MANAGER_EUSART0CLK_SOURCE
    value: CMU_EUSART0CLKCTRL_CLKSEL_EM01GRPCCLK
    condition: [brd4204a]
  - name: SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY
    value: 1
    condition: [brd4204a]
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 1
    condition: [brd4204a]
define:
  - name: APP_PROPERTIES_CONFIG_FILE
    value: <application_properties_config.h>
  - name: FILE_ID_APPLICATIONDATA # File identifiers for application file system
    value: "0x00000" # Range: 0x00000 - 0x0FFFF

config_file:
  - path: DoorLockKeyPad.cc_config
    directory: cc_config
  - path: DoorLockKeyPadNotification.cc_config
    directory: cc_config
    condition: [zw_cc_notification]
  # Sample keys for signing
  - path: ../sample-keys/sample_encrypt.key
    directory: sample_keys
  - path: ../sample-keys/sample_sign.key
    directory: sample_keys

provides:
  - name: zwave_sample_application
  - name: zwave_soc_door_lock_keypad

template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: battery_report
      handler: cli_battery_report
      help: "Send battery report"
  - name: cli_command
    condition: [zw_cli_common]
    unless: [zw_cc_user_credential]
    value:
      name: enter_user_code
      handler: cli_enter_user_code
      help: "Enter a user code"
      argument:
      - type: string
        help: "Current user code"
  - name: cli_command
    condition: [zw_cli_common]
    unless: [zw_cc_user_credential]
    value:
      name: set_new_user_code
      handler: cli_set_new_user_code
      help: "Set a new user code"
      argument:
      - type: string
        help: "User code to be set"
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: set_doorhandle_state
      handler: cli_set_doorhandle_state
      help: "Set door handle state to locked (1) or unlocked (0)"
      argument:
      - type: string
        help: "activate or deactivate"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_add_user
      handler: cli_u3c_db_add_user
      help: "Add a user to the User Credential Database"
      argument:
      - type: string
        help: "Name of the new user"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_add_credential
      handler: cli_u3c_db_add_credential
      help: "Add a user to the User Credential Database"
      argument:
      - type: uint16
        help: "Associated User UID"
      - type: string
        help: "Type of new credential. Can be pin or password"
      - type: uint16
        help: "Slot numbers of the new credential"
      - type: string
        help: "Credential data"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_modify_user
      handler: cli_u3c_db_modify_user
      help: "Modify a user in the User Credential Database"
      argument:
      - type: uint16
        help: "UUID of the user"
      - type: string
        help: "Attribute to modify. Can be type, name or active"
      - type: string
        help: "New attribute value"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_modify_credential
      handler: cli_u3c_db_modify_credential
      help: "Modify a credential in the User Credential Database"
      argument:
      - type: string
        help: "Type of credential. Can be pin or password"
      - type: uint16
        help: "Slot of the credential"
      - type: string
        help: "Attribute to change. Can be data, uuid or slot"
      - type: string
        help: "New attribute value"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_delete_user
      handler: cli_u3c_db_delete_user
      help: "Delete a user from U3C database"
      argument:
      - type: uint16
        help: "UUID of the user"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_delete_credential
      handler: cli_u3c_db_delete_credential
      help: "Delete a credential from U3C database"
      argument:
      - type: string
        help: "Type of credential. Can be pin or password"
      - type: uint16
        help: "Slot of the credential"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_get_user
      handler: cli_u3c_db_get_user
      help: "Get a user's data from U3C database"
      argument:
      - type: uint16
        help: "UUID of the user"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_get_credential
      handler: cli_u3c_db_get_credential
      help: "Get a credential's data from U3C database"
      argument:
      - type: string
        help: "Type of credential. Can be pin or password"
      - type: uint16
        help: "Slot of the credential"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_enter_credential
      handler: cli_u3c_enter_credential
      help: "Enter and validate user credential"
      argument:
      - type: string
        help: "Type of credential. Can be pin or password"
      - type: string
        help: "Credential data"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_credential_learn_start
      handler: cli_u3c_credential_learn_start
      help: "Start the User Credential Learn process"
      argument:
      - type: uint16
        help: "Learn target UUID"
      - type: string
        help: "Type of credential (pin or password)"
      - type: uint16
        help: "Learn target slot"
  - name: cli_command
    condition: [zw_cli_common, zw_cc_user_credential]
    value:
      name: u3c_credential_learn
      handler: cli_u3c_credential_learn
      help: "Enter credential data for User Credential Learn process"
      argument:
      - type: string
        help: "Credential data"
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: get_doorhandle_state
      handler: cli_get_doorhandle_state
      help: "Get door handle state"
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: get_doorbolt_state
      handler: cli_get_doorbolt_state
      help: "Get door bolt state"
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: get_doorlatch_state
      handler: cli_get_doorlatch_state
      help: "Get doorlatch state"

post_build:
  profile: zwave_application

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_zwave
  - hwfilter:!board:brd4205a
  - toolchain:gcc

filter:
  - name: "Wireless Technology"
    value: ["Z-Wave"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

readme:
   - path: README.md
ui_hints:
   highlight: README.md
