project_name: zwave_soc_sensor_pir
label: Z-Wave - SoC Sensor PIR
category: Z-Wave|Apps
description: >
  The Z-Wave certified passive infrared (PIR) sensor application shows a presence/movement detector implementation for
  controlling other devices and for sending notifications.
package: zwave_sample_app
quality: production
component:
  - id: emlib_letimer
  - id: emlib_timer
  - id: emlib_msc
  - id: gpiointerrupt
  - id: zw_role_type_sleeping_reporting
  - id: zaf_soc
  - id: zw_core
  - id: zw_zaf
  - id: zw_true_status
  - id: zw_ota
  - id: zw_cc_manufacturerspecific
  - id: zw_cc_common
  - id: zw_cc_association
  - id: zw_cc_supervision
  - id: zw_cc_multi_channel_control
  - id: zw_cc_basiccontroller
  - id: zw_cc_deviceresetlocally
  - id: zw_cc_firmwareupdate
  - id: zw_cc_version
  - id: zw_cc_indicator
  - id: zw_cc_powerlevel
  - id: zw_cc_zwaveplusinfo
  - id: zw_cc_battery
  - id: zw_cc_battery_nvm
  - id: zw_cc_notification
  - id: zw_cc_notification_nvm
  - id: zw_cc_wakeup
  - id: zw_appshw
  - id: zw_appshw_cc_battery_callbacks
  - id: sl_main
  - id: device_init
  - id: mpu # disable execution from RAM
  # Unlatch pin retention
  - id: app_em4h_reset
  - id: ZW_MIGRATION_TO_7_19
  - id: zw_cli_common
    condition: [zw_stack_release_libraries]
  - id: app_button_press
  - id: app_assert
  - id: simple_button
    instance: [btn0, btn1]
  - id: simple_led
    instance: [led0, led1]
  - id: clock_manager

source:
  - path: app.c
  - path: SensorPIR_UserTask_DataAcquisition.c
  - path: app_cli.c
    condition: [zw_cli_common]
  - path: app_btn_handler.c
    condition: [simple_button]

include:
  - path: .
    file_list:
      - path: events.h
      - path: SensorPIR_UserTask_DataAcquisition.h

configuration:
  - name: SHORT_BUTTON_PRESS_DURATION_MS
    value: (400)
  - name: MEDIUM_BUTTON_PRESS_DURATION_MS
    value: (1500)
  - name: APP_BUTTON_PRESS_DETECTION
    value: APP_BUTTON_PRESS_DETECT_PRESS_AND_RELEASE
  - name: ZAF_CONFIG_REQUEST_KEY_S0
    value: 1
  - name: ZAF_CONFIG_REQUEST_KEY_S2_UNAUTHENTICATED
    value: 1
  - name: ZAF_CONFIG_REQUEST_KEY_S2_AUTHENTICATED
    value: 1
  - name: ZAF_CONFIG_GENERIC_TYPE
    value: GENERIC_TYPE_SENSOR_NOTIFICATION
  - name: ZAF_CONFIG_SPECIFIC_TYPE
    value: SPECIFIC_TYPE_NOTIFICATION_SENSOR
  - name: ZAF_CONFIG_PRODUCT_ID
    value: 3 # Silicon Labs Z-Wave Sensor PIR product ID
  - name: ZAF_CONFIG_USER_ICON_TYPE
    value: ICON_TYPE_SPECIFIC_SENSOR_NOTIFICATION_HOME_SECURITY
  - name: ZAF_CONFIG_INSTALLER_ICON_TYPE
    value: ICON_TYPE_SPECIFIC_SENSOR_NOTIFICATION_HOME_SECURITY
  - name: ZAF_TRANSPORT_CONFIG_QUEUE_SIZE
    # BTN0(1) + BTN1(2) + OTA(1)
    value: 4
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: 1900
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 100
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: configUSE_IDLE_HOOK
    value: 1
  - name: configTIMER_TASK_PRIORITY
    value: 55
  - name: configMAX_SYSCALL_INTERRUPT_PRIORITY
    value: 16
    condition: [device_series_2]
  - name: configKERNEL_INTERRUPT_PRIORITY
    value: 112
    condition: [device_series_2]
  - name: configTIMER_QUEUE_LENGTH
    value: 8
  - name: SL_PSA_ITS_USER_MAX_FILES
    value: 32
    condition: ["device_series_2", "device_security_vault"]
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: 14
    condition: ["device_series_2", "device_security_vault"]
  - name: SL_SLEEPTIMER_PERIPHERAL
    value: SL_SLEEPTIMER_PERIPHERAL_BURTC
    condition: ["device_series_2"]
  - name: CC_ASSOCIATION_MAX_GROUPS_PER_ENDPOINT
    value: 2
  - name: CC_ASSOCIATION_MAX_NODES_IN_GROUPS
    value: 5
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 1
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 1
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: ZAF_APP_NAME
    value: '"sensor_pir"'
  - name: SL_CLOCK_MANAGER_WDOG0CLK_SOURCE
    value: CMU_WDOG0CLKCTRL_CLKSEL_LFRCO
  - name: APP_BUTTON_PRESS_WAKEUP_DELAY
    value: 46 # Average time for Sleep Timer to start after a reset when built in ocelot
    condition: [device_sdid_210]
  - name: APP_BUTTON_PRESS_WAKEUP_DELAY
    value: 285 # Average time for Sleep Timer to start after a reset when built in margay
    condition: [device_sdid_235]
  - name: SL_CLOCK_MANAGER_EUSART0CLK_SOURCE
    value: CMU_EUSART0CLKCTRL_CLKSEL_LFRCO
  # USART configuration
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0    # UART RX shouldn't prevent EM2
  # EUSART configuration
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0    # EUSART RX shouldn't prevent EM2
  - name: SL_IOSTREAM_EUSART_INSTANCE_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
  - name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
    value: 9600 # In EM2 the eusart is working only with 9600 baud
  - name: SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY # Disable high frequency mode for EUSART to work in EM2
    value: 0
  # BRD4204A uses PORTD for EUSART that cannot work in EM2, so we use sl_power_manager to keep the device awake in EM1
  # when Reset button is used or when sleeping is disabled through CLI command.
  - name: ZW_CLI_SLEEPING_WAKEUP_EM1
    value: 1
    condition: [brd4204a]
define:
  - name: APP_PROPERTIES_CONFIG_FILE
    value: <application_properties_config.h>
  - name: FILE_ID_APPLICATIONDATA # File identifiers for application file system
    value: "0x00000" # Range: 0x00000 - 0x0FFFF

config_file:
  - path: SensorPIR.cc_config
    directory: cc_config
  # Sample keys for signing
  - path: ../sample-keys/sample_encrypt.key
    directory: sample_keys
  - path: ../sample-keys/sample_sign.key
    directory: sample_keys

provides:
  - name: zwave_sample_application
  - name: zwave_soc_sensor_pir

template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: battery_report
      handler: cli_battery_report
      help: Send Battery Report
  - name: cli_command
    condition: [zw_cli_common]
    value:
      name: motion_detected
      handler: cli_motion_detected
      help: Emulate - motion detected
      argument:
      - type: string
        help: "activate or deactivate"

post_build:
  profile: zwave_application

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_zwave
  - hwfilter:!board:brd4205a
  - toolchain:gcc

filter:
  - name: "Wireless Technology"
    value: ["Z-Wave"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

readme:
   - path: README.md
ui_hints:
   highlight: README.md
