id: memlcd_eusart
package: board_drivers
label: Memory LCD with eusart SPI driver
description: >
  This component contains functions that can be used by a range of
  Memory LCDs. These Memory LCDs have an SPI interface and can draw one or
  more rows on the display at a time. This component is used by the
  Monochrome (LS013B7DH03) and Color (LS013B7DH06 or LPM013M126A) Memory LCD Drivers.
  This specific version uses the eusart to drive the SPI.
category: Platform|Board Drivers|Memory LCD|Peripheral Driver
quality: production
metadata:
  sbom:
    license: Zlib
root_path: board_drivers/hardware/driver/memlcd
config_file:
- path: config/memlcd_eusart/s2/sl_memlcd_eusart_config.h
  file_id: sl_memlcd_eusart_config
  condition: [device_series_2]
- path: config/memlcd_eusart/s3/sl_memlcd_eusart_config.h
  file_id: sl_memlcd_eusart_config
  condition: [device_series_3]
include:
- path: inc
  file_list:
  - path: sl_memlcd.h
- path: inc/memlcd_eusart
  file_list:
  - path: sl_memlcd_spi.h
source:
- path: src/sl_memlcd.c
- path: src/memlcd_eusart/sl_memlcd_spi.c
- path: src/sl_memlcd_display.c
requires:
- name: sleeptimer
- name: udelay
- name: status
- name: hal_eusart
- name: hal_generic_eusart
- name: clock_manager_runtime
- name: gpio
- name: memlcd_screen
- name: code_classification
provides:
- name: memlcd_eusart
- name: memlcd_driver
template_contribution:
- name: component_catalog
  value: memlcd_eusart
- name: code_classification_components
  value: memlcd
define:
- name: SL_CODE_COMPONENT_MEMLCD
  value: memlcd
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/memlcd
