id: si72xx_driver
package: board_drivers
label: Si72xx - Hall Effect Sensor
description: >
  Driver for the Silicon Labs Si72xx Hall effect sensor
category: Platform|Board Drivers
quality: production
metadata:
  sbom:
    license: Zlib
root_path: board_drivers/hardware/driver/si72xx
provides:
- name: si72xx_driver
include:
- path: inc
  file_list:
  - path: sl_si72xx.h
source:
- path: src/sl_si72xx.c
requires:
- name: i2cspm
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/si72xx
template_contribution:
- name: component_catalog
  value: si72xx_driver
