id: pressure_driver_bmp280
package: board_drivers
label: Pressure device driver for BMP280
description: >
  Pressure sensor driver for BMP280
category: Platform|Board Drivers
quality: production
metadata:
  sbom:
    license: Zlib
root_path: board_drivers/hardware/driver/pressure
provides:
- name: pressure_device_driver
- name: pressure_driver_bmp280
requires:
- name: bmp280_driver
include:
- path: inc
  file_list:
  - path: sl_pressure.h
source:
- path: src/sl_pressure_bmp280.c
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/bmp280
