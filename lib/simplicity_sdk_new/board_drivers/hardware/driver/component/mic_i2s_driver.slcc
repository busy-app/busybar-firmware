id: mic_i2s_driver
package: board_drivers
label: I2S Microphone
description: >
  Sound level I2S microphone driver
category: Platform|Board Drivers
quality: production
metadata:
  sbom:
    license: Zlib
root_path: board_drivers/hardware/driver/mic
provides:
- name: mic_driver_implementation
- name: mic_i2s_driver
requires:
- name: clock_manager_runtime
- name: emlib_ldma
- name: hal_usart
- name: gpio
- name: dmadrv
include:
- path: inc
  file_list:
  - path: sl_mic.h
source:
- path: src/sl_mic_i2s.c
config_file:
- path: config/sl_mic_i2s_config.h
  file_id: mic_i2s_config
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/mic
