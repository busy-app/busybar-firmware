project_name: btmesh_soc_light_hsl
package: bluetooth_mesh_app
label: Bluetooth Mesh - SoC Light HSL
description: >-
  An out-of-the-box software demo where the LEDs of the mainboard can be
  switched on and off, and their lighting intensity, hue, and saturation
  can be set. The example also tries to establish friendship as a Friend node.

category: Bluetooth Mesh Examples
quality: production

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth Mesh"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: app_assert
  - id: app_log
  - id: app_timer
  - id: btmesh_factory_reset
  - id: btmesh_stack_gatt_prov_bearer
  - id: btmesh_stack_relay
  - id: btmesh_friend
  - id: btmesh_hsl_server
  - id: btmesh_lc_server
  - id: btmesh_lighting_server
  - id: btmesh_provisionee
  - id: btmesh_provisioning_decorator
  - id: btmesh_proxy
  - id: btmesh_remote_provisioning_server
  - id: btmesh_iv_update
  - id: cli
    instance:
    - example
  - id: clock_manager
  - id: device_init
  - id: gatt_service_device_information_override
  - id: iostream_recommended_stream
  - id: mpu
  - id: pwm
    instance:
      - led0
      - led1
  - id: rail_util_pti
  - id: simple_button_recommended_instance
  - id: sl_main
  - id: toolchain_gcc_lto
  - id: udelay

source:
  - path: app.c
  - path: app_led.c
  - path: app_out_log.c
  - path: local_cli_commands.c

include:
  - path: .
    file_list:
    - path: app.h
    - path: app_led.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf
  - override:
      component: btmesh_dcd_configuration
      file_id: dcd_configuration_file_id
    path: dcd_config.btmeshconf
    directory: btmeshconf

readme:
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme.md

other_file:
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img0.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img1.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img2.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img3.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img4.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img5.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img6.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img7.png
  - path: ../../documentation/example/btmesh_soc_light_hsl/readme_img8.png

configuration:
  - name: EMDRV_DMADRV_DMA_CH_COUNT
    value: 2
  - name: APP_LOG_LEVEL
    value: "APP_LOG_LEVEL_INFO"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "0x6000"
  - name: SL_BOARD_ENABLE_DISPLAY
    value: "1"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_BTMESH_CONFIG_MAX_PROV_BEARERS
    value: "3"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_STACK_SIZE
    value: "0x1500"

template_contribution:
  - name: cli_command
    value:
      name: info
      handler: info
      help: "Prints info about BT address and mesh UUID"
    condition:
      - cli

post_build:
  - path: "../../postbuild_profile/btmesh_common_s2.slpb"
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hardware:board_only
  - hardware:component:button:2+
  - hardware:component:display:!ls013b7dh03
  - hardware:component:led:2+
  - hardware:device:sdid:!205
  - hardware:rf:band:2400
  - prebuilt_demo
  - hwfilter:device:device_series_2
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:!device:device_generic_family_efr32xg22
  - hwfilter:!board:hardware_board_supports_wstk_lcd
  - hwfilter:board:simple_led:led0
  - hwfilter:board:simple_led:led1
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
  - hwfilter:!board:brd2601b

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
      focus: false
    - path: config/btmeshconf/dcd_config.btmeshconf
      focus: false
    - path: readme.md
      focus: true
