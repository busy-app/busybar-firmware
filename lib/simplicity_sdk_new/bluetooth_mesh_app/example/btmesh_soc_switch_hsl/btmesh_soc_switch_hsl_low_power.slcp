project_name: btmesh_soc_switch_hsl_low_power
package: bluetooth_mesh_app
label: Bluetooth Mesh - SoC Switch HSL Low Power
description: >-
  An out-of-the-box Software Demo where the device acts as a switch using
  the Light HSL Client Model. It is optimized for low current consumption
  with disabled CLI, logging, and LCD. Push Button presses or CLI commands
  can control the lightness, hue and saturation of the LEDs on a remote device.

  Note - this example is not compatible with the Dimming Control NLC Profile.

category: Bluetooth Mesh Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth Mesh"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: app_assert
  - id: app_button_press
  - id: app_timer
  - id: btmesh_hsl_client
  - id: btmesh_factory_reset
  - id: btmesh_stack_gatt_prov_bearer
  - id: btmesh_lpn
  - id: btmesh_provisionee
  - id: btmesh_provisioning_decorator
  - id: btmesh_proxy
  - id: btmesh_remote_provisioning_server
    condition: [device_sdid_200] #xG21
  - id: btmesh_remote_provisioning_server
    condition: [device_sdid_215] #xG24
  - id: btmesh_remote_provisioning_server
    condition: [device_sdid_230] #xG27
  - id: clock_manager
  - id: device_init
  - id: gatt_service_device_information_override
  - id: mpu
  - id: rail_util_pti
  - id: simple_button_recommended_instance
  - id: simple_led_recommended_instance
  - id: sl_main
  - id: toolchain_gcc_lto
  - id: udelay

source:
  - path: app.c
  - path: app_bm.c

include:
  - path: .
    file_list:
    - path: app.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf
  - override:
      component: btmesh_dcd_configuration
      file_id: dcd_configuration_file_id
    path: dcd_config_low_power.btmeshconf
    directory: btmeshconf

readme:
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_low_power.md

other_file:
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img0.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img1.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img2.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img3.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img4.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img5.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img6.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img7.png
  - path: ../../documentation/example/btmesh_soc_switch_hsl/readme_img8.png

configuration:
  - name: SL_BTMESH_LPN_POLL_TIMEOUT_CFG_VAL
    value: 120000
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 100
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "0x6000"
  - name: SL_BTMESH_CONFIG_MAX_PROV_BEARERS
    value: "3"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_SIMPLE_BUTTON_ALLOW_LED_CONFLICT
    value: "1"
  - name: SL_STACK_SIZE
    value: "0x1200"



post_build:
  - path: "../../postbuild_profile/btmesh_common_s2.slpb"
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hardware:board_only
  - hardware:component:button:1+
  - hardware:component:led:1+
  - hardware:device:flash:512
  - hardware:device:ram:32
  - hardware:rf:band:2400
  - hwfilter:device:device_series_2
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_led:led0
  - hwfilter:flash:512k
  - hwfilter:ram:32k

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
      focus: false
    - path: config/btmeshconf/dcd_config.btmeshconf
      focus: false
    - path: readme_low_power.md
      focus: true
