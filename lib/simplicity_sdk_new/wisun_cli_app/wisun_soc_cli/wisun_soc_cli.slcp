project_name: "wisun_soc_cli"
label: "Wi-SUN - CLI example"
description: "The Wi-SUN CLI (Command-Line Interface) sample application allows developers to easily evaluate the Wi-SUN stack APIs.
The Wi-SUN command line interface provides a serial interface to a number of the Wi-SUN stack functions.
For example, it can be used to connect the Wi-SUN device to a Wi-SUN border router and exchange IP packets."
package: "wisun"
category: "Wi-SUN Examples"
quality: "production"

component:
  - id: "wisun_stack_debug"
  - id: "wisun_stack_lfn"
  - id: "wisun_stack_ffn"
  - id: "wisun_default_radioconf"
  - id: "wisun_keychain"
  - id: "wisun_silabs_certificates"
  - id: "wisun_default_phy"
  - id: "wisun_configuration"
  - id: "wisun_rf_test"
  - id: "sl_main"
  - id: "clock_manager"
  - id: "board_control"
    condition: [hardware_board]
  - id: "freertos"
  - id: "sleeptimer"
  - id: "nvm3_default"
  - id: "slist"
  - id: "memory_manager"
  - id: "event_system"
  - id: "iostream_recommended_stream"
  - id: "iostream_retarget_stdio"
  - id: "iostream_stdlib_config"
  - id: "cli"
    instance: [vcom]
  - id: "wisun_cli_util"
  - id: "errno"
  - id: "wisun_crash_handler"

source:
  - path: "app.c"
  - path: "app_cli.c"
  - path: "app_settings.c"
  - path: "app_event_log.c"
  - path: "app_custom_cli_tick.c"
    condition: [wisun_low_power]

include:
  - path: "."
    file_list:
    - path: "app_cli.h"
    - path: "app_settings.h"
    - path: "app_event_log.h"

define:
  - name: "DEBUG_EFM_USER"
  - name: "WISUN_CLI_SAMPLE_APP"
  - name: "DEFAULT_DEVICE_TYPE"
    value: "SL_WISUN_ROUTER"

configuration:
  - name: "SL_BOARD_ENABLE_VCOM"
    value: "1"
  - name: "SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE"
    value: "usartHwFlowControlCtsAndRts"
    condition: [iostream_usart]
  - name: "SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF"
    value: "1"
    condition: [iostream_usart]
  - name: SL_IOSTREAM_EUSART_INSTANCE_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_eusart, wisun_low_power]
  - name: SL_IOSTREAM_EUSART_VCOM_BAUDRATE
    value: 9600
    condition: [iostream_eusart, wisun_low_power]
  - name: SL_IOSTREAM_EUSART_VCOM_ENABLE_HIGH_FREQUENCY
    value: 0
    condition: [iostream_eusart, wisun_low_power]
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "true"
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 1
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_RX_BUFFER_SIZE
    value: "128" # Increase from default 32 to account for automated command
                 # storage entry and for when long command strings are
                 # interrupted by chip interrupts.
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition: [iostream_eusart]
  - name: SL_IOSTREAM_LEUART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "1"
    condition: [iostream_leuart]
  - name: SL_IOSTREAM_LEUART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition: [iostream_leuart]
  - name: SL_IOSTREAM_LEUART_VCOM_RX_BUFFER_SIZE
    value: "128" # Increase from default 32 to account for automated command
                 # storage entry and for when long command strings are
                 # interrupted by chip interrupts.
    condition: [iostream_leuart]
  - name: CPU_CFG_TS_32_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "1"
  - name: OS_CFG_TS_EN
    value: "1"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "1"
    unless: [wisun_low_power]
  - name: OS_CFG_STAT_TASK_EN
    value: "1"
    unless: [wisun_low_power]
  - name: OS_CFG_TASK_PROFILE_EN
    value: "1"
    unless: [wisun_low_power]
  - name: "OS_CFG_APP_HOOKS_EN"
    value: "1"
    condition: [micriumos_kernel]
  - name: "WISUN_CLI_AUTO_SAVE"
    value: "0"
  - name: SL_RAIL_UTIL_PTI_BAUD_RATE_HZ
    value: "3200000"
  - name: SL_MBEDTLS_SSL_IN_CONTENT_LEN
    value: 1024
  - name: SL_CLI_INPUT_BUFFER_SIZE
    value: 256
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2048
  - name: SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_SELECTION
    value: "SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_OFDM"
    condition: [device_sdid_220]
  - name: SL_SLEEPTIMER_WALLCLOCK_CONFIG
    value: 1
  - name: SL_SLEEPTIMER_PERIPHERAL
    value: SL_SLEEPTIMER_PERIPHERAL_BURTC
    condition: [wisun_low_power]

template_contribution:
  - name: "event_handler"
    value:
      event: "internal_app_init"
      include: "app_cli.h"
      handler: "app_cli_init"
  - name: "cli_command"
    value:
      name: "about"
      handler: "app_about"
      help: "Get info about the running app"
      shortcuts:
        - name: "a"
# -------------------------------
  - name: "cli_group"
    value:
      name: "wisun"
      help: "Wi-SUN commands"
      shortcuts:
        - name: "w"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_fan10"
      handler: "app_join_fan10"
      help: "Connect to a Wi-SUN network using FAN1.0 settings: w j10"
      shortcuts:
        - name: "j10"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_fan11"
      handler: "app_join_fan11"
      help: "Connect to a Wi-SUN network using FAN1.1 settings: w j11"
      shortcuts:
        - name: "j11"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_explicit"
      handler: "app_join_explicit"
      help: "Connect to a Wi-SUN network using explicit PHY settings: w je"
      shortcuts:
        - name: "je"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_ids"
      handler: "app_join_ids"
      help: "Connect to a Wi-SUN network using radio conf ids: w ji"
      shortcuts:
        - name: "ji"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_custom_fsk"
      handler: "app_join_custom_fsk"
      help: "Connect to a Wi-SUN network using custom FSK PHY settings: w jcf"
      shortcuts:
        - name: "jcf"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_custom_ofdm"
      handler: "app_join_custom_ofdm"
      help: "Connect to a Wi-SUN network using custom OFDM PHY settings: w jcof"
      shortcuts:
        - name: "jcof"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "join_custom_oqpsk"
      handler: "app_join_custom_oqpsk"
      help: "Connect to a Wi-SUN network using custom OQPSK PHY settings: w jcoq"
      shortcuts:
        - name: "jcoq"

  - name: "cli_command"
    value:
      group: "wisun"
      name: "disconnect"
      handler: "app_disconnect"
      help: "Disconnect from the Wi-SUN network: w d"
      shortcuts:
        - name: "d"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "ping"
      handler: "app_ping"
      help: "Ping a remote host: w p"
      shortcuts:
        - name: "p"
      argument:
        - type: string
          help: "Remote address"
        - type: uint16opt
          help: "packet size in byte"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "tcp_client"
      handler: "app_tcp_client"
      help: "Open a TCP client socket: w tc"
      shortcuts:
        - name: "tc"
      argument:
        - type: string
          help: "Remote address"
        - type: uint16
          help: "Remote port"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "tcp_server"
      handler: "app_tcp_server"
      help: "Open a TCP server socket: w ts"
      shortcuts:
        - name: "ts"
      argument:
        - type: uint16
          help: "Local port"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "udp_client"
      handler: "app_udp_client"
      help: "Open a UDP client socket: w uc"
      shortcuts:
        - name: "uc"
      argument:
        - type: string
          help: "Remote address"
        - type: uint16
          help: "Remote port"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "udp_server"
      handler: "app_udp_server"
      help: "Open a UDP server socket: w us"
      shortcuts:
        - name: "us"
      argument:
        - type: uint16
          help: "Local port"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_close"
      handler: "app_socket_close"
      help: "Close a socket: w sc"
      shortcuts:
        - name: "sc"
      argument:
        - type: uint32
          help: "Socket Id"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_read"
      handler: "app_socket_read"
      help: "Read from a socket: w sr"
      shortcuts:
        - name: "sr"
      argument:
        - type: uint32
          help: "Socket Id"
        - type: uint16
          help: "Amount of bytes to read"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_write"
      handler: "app_socket_write"
      help: "Write to a socket: w sw"
      shortcuts:
        - name: "sw"
      argument:
        - type: uint32
          help: "Socket Id"
        - type: string
          help: "Data to write"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_writeto"
      handler: "app_socket_writeto"
      help: "Write to a socket to a specific host: w swt"
      shortcuts:
        - name: "swt"
      argument:
        - type: uint32
          help: "Socket Id"
        - type: string
          help: "Remote address"
        - type: uint16
          help: "Remote port"
        - type: string
          help: "Data to write"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_list"
      handler: "app_socket_list"
      help: "List open sockets: w sl"
      shortcuts:
        - name: "sl"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_set_option"
      handler: "app_socket_set_option"
      help: "Set a socket option: w ss"
      shortcuts:
        - name: "ss"
      argument:
        - type: uint32
          help: "Socket Id"
        - type: string
          help: "Option"
        - type: string
          help: "Option data"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "mac_allow"
      handler: "app_mac_allow"
      help: "Add a MAC address to the list of allowed addresses, FF:FF:FF:FF:FF:FF:FF:FF to allow all MAC addresses: w ma"
      shortcuts:
        - name: "ma"
      argument:
        - type: string
          help: "MAC address"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "mac_deny"
      handler: "app_mac_deny"
      help: "Add a MAC address to the list of denied addresses, FF:FF:FF:FF:FF:FF:FF:FF to deny all MAC addresses: w md"
      shortcuts:
        - name: "md"
      argument:
        - type: string
          help: "MAC address"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "socket_get_option"
      handler: "app_socket_get_option"
      help: "Get a socket option: w sg"
      shortcuts:
        - name: "sg"
      argument:
        - type: wildcard
          help: empty | [uint32] Socket Id [string] Option
  - name: "cli_command"
    value:
      group: "wisun"
      name: "clear_credential_cache"
      handler: "app_clear_credential_cache"
      help: "Clear the credential cache: w ccc"
      shortcuts:
        - name: "ccc"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "reset_statistics"
      handler: "app_reset_statistics"
      help: "Reset the statistics: w rs"
      shortcuts:
        - name: "rs"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_trace_level"
      handler: "app_set_trace_level"
      help: "Set the trace level: w tl"
      shortcuts:
        - name: "tl"
      argument:
        - type: string
          help: "List of ID,level; such as 1,none;4,info to configure group ID 1 with no log and group ID 4 with INFO level. Can also use all,info to set all groups to INFO level"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_lfn_support"
      handler: "app_set_lfn_support"
      help: "configure LFN support"
      argument:
        - type: uint8
          help: "lfn_limit: Number of locally supported LFN"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "mode_switch"
      handler: "app_mode_switch"
      help: "configure mode witch: w ms"
      shortcuts:
        - name: "ms"
      argument:
        - type: uint8
          help: "mode: 0=disabled, 1=enabled, 2=default"
        - type: uint8
          help: "PhyModeId"
        - type: stringopt
          help: "neighbor MAC address (optional)"
    condition:
      - "cli"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "concurrent_detection"
      handler: "app_concurrent_detection"
      help: "configure concurrent detection: w cd"
      shortcuts:
        - name: "cd"
      argument:
        - type: uint8
          help: "enable: 0=disabled, 1=enabled"
    condition:
      - "cli"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "trigger"
      handler: "app_trigger_frame"
      help: "Trigger the transmission of a frame"
      shortcuts:
        - name: "tx"
      argument:
        - type: string
          help: "frame type"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "getsockname"
      handler: "app_getsockname"
      help: "Get socket's local Ip address"
      argument:
        - type: uint32
          help: "Socket Id"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "getpeername"
      handler: "app_getpeername"
      help: "Get socket's peer Ip address"
      argument:
        - type: uint32
          help: "Socket Id"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_leaf"
      handler: "app_set_leaf"
      help: "Set Leaf behavior"
      argument:
        - type: uint8
          help: "is_leaf: 1 to act as RPL leaf"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_direct_connect_state"
      handler: "app_set_direct_connect_state"
      help: "Enable/disable Direct Connect"
      argument:
        - type: uint8
          help: "is_enabled: 1 to enable Direct Connect"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "accept_direct_connect_link"
      handler: "app_accept_direct_connect_link"
      help: "Accept a Direct Connect link"
      argument:
        - type: string
          help: "Client link local address"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_phy_sens"
      handler: "app_set_phy_sensitivity"
      help: "Set the sensitivity for the given PHY mode ID"
      argument:
        - type: uint8
          help: "PHY mode ID"
        - type: int16
          help: "Sensitivity in dBm"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "reset_duty_cycle"
      handler: "app_reset_duty_cycle"
      help: "Reset the duty cycle counters"
      shortcuts: "rdc"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "set_event_log_filter"
      handler: "app_set_event_log_filter"
      help: "Set an event log filter: w sf"
      shortcuts:
        - name: "sf"
      argument:
        - type: string
          help: "Neighbor MAC address, FF:FF:FF:FF:FF:FF:FF:FF for default filtering"
        - type: hex
          help: "Event filter mask written in hex format (for example {02} for received packets)"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "eventlog"
      handler: "app_event_log"
      help: "Read the eventlog: w el"
      shortcuts:
        - name: "el"
      argument:
        - type: string
          help: "Neighbor MAC address"
  - name: "cli_command"
    value:
      group: "wisun"
      name: "clear_event_log_filter"
      handler: "app_clear_event_log_filter"
      help: "Read the eventlog: w cf"
      shortcuts:
        - name: "cf"

# -------------------------------
  - name: "cli_group"
    value:
      name: "rftest"
      help: "RF test commands"
      shortcuts:
        - name: "rft"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "start_stream"
      handler: "app_rftest_start_stream"
      help: "Start an RF test stream: rft strs"
      argument:
        - type: uint16
          help: "Channel Id"
        - type: uint8opt
          help: "phy config type (optional, 1=FAN1.1 by default): 0=FAN1.0, 1=FAN1.1, 2=Explicit PHY, 3=Explicit RAIL (IDS), 4=Custom FSK, 5=Custom OFDM, 6=Custom OQPSK"
      shortcuts:
        - name: "[strs] "
  - name: "cli_command"
    value:
      group: "rftest"
      name: "stop_stream"
      handler: "app_rftest_stop_stream"
      help: "Stop an RF test stream: rft stps"
      shortcuts:
        - name: "stps"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "start_tone"
      handler: "app_rftest_start_tone"
      help: "Start an RF test tone: rft strt"
      argument:
        - type: uint16
          help: "Channel Id"
        - type: uint8opt
          help: "phy config type (optional, 1=FAN1.1 by default): 0=FAN1.0, 1=FAN1.1, 2=Explicit PHY, 3=Explicit RAIL (IDS), 4=Custom FSK, 5=Custom OFDM, 6=Custom OQPSK"
      shortcuts:
        - name: "strt"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "stop_tone"
      handler: "app_rftest_stop_tone"
      help: "Stop an RF test tone: rft stpt"
      shortcuts:
        - name: "stpt"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "start_tx"
      handler: "app_rftest_start_tx"
      help: "Start RF test TX: rft stx <channel> <count> <data_length> <interval> <cca>"
      argument:
        - type: uint16
          help: "Channel Id"
        - type: uint16
          help: "Number of packets to transmit"
        - type: uint16
          help: "Data length per packet"
        - type: uint32
          help: "Interval between transmissions (ms)"
        - type: uint8
          help: "CCA enable (0=off, else=on)"
        - type: uint8opt
          help: "phy config type (optional, 1=FAN1.1 by default): 0=FAN1.0, 1=FAN1.1, 2=Explicit PHY, 3=Explicit RAIL (IDS), 4=Custom FSK, 5=Custom OFDM, 6=Custom OQPSK"
      shortcuts:
        - name: "stx"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "start_rx"
      handler: "app_rftest_start_rx"
      help: "Start RF test RX: rft srx <channel> <duration>"
      argument:
        - type: uint16
          help: "Channel Id"
        - type: uint32
          help: "Duration (ms)"
        - type: uint8opt
          help: "phy config type (optional, 1=FAN1.1 by default): 0=FAN1.0, 1=FAN1.1, 2=Explicit PHY, 3=Explicit RAIL (IDS), 4=Custom FSK, 5=Custom OFDM, 6=Custom OQPSK"
      shortcuts:
        - name: "srx"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "stop_rx"
      handler: "app_rftest_stop_rx"
      help: "Stop RF test RX: rft stprx"
      shortcuts:
        - name: "stprx"
  - name: "cli_command"
    value:
      group: "rftest"
      name: "set_tx_power"
      handler: "app_rftest_set_tx_power"
      help: "Set Tx Power for RF test: rft sttx"
      argument:
        - type: int8
          help: "Tx Power (dBm)"
      shortcuts:
        - name: "sttx"

readme:
  - path: doc/readme.md

other_file:
  - path: doc/readme_img0.png

toolchain_settings:
  - option: optimize
    value: debug
    condition: [wisun_stack_debug]
  - option: optimize
    value: size
    unless: [wisun_stack_debug]

ui_hints:
  highlight:
    - path: doc/readme.md
      focus: true

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_wisun

filter:
  - name: "Wireless Technology"
    value: ["Wi-SUN"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]
