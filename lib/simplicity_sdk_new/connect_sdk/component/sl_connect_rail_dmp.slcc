id: "sl_connect_rail_dmp"
label: "Connect Rail DMP"
package: "connect_sdk"
description: >
  The Connect RAIL DMP component creates a RAIL task that utilizes the radio
  configuration's second protocol for communication over Base profile PHYs.
  DMP requires applications to use an RTOS;
  adding this component will upgrade the project with the selected OS.
  Component is designed to operate independently of any Connect activity.
  However, due to the properties of RAIL DMP, when the radio is used by
  the RAIL thread, Connect protocol communications will be halted.
category: "Connect|Utility"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "connect_sdk/component/sl_connect_rail_dmp"
provides:
- name: "sl_connect_rail_dmp"
requires:
- name: sl_connect_rail_dmp_cli
- name: kernel
- name: rail_lib_multiprotocol
- name: sl_rail_util_init
- name: restrictions_profile_base
source:
- path: "micrium/sl_connect_rail_dmp_micrium.c"
  condition:
  - "micriumos_kernel"
- path: "freertos/sl_connect_rail_dmp_freertos.c"
  condition:
  - "freertos"
- path: "sl_connect_rail_dmp.c"

include:
- path: "."
  file_list:
  - path: "sl_connect_rail_dmp.h"

#-------------- Template Contribution ----------------
template_contribution:
#---------------------- Init -------------------------
- name: event_handler
  value:
    event: internal_app_init
    include: "sl_connect_rail_dmp.h"
    handler: "rail_app_task_init"
  priority: 9000
#---------------- Component Catalog ------------------
- name: component_catalog
  value: sl_connect_rail_dmp
