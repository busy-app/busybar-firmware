id: "sl_connect_rail_dmp_cli"
label: "Connect Rail DMP - CLI support"
package: "connect_sdk"
description: >
  Connect RAIL DMP application command line interface.
category: "Connect|Utility"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "connect_sdk/component/sl_connect_rail_dmp"
requires:
- name: sl_connect_rail_dmp
- name: cli
provides:
- name: "sl_connect_rail_dmp_cli"
source:
- path: "sl_connect_rail_dmp_cli.c"

include:
- path: "."
  file_list:
  - path: "sl_connect_rail_dmp.h"

#-------------- Template Contribution ----------------
template_contribution:
#------------------ CLI ---------------------
- name: cli_group
  value:
    name: rail
    help: RAIL commands
- name: cli_command
  value:
    name: send
    group: rail
    handler: cli_send_packet
    help: Send a packet
- name: cli_command
  value:
    name: receive
    group: rail
    handler: cli_receive_packet
    help: Turn ON/OFF RAIL receive
    argument:
    - type: uint8
      help: ON/OFF
#---------------- Component Catalog ------------------
- name: component_catalog
  value: sl_connect_rail_dmp_button
