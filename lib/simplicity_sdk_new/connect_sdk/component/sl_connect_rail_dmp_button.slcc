id: "sl_connect_rail_dmp_button"
label: "Connect Rail DMP - Button support"
package: "connect_sdk"
description: >
  Connect RAIL DMP application button handler.
  If Simple Button already used by the app, this component will throw
  Compiler error as sl_button_on_change will be defined two times.
category: "Connect|Utility"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "connect_sdk/component/sl_connect_rail_dmp"
requires:
- name: sl_connect_rail_dmp
- name: simple_button
provides:
- name: "sl_connect_rail_dmp_button"
source:
- path: "sl_connect_rail_dmp_button.c"

include:
- path: "."
  file_list:
  - path: "sl_connect_rail_dmp.h"

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
- name: component_catalog
  value: sl_connect_rail_dmp_button
