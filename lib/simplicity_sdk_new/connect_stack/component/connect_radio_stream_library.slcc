id: "connect_radio_stream_library"
label: "Radio Stream (Library)"
package: "connect_stack"
category: "Connect"
quality: "production"
ui_hints:
  visibility: never
description: "Provides the Connect Radio Stream library."
provides:
- name: "connect_radio_stream_implementation"
requires:
- name: "connect_radio_stream"
library:
- path: "libs/libconnect-radio-stream-library-efr32xg2x-iar.a"
  condition:
  - "toolchain_iar"
  - device_series_2
- path: "libs/libconnect-radio-stream-library-efr32xg2x-gcc.a"
  condition:
  - "toolchain_gcc"
  - device_series_2

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
