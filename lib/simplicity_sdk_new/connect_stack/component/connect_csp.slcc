id: connect_csp
label: Connect Serialization Protocol component
package: "connect_stack"
description: Provides source files for components requiring CSP
category: Connect
quality: production
ui_hints:
  visibility: never

provides:
- name: connect_csp

requires:
- name: connect_stack_common

source:
- path: "csp/csp-format.c"
- path: "csp/csp-command-app.c"
  condition:
  - "connect_cmsis_stack_ipc"
- path: "csp/csp-command-vncp.c"
- path: "csp/csp-command-callbacks-app.c"
  unless: [connect_ncp]
- path: "csp/csp-command-callbacks-vncp.c"
- path: "ncp/ncp-stubs.c"
  unless: [connect_ncp]

include:
- path: csp
  file_list:
  - path: csp-command-utils.h
  - path: csp-format.h
  - path: csp-api-enum-gen.h
- path: "ncp"
  file_list:
  - path: "ncp-security.h"

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
