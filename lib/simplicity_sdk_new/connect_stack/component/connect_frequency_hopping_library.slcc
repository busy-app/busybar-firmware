id: "connect_frequency_hopping_library"
label: "Frequency Hopping (Library)"
package: "connect_stack"
category: "Connect"
quality: "production"
ui_hints:
  visibility: never
description: "Provides the Connect Frequency Hopping library."
provides:
- name: "connect_frequency_hopping_implementation"
requires:
- name: "connect_frequency_hopping"
library:
- path: "libs/libconnect-frequency-hopping-library-efr32xg2x-iar.a"
  condition:
  - "toolchain_iar"
  - device_series_2
- path: "libs/libconnect-frequency-hopping-library-efr32xg2x-gcc.a"
  condition:
  - "toolchain_gcc"
  - device_series_2

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
