id: "connect_stack_common_library"
label: "Stack Common (Library)"
package: "connect_stack"
category: "Connect"
quality: "production"
ui_hints:
  visibility: never
description: "Provides the Connect stack common library."
provides:
- name: "connect_stack_common_implementation"
requires:
- name: "connect_stack_common"
library:
- path: "libs/libconnect-stack-common-library-efr32xg2x-iar.a"
  condition:
  - "toolchain_iar"
  - device_series_2
- path: "libs/libconnect-stack-common-library-efr32xg2x-gcc.a"
  condition:
  - "toolchain_gcc"
  - device_series_2

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
