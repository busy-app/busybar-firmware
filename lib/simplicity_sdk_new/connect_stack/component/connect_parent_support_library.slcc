id: "connect_parent_support_library"
label: "Parent Support (Library)"
package: "connect_stack"
category: "Connect"
quality: "production"
ui_hints:
  visibility: never
description: "Provides the Connect Parent Support library."
provides:
- name: "connect_parent_support_implementation"
requires:
- name: "connect_parent_support"
library:
- path: "libs/libconnect-parent-support-library-efr32xg2x-iar.a"
  condition:
  - "toolchain_iar"
  - device_series_2
- path: "libs/libconnect-parent-support-library-efr32xg2x-gcc.a"
  condition:
  - "toolchain_gcc"
  - device_series_2

metadata:
  sbom:
    license: Zlib
root_path: connect_stack
