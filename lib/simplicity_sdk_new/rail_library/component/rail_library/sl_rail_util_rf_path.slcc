id: sl_rail_util_rf_path
label: RAIL Utility, RF Path (RAIL 3)
description: Utility to aid with RAIL RF Path Support (e.g., device-internal RF path, device-external antenna diversity)
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_rf_path
    name: RAIL Utility, RF Path (RAIL 3)
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-rf-path
provides:
- name: sl_rail_util_rf_path
- name: rail_util_rf_path
requires:
- name: device
- name: rail_lib
- name: component_catalog
config_file:
- path: plugin/sl_rail_util_rf_path/config/efr32xg21/sl_rail_util_rf_path_config.h
  file_id: rail_util_rf_path_config
  condition:
  - device_series_2
  - device_sdid_200
- path: plugin/sl_rail_util_rf_path/config/efr32xg23/sl_rail_util_rf_path_config.h
  file_id: rail_util_rf_path_config
  condition:
  - device_series_2
  - device_sdid_210
- path: plugin/sl_rail_util_rf_path/config/efr32xg28/sl_rail_util_rf_path_config.h
  file_id: rail_util_rf_path_config
  condition:
  - device_series_2
  - device_sdid_235
- path: plugin/sl_rail_util_rf_path/config/efr32xg2d/sl_rail_util_rf_path_config.h
  file_id: rail_util_rf_path_config
  condition:
  - device_series_2
  - device_sdid_260
include:
- path: plugin/sl_rail_util_rf_path
  file_list:
  - path: sl_rail_util_rf_path.h
source:
- path: plugin/sl_rail_util_rf_path/sl_rail_util_rf_path.c
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: sl_rail_util_rf_path.h
    handler: sl_rail_util_rf_path_init
  priority: -9010
- name: component_catalog
  value: sl_rail_util_rf_path
- name: component_catalog
  value: rail_util_rf_path
root_path: rail_library
