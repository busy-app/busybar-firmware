id: sl_rail_util_callbacks
label: RAIL Utility, Callbacks (RAIL 3)
description: Utility to aid with RAIL Callback Support
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_callbacks
    name: RAIL Utility, Callbacks (RAIL 3)
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-callbacks
provides:
- name: sl_rail_util_callbacks
- name: rail_util_callbacks
requires:
- name: rail_lib
- name: hal_generic_common
- name: component_catalog
include:
- path: plugin/sl_rail_util_callbacks
  file_list:
  - path: sl_rail_util_callbacks.h
  - path: sli_rail_util_callbacks.h
config_file:
- path: plugin/sl_rail_util_callbacks/config/sl_rail_util_callbacks_config.h
template_file:
- path: plugin/sl_rail_util_callbacks/sl_rail_util_callbacks.c.jinja
template_contribution:
- name: component_catalog
  value: sl_rail_util_callbacks
  unless: [rail2_util_callbacks]
- name: component_catalog
  value: rail_util_callbacks
root_path: rail_library
