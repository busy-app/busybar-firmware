id: sl_rail_util_pti
label: RAIL Utility, PTI (RAIL 3)
description: Utility to aid with RAIL Packet Trace Interface (PTI) Support
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_pti
    name: RAIL Utility, PTI (RAIL 3)
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-pti
provides:
- name: sl_rail_util_pti
- name: rail_util_pti
requires:
- name: rail_lib
- name: gpio
- name: component_catalog
config_file:
- path: plugin/sl_rail_util_pti/config/efr32xg25/sl_rail_util_pti_config.h
  file_id: rail_util_pti_config
  condition:
  - device_sdid_220
- path: plugin/sl_rail_util_pti/config/sl_rail_util_pti_config.h
  file_id: rail_util_pti_config
  unless:
  - device_sdid_220
include:
- path: plugin/sl_rail_util_pti
  file_list:
  - path: sl_rail_util_pti.h
source:
- path: plugin/sl_rail_util_pti/sl_rail_util_pti.c
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: sl_rail_util_pti.h
    handler: sl_rail_util_pti_init
  priority: -9010
- name: component_catalog
  value: sl_rail_util_pti
- name: component_catalog
  value: rail_util_pti
validation_helper:
- path: plugin/sl_rail_util_pti/pti_validation.lua
root_path: rail_library
