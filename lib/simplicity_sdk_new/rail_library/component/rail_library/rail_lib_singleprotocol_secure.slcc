id: rail_lib_singleprotocol_secure
label: RAIL Library, Single Protocol Release Secure
description: Single Protocol RAIL Library Support using secure addresses to access registers
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: rail_lib_singleprotocol_secure
    name: RAIL Library, Single Protocol Release Secure
    license: MSLA
requires:
- name: rail_lib
- name: rail_util_built_in_phys
  condition:
  - device_init
provides:
- name: rail_lib_singleprotocol_secure   # specific tag
- name: rail_lib_Xprotocol   # generic tag
documentation:
  docset: rail
  document: rail-api/rail-lib
define:
- name: SL_RAIL_LIB_MULTIPROTOCOL_SUPPORT
  value: '0'
library:
- path: autogen/librail_release/librail_efr32xg21_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_200
  unless:
  - device_is_module
- path: autogen/librail_release/librail_efr32xg21_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_200
  unless:
  - device_is_module
  - toolchain_llvm
- path: autogen/librail_release/librail_efr32xg21_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_200
  unless:
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg21_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_200
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg21_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_200
  - device_is_module
  unless:
  - toolchain_llvm
- path: autogen/librail_release/librail_module_efr32xg21_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_200
  - device_is_module

- path: autogen/librail_release/librail_efr32xg22_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_205
  unless:
  - device_is_module
- path: autogen/librail_release/librail_efr32xg22_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_205
  unless:
  - device_is_module
  - toolchain_llvm
- path: autogen/librail_release/librail_efr32xg22_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_205
  unless:
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg22_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_205
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg22_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_205
  - device_is_module
  unless:
  - toolchain_llvm
- path: autogen/librail_release/librail_module_efr32xg22_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_205
  - device_is_module

- path: autogen/librail_release/librail_efr32xg23_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_210
  unless:
  - device_is_module
- path: autogen/librail_release/librail_efr32xg23_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_210
  unless:
  - device_is_module
  - toolchain_llvm
- path: autogen/librail_release/librail_efr32xg23_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_210
  unless:
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg23_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_210
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg23_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_210
  - device_is_module
  unless:
  - toolchain_llvm
- path: autogen/librail_release/librail_module_efr32xg23_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_210
  - device_is_module

- path: autogen/librail_release/librail_efr32xg24_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_215
  unless:
  - device_is_module
- path: autogen/librail_release/librail_efr32xg24_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_215
  unless:
  - device_is_module
  - toolchain_llvm
- path: autogen/librail_release/librail_efr32xg24_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_215
  unless:
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg24_iar_secure.a
  condition:
  - toolchain_iar
  - device_sdid_215
  - device_is_module
- path: autogen/librail_release/librail_module_efr32xg24_gcc_secure.a
  condition:
  - toolchain_gcc
  - device_sdid_215
  - device_is_module
  unless:
  - toolchain_llvm
- path: autogen/librail_release/librail_module_efr32xg24_llvm_secure.a
  condition:
  - toolchain_llvm
  - device_sdid_215
  - device_is_module
root_path: rail_library
