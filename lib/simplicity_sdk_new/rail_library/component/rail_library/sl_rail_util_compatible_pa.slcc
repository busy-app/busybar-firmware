id: sl_rail_util_compatible_pa
label: RAIL Utility, PA compatibility
description: Utility to aid selecting the desired PA conversion component
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_compatible_pa
    name: RAIL Utility, PA compatibility
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-pa
provides:
- name: sl_rail_util_compatible_pa
requires:
- name: sl_rail_util_pa_integration
- name: rail_util_pa
  condition:
  - device_is_module
- name: rail_util_pa
  condition:
  - rail_util_pa_nvm_configs
- name: component_catalog
recommends:
- id: sl_rail_util_pa
  vendor: silabs
include:
- path: plugin/sl_rail_util_compatible_pa
  file_list:
  - path: sl_rail_util_compatible_pa.h
template_contribution:
- name: component_catalog
  value: sl_rail_util_compatible_pa
root_path: rail_library
