id: sl_rail_util_standard_phys
label: RAIL Utility, Standards based PHYs
package: rail_library
description: Radio configurations for standards based PHYs.
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_standard_phys
    name: RAIL Utility, Standards based PHYs
    license: Zlib
provides:
- name: sl_rail_util_standard_phys
- name: a_radio_config
