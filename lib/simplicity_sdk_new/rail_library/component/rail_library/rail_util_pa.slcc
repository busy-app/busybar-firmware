id: rail_util_pa
label: RAIL Utility, PA (RAIL 2.x)
description: Utility to aid with RAIL RF Power Amplifier (PA) Support
package: rail_library
category: Platform|Radio|RAIL 2.x
quality: deprecated
metadata:
  sbom:
    id: rail_util_pa
    name: RAIL Utility, PA (RAIL 2.x)
    license: Zlib
requires:
- name: rail_lib
- name: emlib_cmu
  condition:
  - device_series_2
- name: device
- name: hal_generic_common
provides:
- name: rail_util_pa
- name: sl_rail_util_pa_integration
conflicts:
- name: sl_rail_util_pa
documentation:
  docset: rail
  document: rail-api/rail-util-pa
define:
- name: SL_RAIL_UTIL_PA_CONFIG_HEADER
  value: <sl_rail_util_pa_config.h>
- name: SL_RAIL_UTIL_PA_PLUGIN_HEADER
  value: <pa_conversions_efr32.h>
config_file:
