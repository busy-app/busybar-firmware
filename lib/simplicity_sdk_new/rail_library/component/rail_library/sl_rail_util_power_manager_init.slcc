id: sl_rail_util_power_manager_init
label: RAIL Utility, Power manager init (RAIL 3)
description: Utility to aid with RAIL power manager initialization
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_power_manager_init
    name: RAIL Utility, Power manager init (RAIL 3)
    license: Zlib
ui_hints:
  visibility: never
provides:
- name: sl_rail_util_power_manager_init
- name: rail_util_power_manager_init
requires:
- name: rail_lib
- name: power_manager
- name: component_catalog
config_file:
- path: plugin/sl_rail_util_power_manager_init/config/sl_rail_util_power_manager_init_config.h
include:
- path: plugin/sl_rail_util_power_manager_init
  file_list:
  - path: sl_rail_util_power_manager_init.h
source:
- path: plugin/sl_rail_util_power_manager_init/sl_rail_util_power_manager_init.c
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: sl_rail_util_power_manager_init.h
    handler: sl_rail_util_power_manager_init
  priority: -9010
- name: component_catalog
  value: sl_rail_util_power_manager_init
- name: component_catalog
  value: rail_util_power_manager_init
root_path: rail_library
