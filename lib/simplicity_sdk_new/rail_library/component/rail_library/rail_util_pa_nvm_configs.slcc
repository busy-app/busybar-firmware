id: rail_util_pa_nvm_configs
label: RAIL Utility, NVM storage of PA configs and mode (RAIL 2.x)
description: Utility to aid with persistent storing and accessing RAIL RF Power Amplifier (PA) configurations and mode
package: rail_library
category: Platform|Radio|RAIL 2.x
quality: deprecated
metadata:
  sbom:
    id: rail_util_pa_store_nvm
    name: RAIL Utility, PA NVM (RAIL 2.x)
    license: Zlib
requires:
- name: rail_util_pa
- name: nvm3_default
- name: status

provides:
- name: rail_util_pa_nvm_configs

conflicts:
- name: device_is_module

documentation:
  docset: rail
  document: rail-api/rail-util-pa

include:
- path: plugin/pa-conversions/nvm
  file_list:
  - path: sl_rail_util_pa_nvm_configs.h
source:
- path: plugin/pa-conversions/nvm/sl_rail_util_pa_nvm_configs.c
  condition:
  - device_sdid_215
- path: plugin/pa-conversions/nvm/sl_rail_util_pa_nvm_configs.c
  condition:
  - device_sdid_225
define:
- name: SL_RAIL_UTIL_PA_NVM_ENABLED
  value: '1'
  condition:
  - device_sdid_215
- name: SL_RAIL_UTIL_PA_NVM_ENABLED
  value: '1'
  condition:
  - device_sdid_225
root_path: rail_library
