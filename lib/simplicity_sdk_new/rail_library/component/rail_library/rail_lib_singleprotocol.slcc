id: rail_lib_singleprotocol
label: RAIL Library, Single Protocol
description: Single Protocol RAIL Library Support
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: rail_lib_singleprotocol
    name: RAIL Library, Single Protocol
    license: MSLA
requires:
- name: rail_lib
- name: rail_util_built_in_phys
  condition:
  - device_init
- name: rail_lib_singleprotocol_alpha_chips_support
- name: rail_lib_singleprotocol_internal_chips_support
recommends:
- id: rail_lib_singleprotocol_alpha_chips
  vendor: silabs
- id: rail_lib_singleprotocol_internal_chips
  vendor: silabs
provides:
- name: rail_lib_singleprotocol   # specific tag
- name: rail_lib_Xprotocol   # generic tag
documentation:
  docset: rail
  document: rail-api/rail-lib
define:
- name: SL_RAIL_LIB_MULTIPROTOCOL_SUPPORT
  value: '0'
library:
- path: autogen/librail_release/librail_efr32xg21_iar_release.a
  condition:
  - toolchain_iar
  - device_sdid_200
  unless:
  - device_is_module
- path: autogen/librail_release/librail_efr32xg21_gcc_release.a
