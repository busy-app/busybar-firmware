id: sl_rail_util_vdet
label: RAIL Utility, VDET (RAIL 3)
description: Utility to provide RAIL with Front End Module Voltage Detect (VDET) support. Allows ADC voltage measurements timed with the start of TX packets for tuning FEM performance.
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_vdet
    name: RAIL Utility, VDET (RAIL 3)
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-vdet
provides:
- name: sl_rail_util_vdet
- name: rail_util_vdet
requires:
- name: device
- name: rail_lib
- name: device_sdid_220
- name: component_catalog
config_file:
- path: plugin/sl_rail_util_vdet/config/efr32xg2x/sl_rail_util_vdet_config.h
  file_id: rail_util_vdet_config
  condition:
  - device_sdid_220
include:
- path: plugin
- path: plugin/sl_rail_util_vdet/
  file_list:
  - path: sl_rail_util_vdet.h
source:
- path: plugin/sl_rail_util_vdet/sl_rail_util_vdet.c
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: sl_rail_util_vdet.h
    handler: sl_rail_util_vdet_init
  priority: -9010
- name: component_catalog
  value: sl_rail_util_vdet
- name: component_catalog
  value: rail_util_vdet
root_path: rail_library
