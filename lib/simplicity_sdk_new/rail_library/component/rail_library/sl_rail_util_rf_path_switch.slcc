id: sl_rail_util_rf_path_switch
label: RAIL Utility, RF Path Switch Control (RAIL 3)
description: Utility to aid with RAIL RF Path Switch control.
package: rail_library
category: Platform|Radio
quality: production
metadata:
  sbom:
    id: sl_rail_util_rf_path_switch
    name: RAIL Utility, RF Path Switch Control (RAIL 3)
    license: Zlib
documentation:
  docset: rail
  document: rail-api/rail-util-rf-path-switch
provides:
- name: sl_rail_util_rf_path_switch
- name: rail_util_rf_path_switch
requires:
- name: device
- name: rail_lib
- name: hal_generic_common
- name: emlib_gpio
  condition:
  - device_series_2
- name: emlib_cmu
  condition:
  - device_series_2
- name: emlib_prs
  condition:
  - device_series_2
- name: component_catalog
config_file:
- path: plugin/sl_rail_util_rf_path_switch/config/efr32xg28/sl_rail_util_rf_path_switch_config.h
  file_id: rail_util_rf_path_switch_config
  condition:
  - device_sdid_235
- path: plugin/sl_rail_util_rf_path_switch/config/sl_rail_util_rf_path_switch_config.h
  file_id: rail_util_rf_path_switch_config
  condition:
  - device_series_2
  unless:
  - device_sdid_235
include:
- path: plugin/sl_rail_util_rf_path_switch
  file_list:
  - path: sl_rail_util_rf_path_switch.h
  condition:
  - device_series_2
source:
- path: plugin/sl_rail_util_rf_path_switch/sl_rail_util_rf_path_switch.c
  condition:
  - device_series_2
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: sl_rail_util_rf_path_switch.h
    handler: sl_rail_util_rf_path_switch_init
  priority: 10000
  condition:
  - device_series_2
- name: component_catalog
  value: sl_rail_util_rf_path_switch
  condition:
  - device_series_2
- name: component_catalog
  value: rail_util_rf_path_switch
  condition:
  - device_series_2
root_path: rail_library
