id: micriumos_kernel_port_armv8m
label: Kernel port for ARMv8-M
package: micriumos
description: Micrium OS kernel port for ARMv8-M
category: RTOS|Micrium OS|Kernel
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
source:
- path: source/iar/armv8m_os_cpu_a.asm
  condition:
  - toolchain_iar
- path: source/iar/armv8m_os_cpu_c.c
  condition:
  - toolchain_iar
- path: source/gnu/armv8m_os_cpu_a.S
  condition:
  - toolchain_gcc
- path: source/gnu/armv8m_os_cpu_c.c
  condition:
  - toolchain_gcc
include:
- path: source
  file_list:
    # iar
  - path: iar/armv8m_os_cpu.h
    condition:
    - toolchain_iar
    # gcc
  - path: gnu/armv8m_os_cpu.h
    condition:
    - toolchain_gcc
provides:
- name: kernel_port_armv8m
- name: kernel_port
  condition: [cortexm33]
- name: kernel_port
  condition: [cortexm55]
requires:
- name: kernel_port_generic
- name: component_catalog
root_path: micriumos/platform/micrium_os/ports
