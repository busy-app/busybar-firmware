id: micriumos_cpu_port_armv6m
label: CPU port for ARMv6-M
package: micriumos
description: Micrium OS CPU port for ARMv6-M
category: RTOS|Micrium OS|Common
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
include:
- path: source
  file_list:
    # armcc
  - path: armcc/armv6m_cpu_port.h
    condition:
    - toolchain_arm
  - path: armcc/armv6m_os_cpu.h
    condition:
    - toolchain_arm
    # gcc
  - path: gnu/armv6m_cpu_port.h
    condition:
    - toolchain_gcc
  - path: gnu/armv6m_os_cpu.h
    condition:
    - toolchain_gcc
    # iar
  - path: iar/armv6m_cpu_port.h
    condition:
    - toolchain_iar
  - path: iar/armv6m_os_cpu.h
    condition:
    - toolchain_iar
provides:
- name: cpu_port_armv6m
- name: cpu_port
root_path: micriumos/platform/micrium_os/ports
