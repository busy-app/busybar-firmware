id: micriumos_cpu_port_armv7m
label: CPU port for ARMv7-M
package: micriumos
description: Micrium OS CPU port for ARMv7-M
category: RTOS|Micrium OS|Common
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
source:
# iar
- path: source/iar/armv7m_cpu_a.asm
  condition:
  - toolchain_iar
# armcc
- path: source/armcc/armv7m_cpu_a.asm
  condition:
  - toolchain_arm
# gcc
- path: source/gnu/armv7m_cpu_a.S
  condition:
  - toolchain_gcc
include:
- path: source
  file_list:
    # armcc
  - path: armcc/armv7m_cpu_port.h
    condition:
    - toolchain_arm
  - path: armcc/armv7m_os_cpu.h
    condition:
    - toolchain_arm
    # gcc
  - path: gnu/armv7m_cpu_port.h
    condition:
    - toolchain_gcc
  - path: gnu/armv7m_os_cpu.h
    condition:
    - toolchain_gcc
    # iar
  - path: iar/armv7m_cpu_port.h
    condition:
    - toolchain_iar
  - path: iar/armv7m_os_cpu.h
    condition:
    - toolchain_iar
provides:
- name: cpu_port_armv7m
- name: cpu_port
root_path: micriumos/platform/micrium_os/ports
