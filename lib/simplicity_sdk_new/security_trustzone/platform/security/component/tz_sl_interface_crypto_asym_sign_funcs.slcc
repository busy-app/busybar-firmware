id: tz_sl_interface_crypto_asym_sign_funcs
package: security_trustzone
description: >-
  This component provides a TrustZone secure library interface crypto asym sign functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_asym_sign_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value: tfm_crypto_sign_message

- name: tfm_interface_func
  value: tfm_crypto_verify_message

- name: tfm_interface_func
  value: tfm_crypto_sign_hash

- name: tfm_interface_func
  value: tfm_crypto_verify_hash

- name: tfm_interface_func
  value: tfm_crypto_asymmetric_encrypt

- name: tfm_interface_func
  value: tfm_crypto_asymmetric_decrypt


metadata:
  sbom:
    license: Zlib
root_path: security_trustzone
