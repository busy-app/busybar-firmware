id: tz_common
package: security_trustzone
category: Platform|Security|TrustZone
description: >-
  This component provides includes files and functionality common for TZ Secure and NonSecure applications.
ui_hints:
  visibility: never
quality: production
provides:
- name: tz_common

requires:
- name: tz_util

include:
- path: sl_component/sl_trustzone/inc/common
  file_list:
  - path: sli_tz_iovec.h
  - path: sli_tz_s_interface.h

metadata:
  sbom:
    license: Zlib
root_path: security_trustzone/platform/security
