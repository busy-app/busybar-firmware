id: tz_sl_interface_crypto_rng_funcs
package: security_trustzone
description: >-
  This component provides a TrustZone secure library interface crypto rng functions
category: Platform|Security|TrustZone
quality: production
ui_hints:
  visibility: never
provides:
- name: tz_sl_interface_crypto_rng_funcs
requires:
- name: trustzone_nonsecure
template_contribution:
- name: tfm_interface_func
  value: tfm_crypto_generate_random

- name: tfm_interface_func
  value: tfm_crypto_generate_key

- name: tfm_interface_func
  value: tfm_crypto_generate_key_custom

- name: tfm_interface_func
  value: tfm_crypto_generate_key_ext

metadata:
  sbom:
    license: Zlib
root_path: security_trustzone
