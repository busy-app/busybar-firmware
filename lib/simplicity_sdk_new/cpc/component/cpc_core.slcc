id: cpc_core
label: CPC Core
package: cpc
description: Co-Processor Communication (CPC) Core
category: Services|Co-Processor Communication
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
source:
- path: src/sl_cpc.c
- path: src/sl_cpc_hdlc.c
- path: src/sl_cpc_crc.c
- path: src/sl_cpc_instance.c
- path: src/sl_cpc_memory.c
- path: src/sl_cpc_dispatcher.c
- path: src/sli_cpc_assert.c
include:
- path: inc
  file_list:
  - path: sl_cpc.h
  - path: sl_cpc_weak_prototypes.h
  - path: sli_cpc.h
  - path: sli_cpc_assert.h
  - path: sli_cpc_types.h
  - path: sli_cpc_system_common.h
  - path: sli_cpc_drv.h
  - path: sli_cpc_hdlc.h
  - path: sli_cpc_crc.h
  - path: sli_cpc_debug.h
  - path: sli_cpc_instance.h
  - path: sli_cpc_memory.h
  - path: sli_cpc_trace.h
provides:
- name: cpc_core
- name: cpc_core_v1
requires:
- name: mem_pool
  condition: [device_si91x]
- name: memory_manager
  condition: [device_efx]
- name: cpc_timer_interface
- name: sleeptimer
- name: status
- name: slist
- name: component_catalog
- name: cmsis_core
- name: sl_assert
- name: sl_common
documentation:
  docset: gecko-platform
  document: platform-cpc/cpc
template_contribution:
- name: component_catalog
  value: cpc
- name: event_handler
  value:
    event: service_init
    include: sl_cpc.h
    handler: sl_cpc_init
  priority: -1
- name: event_handler
  value:
    event: service_process_action
    include: sl_cpc.h
    handler: sl_cpc_process_action
- name: event_handler
  condition: [sl_main]
  value:
    event: service_permanent_allocation
    include: sl_cpc.h
    handler: sl_cpc_init_permanent_allocations
  priority: 1
- name: power_manager_handler
  value:
    event: is_ok_to_sleep
    include: sl_cpc.h
    handler: sl_cpc_is_ok_to_sleep
- name: power_manager_handler
  value:
    event: sleep_on_isr_exit
    include: sl_cpc.h
    handler: sl_cpc_sleep_on_isr_exit
root_path: cpc
