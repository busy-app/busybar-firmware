id: bootloader_aes_sha_ecdsa_s3
label: Crypto
package: bootloader
description: >
  The Crypto component provides crypto operations for bootloader for Series 3
category: Platform|Bootloader|Utils
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/series3/security/btl_security_aes.c
- path: platform/bootloader/series3/security/btl_security_sha256.c
- path: platform/bootloader/series3/security/btl_security_ecdsa.c
include:
- path: platform/bootloader/series3
  file_list:
  - path: security/btl_security_aes.h
  - path: security/btl_security_ecdsa.h
  - path: security/btl_security_sha256.h
  - path: security/btl_security_types.h
requires:
- name: se_manager
provides:
- name: bootloader_aes_sha_ecdsa_common
  condition: [device_series_3]
- name: bootloader_aes_sha_ecdsa_s3
metadata:
  sbom:
    license: MSLA AND APACHE-2.0
root_path: bootloader
