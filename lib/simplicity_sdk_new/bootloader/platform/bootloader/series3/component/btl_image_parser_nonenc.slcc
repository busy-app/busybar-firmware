id: btl_image_parser_nonenc
label: >
  Image Parser without encryption support (Series-3)
package: bootloader
description: >
  The Image parser without encryption component provides an image parser that doesn't parse encrypted GBL files.
category: Platform|Bootloader|Core
quality: production
source:
- path: platform/bootloader/series3/core/btl_bootload.c
- path: platform/bootloader/series3/parser/gbl/btl_gbl_custom_tags.c
- path: platform/bootloader/series3/parser/gbl/btl_gbl_parser.c
define:
- name: BTL_PARSER_NO_SUPPORT_ENCRYPTION
  value: 1
provides:
- name: btl_image_parser_nonenc
requires:
- name: bootloader_aes_sha_ecdsa
- name: btl_include_parser
metadata:
  sbom:
    license: MSLA
root_path: bootloader
