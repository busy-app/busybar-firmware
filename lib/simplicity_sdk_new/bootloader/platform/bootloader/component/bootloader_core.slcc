id: bootloader_core
label: Bootloader Core
package: bootloader
description: >
  The Bootloader Core component provides a core library for the Gecko bootloader, It provides the core
  functions such as bootloader initialization and de-initialization, setting a reset reason, reset methods,
  initialization of the image parser, and others.
category: Platform|Bootloader|Core
quality: production
source:
- path: platform/bootloader/driver/btl_driver_util.c
- path: platform/bootloader/core/btl_bootload.c
- path: platform/bootloader/core/btl_core.c
- path: platform/bootloader/core/btl_main.c
- path: platform/bootloader/core/flash/btl_internal_flash.c
- path: platform/bootloader/core/btl_parse.c
- path: platform/bootloader/core/btl_reset.c
define:
- name: BOOTLOADER_ENABLE
  value: 1
- name: SL_RAMFUNC_DISABLE
  value: 1
- name: __START
  value: main
- name: __STARTUP_CLEAR_BSS
  value: 1
- name: BOOTLOADER_SECOND_STAGE
  value: 1

include:
- path: platform/bootloader
  file_list:
  - path: api/btl_interface.h
  - path: config/btl_config.h
  - path: core/btl_core.h
  - path: core/btl_helper.h
  - path: core/btl_reset.h
  - path: core/btl_parse.h
  - path: core/btl_bootload.h
  - path: core/btl_upgrade.h
  - path: core/btl_util.h
  - path: driver/btl_driver_util.h
  - path: core/flash/btl_internal_flash.h

provides:
- name: bootloader_core

requires:
- name: emlib
- name: se_manager_mailbox
- name: trustzone_secure
  condition: [bootloader_ezsp_spi]
- name: trustzone_secure
  condition: [bootloader_internal_storage]
- name: trustzone_secure
  condition: [bootloader_spiflash_storage]
- name: trustzone_secure
  condition: [bootloader_bgapi_uartdfu]
- name: trustzone_secure
  condition: [bootloader_uart_xmodem]
- name: trustzone_secure
  condition: [bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg25, bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg26, bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg26, bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg28, bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg28, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_family_efm32pg28, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg29, bootloader_spiflash_storage_sfdp]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_ezsp_spi]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_internal_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_spiflash_storage]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_bgapi_uartdfu]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_uart_xmodem]
- name: bootloader_tz_secure_config
  condition: [device_generic_family_efr32xg2d, bootloader_spiflash_storage_sfdp]
- name: sl_fault_injection_hardening
- name: bootloader_aes_ctr_stream_block_cfg
  condition: [device_has_semailbox]
recommends:
- id: bootloader_include_parser
  vendor: silabs
- id: bootloader_uart_xmodem
  vendor: silabs
- id: bootloader_xmodem_parser
  vendor: silabs
- id: bootloader_bgapi_uartdfu
  vendor: silabs
- id: bootloader_delay_driver
  vendor: silabs
- id: bootloader_ezsp_spi
  vendor: silabs
- id: bootloader_debug
  vendor: silabs
- id: bootloader_image_parser
  vendor: silabs
- id: bootloader_spi_peripheral_driver
  vendor: silabs
- id: bootloader_crc
  vendor: silabs
- id: bootloader_serial_driver

  vendor: silabs
config_file:
- path: platform/bootloader/config/device_series_2/btl_core_cfg.h
  file_id: btl_core_config
  unless:
  - device_sdid_205
  - bootloader_tz_secure
  - bootloader_apploader
- path: platform/bootloader/config/device_sdid_205/btl_core_cfg.h
  file_id: btl_core_config
  condition:
  - device_sdid_205
  unless:
  - bootloader_tz_secure
  - bootloader_apploader
- path: platform/bootloader/config/device_series_2/btl_core_s_cfg.h
  file_id: btl_core_config
  condition:
  - bootloader_tz_secure
  unless:
  - device_sdid_205
  - bootloader_apploader
- path: platform/bootloader/config/device_sdid_205/btl_core_s_cfg.h
  file_id: btl_core_config
  condition:
  - device_sdid_205
  - bootloader_tz_secure
  unless:
  - bootloader_apploader

- path: platform/bootloader/config/device_sdid_205/apploader/btl_core_cfg.h
  file_id: btl_core_config
  condition:
  - device_sdid_205
  - bootloader_apploader
- path: platform/bootloader/config/device_series_2/apploader/btl_core_cfg.h
  file_id: btl_core_config
  condition:
  - bootloader_apploader
  unless:
  - device_sdid_205

template_contribution:
- name: bootloader_enable
  value: 1
- name: app_rollback_protection_size
  value: 0x20
- name: bootloader_flash_addr
  value: 0x0
  condition:
  - device_sdid_200
- name: bootloader_main_size
  value: 0x4000
  condition:
  - device_sdid_200
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x0
  condition:
  - device_sdid_205
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_205
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_210
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_210
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_215
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_215
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_220
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_220
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_225
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_225
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_230
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_230
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_235
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_235
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_240
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_240
  unless:
  - bootloader_apploader
- name: bootloader_flash_addr
  value: 0x8000000
  condition:
  - device_sdid_260
- name: bootloader_main_size
  value: 0x6000
  condition:
  - device_sdid_260
  unless:
  - bootloader_apploader
- name: bootloader_main_size
  value: 0x12000
  condition:
  - bootloader_apploader
validation_helper:
- path: platform/bootloader/component/scripts/bootloader_core_validation.lua

toolchain_settings:
- option: optimize
  value: size
metadata:
  sbom:
    license: MSLA
root_path: bootloader
