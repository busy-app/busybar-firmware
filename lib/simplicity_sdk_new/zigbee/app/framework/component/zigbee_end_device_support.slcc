package: zigbee
description: Silicon Labs implementation of polling for end devices.  Note that the Poll Control Server component sets the long and short poll intervals at startup.  If both components are enabled, the long and short poll intervals set here will not be used.
label: End Device Support
quality: production
id: zigbee_end_device_support
category: Zigbee|Utility
provides:
- name: zigbee_end_device_support
config_file:
- path: app/framework/plugin/end-device-support/config/end-device-support-config.h
source:
- path: app/framework/plugin/end-device-support/end-device-support.c
- path: app/framework/plugin/end-device-support/end-device-move.c
- path: app/framework/plugin/end-device-support/end-device-support-cli.c
  condition:
  - cli
- path: app/framework/plugin/end-device-support/polling-common.c
- path: app/framework/plugin/end-device-support/polling-host.c
  condition:
  - zigbee_ezsp
- path: app/framework/plugin/end-device-support/polling-soc.c
  condition:
  - zigbee_stack_common
- path: app/framework/plugin/end-device-support/end-device-support-cb.c
include:
- path: app/framework/plugin/end-device-support
  file_list:
  - path: end-device-support.h
  - path: end-device-move.h
template_contribution:
- name: component_catalog
  value: zigbee_end_device_support
- name: zigbee_af_callback
  value:
    callback_type: event_init
    function_name: sli_zigbee_af_end_device_support_move_init
- name: zigbee_af_callback
  value:
    callback_type: event_init
    function_name: sli_zigbee_af_end_device_support_polling_init
  unless:
  - zigbee_ezsp
- name: zigbee_af_callback
  value:
    callback_type: local_data_init
    function_name: sl_zigbee_af_end_device_support_init_cb
- name: zigbee_af_callback
  value:
    callback_type: tick
    function_name: sl_zigbee_af_end_device_support_tick_cb
- name: zigbee_stack_callback
  value:
    callback_type: stack_status
    function_name: sl_zigbee_af_end_device_support_stack_status_cb
- name: zigbee_stack_callback
  value:
    callback_type: poll_complete
    function_name: sli_zigbee_af_end_device_support_poll_complete_callback
- name: cli_group
  value:
    group: plugin
    name: end-device-support
    help: end-device-support related commands.
- name: cli_command
  value:
    group: end-device-support
    name: status
    handler: sl_zigbee_af_end_device_support_status_command
    help: Displays the status of the End Devices polling.
- name: cli_command
  value:
    group: end-device-support
    name: poll-completed-callback
    handler: sl_zigbee_af_end_device_support_poll_completed_callback_command
    help: Sets whether the devices poll completed callback function is enabled.
    argument:
    - type: int8
      help: The value indicating whether the devices poll completed callback function is enabled
- name: cli_command
  value:
    group: end-device-support
    name: force-short-poll
    handler: sl_zigbee_af_end_device_support_force_short_poll_command
    help: Sets whether the CLI forces the device to short poll.
    argument:
    - type: int8
      help: The value indicating whether the device should short poll

documentation:
  docset: zigbee
  document: zigbee-af-api/end-device-support
metadata:
  sbom:
    license: MSLA
root_path: zigbee
