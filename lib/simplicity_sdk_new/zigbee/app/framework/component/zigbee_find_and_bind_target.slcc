package: zigbee
description: This component provides the functionality for a target device to start identifying on user-defined endpoints. The target device can then act as a target for a finding and binding initiator.
label: Find and Bind Target
quality: production
id: zigbee_find_and_bind_target
category: Zigbee|Zigbee 3.0
provides:
- name: zigbee_find_and_bind_target
config_file:
- path: app/framework/plugin/find-and-bind-target/config/find-and-bind-target-config.h
source:
- path: app/framework/plugin/find-and-bind-target/find-and-bind-target.c
- path: app/framework/plugin/find-and-bind-target/find-and-bind-target-cli.c
  condition:
  - cli
include:
- path: app/framework/plugin/find-and-bind-target
  file_list:
  - path: find-and-bind-target.h
template_contribution:
- name: component_catalog
  value: zigbee_find_and_bind_target
- name: cli_group
  value:
    name: find-and-bind
    group: plugin
    help: Find and bind related commands.
- name: cli_command
  value:
    name: target
    group: find-and-bind
    handler: sl_zigbee_af_find_and_bind_target_start_command
    help: Makes this node start identifying as a target for binding with an initiator node.
    argument:
    - type: uint8
      help: The endpoint on which to begin the Finding and Binding target process

documentation:
  docset: zigbee
  document: zigbee-af-api/find-and-bind-target
metadata:
  sbom:
    license: MSLA
root_path: zigbee
