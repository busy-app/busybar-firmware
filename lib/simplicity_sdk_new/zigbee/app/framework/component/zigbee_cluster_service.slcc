id: zigbee_cluster_service
label: Zigbee Cluster Service
package: zigbee
category: Zigbee|Utility
quality: production
description: This component is used to enable the cluster service mechanism.
provides:
- name: zigbee_cluster_service

include:
- path: app/framework/service-function
  file_list:
  - path: sl_service_function.h

source:
- path: app/framework/service-function/sl_service_function.c

template_file:
- path: app/framework/service-function/template/sl_cluster_service_gen.c.jinja
- path: app/framework/service-function/template/sl_cluster_service_gen.h.jinja
metadata:
  sbom:
    license: MSLA
root_path: zigbee
