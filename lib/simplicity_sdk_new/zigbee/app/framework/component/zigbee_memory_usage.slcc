id: zigbee_memory_usage
label: Memory Usage
package: zigbee
category: Zigbee|Utility
quality: evaluation
description: Provides memory usage CLI commands for accessing flash and ram usage metrics on apps.
provides:
- name: zigbee_memory_usage
requires:
- name: memory_usage_api
  condition: [zigbee_stack_common]
- name: zigbee_memory_usage_cli
  condition: [zigbee_zcl_framework_core]
include:
- path: stack/internal/inc
  file_list:
  - path: sl_zigbee_memory_usage_internal_def.h
- path: stack/internal/src/ipc
  file_list:
  - path: sl_zigbee_memory_usage_ipc_command_messages.h
    condition:
    - zigbee_use_ipc
source:
- path: stack/debug/sl_zigbee_memory_usage.c
  unless: [native_host]
- path: util/plugin/plugin-common/generic-memory-usage/memory_usage.c
  unless: [native_host, zigbee_stack_common]   #do not duplicate this file
- path: stack/internal/src/stubs/sl_zigbee_memory_usage_internal_weak_stubs.c
- path: stack/internal/src/baremetal/sl_zigbee_memory_usage_baremetal_wrapper.c
  unless: [zigbee_use_ipc]
- path: stack/internal/src/ipc/sl_zigbee_memory_usage_ipc_command_messages.c
  condition: [zigbee_use_ipc]
template_contribution:
- name: component_catalog
  value: zigbee_memory_usage
metadata:
  sbom:
    license: MSLA
root_path: zigbee
