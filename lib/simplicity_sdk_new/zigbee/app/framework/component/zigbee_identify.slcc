package: zigbee
description: Silicon Labs implementation of Identify cluster.  It requires extending in order to integrate the code with the hardware, for example to make a light blink during identify.
id: zigbee_identify
label: Identify Cluster
category: Zigbee|Cluster Library|Common
quality: evaluation
provides:
- name: zigbee_identify
source:
- path: app/framework/plugin/identify/identify.c
- path: app/framework/plugin/identify/identify-cli.c
  condition:
  - cli
- path: app/framework/plugin/identify/identify-cb.c
include:
- path: app/framework/plugin/identify
  file_list:
  - path: identify.h
template_contribution:
- name: component_catalog
  value: zigbee_identify
- name: cluster_functions
  value:
    cluster_name: Identify
    cluster_id: 0x0003
    cluster_type: server
    init_function: sl_zigbee_af_identify_cluster_server_init_cb
- name: cluster_functions
  value:
    cluster_name: Identify
    cluster_id: 0x0003
    cluster_type: server
    attribute_changed_function: sl_zigbee_af_identify_cluster_server_attribute_changed_cb
- name: cli_group
  value:
    group: plugin
    name: identify
    help: identify related commands
- name: cli_command
  value:
    group: identify
    name: print
    handler: sli_zigbee_af_identify_cli_print
    help: Print which endpoints are reporting.
- name: cluster_service
  value:
    cluster_id: '0x0003'
    mfg_id: NOT_MFG_SPECIFIC
    side: SERVER
    service_function: sl_zigbee_af_identify_cluster_server_command_parse
documentation:
  docset: zigbee
  document: zigbee-af-api/identify
metadata:
  sbom:
    license: MSLA
root_path: zigbee
