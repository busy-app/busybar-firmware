  value:
    name: set_profile
    handler: setProfileIdCommand
    help: Set the profile ID for initiated Test Profile messages.
    argument:
    - type: uint16
- name: cli_command
  value:
    name: set_radius
    handler: setRadiusCommand
    help: Sets default broadcast radius
    argument:
    - type: uint8
- name: cli_command
  value:
    name: set_route_record_policy
    handler: routeRecordPolicyCommand
    help: Set the route record policy
    argument:
    - type: uint8
- name: cli_command
  value:
    name: set_security
    handler: setSecurityCommand
    help: Set the security parameters
    argument:
    - type: uint32
      help: security settings bitmask (see sl_zigbee_initial_security_bitmask_t)
    - type: hex
      help: preconfigured key setting
    - type: hex
      help: network key setting
    - type: uint8
      help: network sequence number
- name: cli_command
  value:
    name: show_src_routes
    handler: showSourceRouteTableCommand
    help: Show the source routing table
  condition:
  - zigbee_multi_network
- name: cli_command
  value:
    name: simple_desc
    handler: sendSimpleRequestCommand
    help: Send a ZDO simple descriptor request
    argument:
    - type: uint16
    - type: uint8
- name: cli_command
  value:
    name: sleep_ok
    handler: sleepOkCommand
    help: Prints the bitmask indicating whether local device is allowed to sleep
  condition:
  - zigbee_simulation
- name: cli_command
  value:
    name: slpd
    handler: sendLPD
    help: send link power delta
    argument:
    - type: uint8
    - type: uint16
    - type: uint8
  condition:
  - phy_dual
- name: cli_command
  value:
    name: send_malformed_lpd
    handler: sendMalformedLPD
    help: send malformed link power delta
    argument:
    - type: uint16
  condition:
  - phy_dual
- name: cli_command
  value:
    name: sniff
    handler: sniffCommand
    help: Turn on/off Sniffing (no address matching)
    argument:
    - type: uint8
- name: cli_command
  value:
    name: spoofed_broadcast_msg_buffer
    handler: spoofedBroadcastMsgCommand
    help: spoofed broadcast
    argument:
    - type: uint8
    - type: uint16
    - type: uint8
    - type: uint16
    - type: uint8
    - type: uint16
    - type: uint8
- name: cli_command
  value:
    name: stack_status
    handler: printStackStatusCommand
    help: Prints the current stack status
- name: cli_command
  value:
    name: state
    handler: stateCommand
    help: Print the node's current state
- name: cli_command
  value:
    name: stats
    handler: statsCommand
    help: Print debug stats
- name: cli_command
  value:
    name: status
    handler: statusCommandZCP
    help: Print the node's current status
- name: cli_command
  value:
    name: tc_policy
    handler: setTrustCenterPolicyCommand
    help: Set Trust Center Join Policy
    argument:
    - type: uint8
- name: cli_command
  value:
    name: token_writing
    handler: tokenWritingCommand
    help: Turns on/off writing of NWK parameters to tokens
    argument:
    - type: uint8
- name: cli_command
  value:
    name: tx_non_encr_update_device
    handler: sendOnlyNonEncryptedUpdateDeviceCommand
    help: Enables/disables the sending of non-encrypted update device commands only
    argument:
    - type: uint8
- name: cli_command
  value:
    name: update_link_key
    handler: updateLinkKey
    help: Update the link key after joining
- name: cli_command
  value:
    name: use_legacy_timeout_method
    handler: useLegacyEndDeviceTimeoutMethod
    help: Use legacy timeout method i.e. end device does not send network/keepalive timeout request
    argument:
    - type: uint8
- name: cli_command
  value:
    name: use_negotiated_power
    handler: makeUseofNegotiatedPower
    help: Sets the flag to use either negotiated power by link power delta or fixed power value provided by user while forming/joining a network for packet transmissions on subghz interface.
    argument:
    - type: uint8
  condition:
  - phy_dual
- name: cli_command
  value:
    name: version
    handler: versionCommandZCP
    help: Displays the running software version
  unless:
  - zigbee_core_cli
- name: cli_command
  value:
    name: zdo_leave_req
    handler: sendZdoLeaveRequest
    help: Send a ZDO leave request
    argument:
    - type: uint16
      help: target short id
    - type: hex
      help: target long id
    - type: uint8
      help: leave request flags
    - type: uint16
      help: aps send options
- name: cli_command
  value:
    name: zdo_mgmt_lqi
    handler: zdoMgmtLqiCommandZCP
    help: Send a ZDO MGMT-LQI Request
    argument:
    - type: uint16
      help: target short id
    - type: uint8
      help: lqi table index
- name: cli_command
  value:
    name: zdo_request
    handler: zdoRequestCommand
    help: Send arbitrary ZDO request command
    argument:
    - type: uint16
      help: request cluster id
    - type: uint16
      help: target device short id
    - type: hexopt
      help: optional payload bytes
- name: cli_command
  value:
    name: zleave
    handler: zigbeeLeaveCommand
    help: Tell specified node to leave network
    argument:
    - type: uint8

  # Commands for Crypto
- name: cli_group
  value:
    name: crypto
    help: Crypto related commands
- name: cli_command
  value:
    name: enable
    group: crypto
    handler: enableCryptoTimingCommand
    help: Enables crypto timing
    argument:
    - type: uint8
- name: cli_command
  value:
    name: print-rx
    group: crypto
    handler: printCryptoTimingCommand
    help: Prints the recorded crypto timing results for RX packets
- name: cli_command
  value:
    name: print-tx
    group: crypto
    handler: printCryptoTimingCommand
    help: Prints the recorded crypto timing results for TX packets
- name: cli_command
  value:
    name: reset
    group: crypto
    handler: resetCryptoTimingCommand
    help: Resets the crypto timing results
- name: cli_command
  value:
    name: alias_send
    handler: sendAliasMsg
    help: Sends multicast frame to groupid 0xFABE with alias nwk address. argument 1 is sequence number, argument 2 is alias address
    argument:
    - type: uint8
    - type: uint16
- name: cli_command
  value:
    name: factory
    handler: factoryResetCommand
    help: Performs a factory reset
- name: cli_command
  value:
    name: set_tx_power
    handler: set_tx_power
    help: Set absolute Tx power
    argument:
    - type: int8
      help: absolute tx power
- name: cli_command
  value:
    name: set_relative_tx_power
    handler: set_relative_tx_power
    help: Set relative Tx power
    argument:
    - type: int8
      help: relative tx power
- name: cli_command
  value:
    name: set_nwk_retries
    handler: setNwkRetriesCommand
    help: the maximum number of additional nwk retries
    argument:
    - type: uint8
      help: the number of times a message will be retried at the network layer
- name: cli_command
  value:
    name: set_data_poll_additional_retries
    handler: setDataPollAdditionalRetries
    help: the maximum number of additional data poll retries
    argument:
    - type: uint8
      help: number of times a data poll will be retried
- name: cli_command
  value:
    name: set_child_table_size
    handler: setChildTableSize
    help: Sets child table size
    argument:
    - type: uint8
      help: sets child table size
  condition:
  - zigbee_pro_stack
- name: cli_command
  value:
    name: send_aps_ack
    handler: sendApsAckCommand
    help: send an aps ack manually
    argument:
    - type: uint16
      help: profile Id
    - type: uint16
      help: cluster Id
    - type: uint8
      help: source endpoint
    - type: uint8
      help: destination endpoint
    - type: uint8
      help: aps option
    - type: uint16
      help: destination
    - type: uint8opt
      help: sequence number
- name: cli_command
  value:
    name: switch_context
    handler: switchContextHandler
    help: switch context between ZCP and BDB.
    argument:
    - type: uint8
      help: 1 for ZCP, and 0 for BDB
  condition:
  - zigbee_system_common_app_framework
- name: cli_command
  value:
    name: use_forced_association
    handler: setForceAssociationHandler
    help: Always use 802.15.4 MAC Association Requests when joining, even if the device being joined to supports Zigbee Network Commissioning.
  condition:
  - zigbee_system_common_app_framework
- name: cli_command
  value:
    name: ignore_aps_ack_req
    handler: ignoreApsAckReqCommand
    help: Disable requesting APS ACKs in outgoing frames
    argument:
    - type: uint8
      help: 1 - disable APS acknowledgement in outgoing frames, 0 - use default from higher layer
  # END Pro-compliance CLI Commands
metadata:
  sbom:
    license: MSLA
root_path: zigbee
