package: zigbee
description: This component brings in the necessary items to build a Zigbee Pro Compliance image. The Zigbee Pro Compliance image is a binary that is used to test and certify the networking stack.

label: Compliance
quality: evaluation
id: zigbee_pro_compliance
category: Zigbee|Compliance

provides:
- name: zigbee_pro_compliance

requires:
- name: zigbee_pro_stack_support
- name: zigbee_enhanced_routing
- name: zigbee_cli
- name: zigbee_device_config
- name: zigbee_fragmentation
- name: zigbee_security_link_keys
  # Adding following conditions to avoid having multiple pro-compliance.slcps for
  # dualrail and railgb phys flavors. Following are the boards we use for
  # R22 certifications for respective phy flavors.
- name: zigbee_phy_2_4_subghz_switch_coordinator
  condition:
  - brd4197a

define:
- name: CONFIGURATION_HEADER
  value: "\"app/test/pro-compliance-configuration.h\""
- name: PRO_COMPLIANCE
- name: MAC_TEST_COMMANDS_SUPPORT
- name: SL_ZIGBEE_GOLDEN_UNIT

source:
  #- path: "app/util/serial/sl_zigbee_command_interpreter.c"
- path: app/util/common/common.c
- path: app/util/common/common-onboard.c
- path: app/util/common/internal-common-simulation.c
  condition:
  - zigbee_simulation
- path: app/util/common/library.c
  # END App2

  # START APP:PRO_COMPLIANCE
- path: app/test/test-profile.c
- path: app/test/security-common.c
- path: app/test/zdo-common.c
- path: app/test/groups-common.c
- path: app/test/misc-common.c
- path: app/test/pro-compliance.c
- path: app/test/pro-compliance-stack-context.c
- path: app/test/security-onboard.c
- path: app/test/groups-onboard.c
- path: app/test/test-profile-onboard.c
- path: app/test/misc-onboard.c
- path: app/test/multicast-utility.c
- path: app/test/pro-compliance-common.c
- path: app/test/pro-compliance-printing.c
  # END APP:PRO_COMPLIANCE

  # START APP_UTIL:COMMON_INTERNAL
- path: app/util/common/internal-common.c
- path: app/util/zigbee-framework/zigbee-device-common.c
- path: app/util/zigbee-framework/zigbee-device-library.c
  # END APP_UTIL:COMMON_INTERNAL

   # START APP_UTIL:COUNTERS_CLI
- path: app/util/counters/counters-cli.c
  condition:
  - cli
  # END APP_UTIL:COUNTERS_CLI

  # START APP_UTIL:COUNTERS_OTA
- path: app/util/counters/counters-ota.c
  # END APP_UTIL:COUNTERS_OTA

  # START PLUGIN:STACK_PROTECTION_IAR
  # TODO: figure out how to conditionally add stack-protection.c if and only if
  # STACK_PROTECTION is supplied to the build command. My current understanding
  # is that you do not supply macros to uc, but need to confirm. For now, do not
  # add stack protection
  #- path: "util/plugin/plugin-common/stack-protection-iar/stack-protection.c"
  # END PLUGIN:STACK_PROTECTION_IAR
- path: stack/internal/src/baremetal/pro_compliance_stack_interface_baremetal_wrapper.c
  unless:
  - zigbee_use_ipc
- path: stack/internal/src/ipc/pro_compliance_stack_interface_ipc_command_messages.c
  condition:
  - zigbee_use_ipc
include:
#Include zigbee_internal package base to resolve some header includes
- path: .
- path: stack/include
  file_list:
  - path: pro_compliance_stack_interface.h
- path: stack/internal/inc
  file_list:
  - path: pro_compliance_stack_interface_internal_def.h
- path: stack/internal/src/ipc
  file_list:
  - path: pro_compliance_stack_interface_ipc_command_messages.h
    condition:
    - zigbee_use_ipc
  # NOTE putting these here to build pro compliance with 'copy sources'
  # platform headers
- path: platform/base/phy/plugin/duty-cycle
  file_list:
  - path: duty-cycle.h
- path: platform/service/token_manager/inc
  file_list:
  - path: sl_token_manager_defines.h
  - path: sl_token_manager_api.h
- path: platform/service/token_manager/legacy/inc
  file_list:
  - path: sl_token_manufacturing_generic.h
  # stack headers
- path: stack/core
  file_list:
  - path: sl_zigbee_stack.h
  - path: sl_zigbee_multi_phy.h
  - path: sli_zigbee_tlv_core.h
- path: stack/config
  file_list:
  - path: token-cache.h
- path: stack/framework
  file_list:
  - path: slx_zigbee_insecure_debug_key_trace.h
  - path: packet-header.h
  - path: zigbee-packet-header.h
  - path: debug.h
  - path: debug-message-type-gen.h
  - path: debug-gen.h
  - path: sli_zigbee_dynamic_commissioning.h
  - path: eui64.h
  - path: zigbee_debug_stack_on_host.h
- path: stack/zigbee
  file_list:
  - path: aps-keys.h
  - path: aps-retry.h
  - path: aps-security-policy.h
  - path: sli_zigbee_zdo_security.h
  - path: aps-security.h
  - path: zigbee-device.h
  - path: trust-center-util.h
  - path: stack-address-table.h
  - path: aps-retry.h
  - path: zigbee-dispatch.h
  - path: application-support.h
  - path: sli_zigbee_zdo_dlk_negotiation.h
  - path: zigbee-dispatch.h
  - path: application-support.h
- path: stack/routing/zigbee
  file_list:
  - path: zigbee.h
  - path: child-handling.h
  - path: association.h
  - path: network.h
  - path: beacon-handling.h
  - path: child.h
  - path: management.h
  - path: route-table.h
  - path: id-assign.h
  - path: route-error.h
  - path: sl_zigbee_beacon_tlvs.h
  - path: leave.h
  - path: enhanced-beacon-request.h
- path: stack/routing/neighbor
  file_list:
  - path: neighbor.h
- path: stack/routing/util
  file_list:
  - path: retry.h
  - path: broadcast.h
- path: stack/security
  file_list:
  - path: aps-frame-counter-sync.h
  - path: aps-keys-transient.h
  - path: packet-validate.h
  - path: security.h
  - path: crypto.h
  - path: sli_zigbee_dlk_negotiation.h
- path: stack/mac
  file_list:
  - path: mac-info-element-parsing.h
  - path: lower-mac-multi-phy.h
  - path: mac-dispatch.h
  - path: command.h
  - path: zigbee-upper-mac.h
  - path: mac.h
  # app headers
- path: app/test
  file_list:
  - path: pro-compliance.h
  - path: pro-compliance-configuration.h
  - path: pro-compliance-printing.h
  - path: pro-compliance-common.h
  - path: misc-common.h
  - path: groups-common.h
  - path: security-common.h
  - path: test-profile.h
  - path: zdo-common.h
  - path: multiprotocol-sim.h
  - path: mac-test-commands.h
- path: app/util/common
  file_list:
  - path: common.h
  - path: internal-common.h
  - path: library.h
- path: app/util/counters
  file_list:
  - path: counters-ota.h
  - path: counters-cli.h
- path: app/util/zigbee-framework
  file_list:
  - path: zigbee-device-library.h
  - path: zigbee-device-common.h

template_contribution:
- name: component_catalog
  value: zigbee_pro_compliance
- name: event_handler
  value:
    event: stack_init
    include: pro-compliance.h
    handler: pro_compliance_app_rtos_task_init
  priority: -8997
  condition:
  - cmsis_rtos2
  # START AF Callbacks
- name: zigbee_af_callback
  value:
    callback_type: event_init
    function_name: sli_zigbee_af_pro_compliance_init_callback
- name: zigbee_af_callback
  value:
    callback_type: init_done
    function_name: sli_zigbee_af_pro_compliance_init_callback
- name: zigbee_af_callback
  value:
    callback_type: tick
    function_name: beaconSuppressionTick
  # END AF Callbacks

  # START Pro-compliance CLI Commands
- name: cli_group
  value:
    name: plugin
    help: Plugin related commands.
- name: cli_command
  value:
    name: add_child
    handler: addChildCommand
    help: Add a child to the child table
    argument:
    - help: child short id
      type: uint16
    - help: child long id
      type: hex
    - help: enumerated 'node type' indicating ZC, ZR, ZED
      type: uint8
- name: cli_command
  value:
    name: add_endpoint
    handler: addEndpointToGroupCommand
    help: Add endpoint to the specified group
    argument:
    - type: uint8
      help: endpoint id
    - type: uint16
      help: group id
- name: cli_command
  value:
    name: add_route
    handler: addRouteCommand
    help: Add a route to the routing table
    argument:
    - help: destination node id
      type: uint16
    - help: next hop node id
      type: uint16
- name: cli_command
  value:
    name: add_transient_key
    handler: addTransientKeys
    help: Add a temporary TC Link Key for EUI
    argument:
    - help: partner eui64
      type: hex
    - help: 16-bytes of key data
      type: hex
- name: cli_group
  value:
    name: wildcard_za09
    help: commands related to joining with the 'well-known' link key
- name: cli_command
  value:
    group: wildcard_za09
    name: open
    help: adds the well-known key to a wildcard id to the transient link key table and keep it open
    handler: openWildcardZa09JoinWindow
- name: cli_command
  value:
    group: wildcard_za09
    name: close
    help: removes the wildcard za09 key from the transient key table
    handler: closeWildcardZa09JoinWindow
- name: cli_command
  value:
    name: addr_table
    handler: addressTableCommand
    help: Print the address table
- name: cli_command
  value:
    name: ae64p
    handler: ebrAddEuiandPower
    help: add eui64 and power in ebr list
    argument:
    - help: beacon eui64
      type: hex
    - help: beacon power
      type: int8
- name: cli_command
  value:
    name: allow_joining
    handler: allowJoiningCommand
    help: Use short address in the next association response.
    argument:
    - help: short address to use in response
      type: uint16
- name: cli_command
  value:
    name: app_key_timeout
    handler: applicationKeyTimeoutCommand
    help: Sets TC link key timeout
    argument:
    - help: timeout in minutes
      type: uint8
- name: cli_command
  value:
    name: associate
    handler: associateCommand
    help: Associate to provided parent, PAN ID. Capabilities are used based on node type.
    argument:
    - help: short id of parent node
      type: uint16
    - help: pan id to join
      type: uint16
- name: cli_command
  value:
    name: assume_tc_concentrator_type
    handler: assumeTcConcentratorTypeCommand
    help: To configure non TC node to assume a concentrator type until it receive MTORR. The stack defaults to assume TC be a low RAM.
    argument:
    - help: concentrator type enumeration (see sl_zigbee_assume_trust_center_concentrator_type_t)
      type: uint8
- name: cli_command
  value:
    name: broadcasts
    handler: broadcastTableCommand
    help: Print the broadcast table
- name: cli_command
  value:
    name: buffers
    handler: freeBuffersCommand
    help: Print number of free buffers
- name: cli_command
  value:
    name: ccathresh
    handler: ccaThresh
    help: set CCA threshold
    argument:
    - type: uint8
  condition:
  - phy_dual
- name: cli_command
  value:
    name: change_addr
    handler: changeAddressCommand
    help: Sends an unsolicited rejoin response to child from parent
    argument:
    - help: the 'old' short id of the child
      type: uint16
    - help: the 'new' short id for the child to use
      type: uint16
- name: cli_command
  value:
    name: set_network_security
    handler: setNetworkSecurity
    help: sets or clears network security
    argument:
    - help: boolean value for 'use_network_security'
      type: uint8
- name: cli_command
  value:
    name: change_pan
    handler: changePanCommand
    help: Sends a command to change PAN ID now
    argument:
    - help: new pan id
      type: uint16
- name: cli_command
  value:
    name: change_tx_mode
    handler: changeTxMode
    help: Change the mac TX mode between normal(0), request a grant(1), and complete hold off(2)
    argument:
    - type: uint8
- name: cli_command
  value:
    name: check_outgoing_fc
    handler: checkOutgoingFrameCounter
    help: Check that the value of the outgoing frame counter variable falls in a given (inclusive) range
    argument:
    - help: min expected fc
      type: uint32
    - help: max expected fc
      type: uint32
- name: cli_command
  value:
    name: children
    handler: childTableCommand
    help: Print the child table
- name: cli_command
  value:
    name: clear_groups
    handler: clearGroupsCommand
    help: Clear all groups
- name: cli_command
  value:
    name: clear_keys
    handler: clearKeysCommand
    help: Clear all entries in the key table
- name: cli_command
  value:
    name: clear_routes
    handler: clearRouteTableCommand
    help: Clear the routing table
- name: cli_command
  value:
    name: clear_src_routes
    handler: clearSourceTableCommand
    help: Clear the source routing table
- name: cli_command
  value:
    name: cnt_req
    handler: sendCountersRequestCommand
    help: Request stack counters from remote device
    argument:
    - help: target node id
      type: uint16
    - help: boolean 'clear counters'
      type: uint8
- name: cli_command
  value:
    name: commission
    handler: setCommissionParameters
    help: Set the commission parameters
    argument:
    - help: node type (router if 0, else coordinator)
      type: uint8
    - help: network manager id
      type: uint16
    - help: network update id
      type: uint8
    - help: channel mask (low, 0-15)
      type: uint16
    - help: channel mask (high, 16-31)
      type: uint16
    - help: preconfigured TC eui
      type: hex
- name: cli_command
  value:
    name: conc_act
    handler: concentratorActionCommand
    help: Execute a concentrator action
    argument:
    - type: uint8
      help: type of action (0 = turn on source route discovery, 1 = turn off source route discovery, 2 = reschedule source route discovery, 3 = note route failure, 4 = note delivery failure)
- name: cli_command
  value:
    name: dc
    handler: printDcStats
    help: print duty cycle stats
  condition:
  - phy_dual
- name: cli_command
  value:
    name: dctest
    handler: runDutyCycleTest
    help: Runs the duty cycle test
    argument:
    - help: time accel value
      type: uint16
  condition:
  - phy_dual
- name: cli_command
  value:
    name: del_endpoint
    handler: removeEndpointFromGroupCommand
    help: Delete an endpoint from specified group
    argument:
    - help: endpoint
      type: uint8
    - help: group id
      type: uint16
- name: cli_command
  value:
    name: del_route
    handler: deleteRouteCommand
    help: Delete or deactivate a route in the routing table
    argument:
    - type: uint16
- name: cli_command
  value:
    name: delay_polled_pkt_tx_ms
    handler: delayNextPolledPacketTransmit
    help: Add delay in milliseconds to transmit next polled packet to a sleepy device.
    argument:
    - type: uint8
- name: cli_command
  value:
    name: delete_key
    handler: deleteKeyCommand
    help: Delete an entry in the key table
    argument:
    - type: hex
- name: cli_command
  value:
    name: discoveries
    handler: discoveryTableCommand
    help: Print the discovery table
- name: cli_command
  value:
    name: enable_mtorr_flow_control
    handler: toggleMtorrFlowControl
    help: Toggles the MTORR flow control by the stack
    argument:
    - type: uint8
- name: cli_command
  value:
    name: enable_rx_print
    handler: enableRxPrintCommand
    help: Enable/disable printing RX messages
    argument:
    - type: uint8
- name: cli_command
  value:
    name: enable_unknown_ie_ebr
    handler: enableEnahncedBeaconRequestWithUnknownIEs
    help: Enable enhanced beacon request with unknown information elements.
    argument:
    - type: uint8
- name: cli_command
  value:
    name: erase_binds
    handler: eraseBindingsCommand
    help: Remove all local bindings
- name: cli_command
  value:
    name: erase-child
    handler: eraseChildCommand
    help: Erase the child at the specificed index
    argument:
    - type: uint8
- name: cli_command
  value:
    name: erase-child-table
    handler: eraseChildTableCommand
    help: Erase the child table
- name: cli_command
  value:
    name: evict
    handler: zigbeeEvictCommand
    help: Kick device out of network, one way or another
    argument:
    - type: uint16
    - type: hex
    - type: uint8
- name: cli_command
  value:
    name: form
    handler: formNetworkCommand
    help: Form a network
    argument:
    - type: uint8
    - type: uint16
    - type: int8
- name: cli_command
  value:
    name: form_ext
    handler: formNetworkCommand
    help: Form a network with extended settings
    argument:
    - type: uint8
    - type: uint16
    - type: int8
    - type: hex
- name: cli_command
  value:
    name: frp_be64
    handler: ebrFindOrRemovePowerByEui64
    help: find or remove power value by eui64 from ebr list
    argument:
    - type: uint8
    - type: hex
- name: cli_command
  value:
    name: get_count
    handler: packetCountCommand
    help: Sends a 'get count' command to destination
    argument:
    - type: uint8
      help: source endpoint
    - type: uint16
      help: destination short id
    - type: uint8
      help: destination endpoint
    - type: uint16
      help: aps send options
- name: cli_command
  value:
    name: get_curr_dc
    handler: getCurrentDutyCycle
    help: Get current duty cycle of connected device.
    argument:
    - type: uint8
- name: cli_command
  value:
    name: get_curr_nwk_index
    handler: getCurrentNwkIndexCommand
    help: Get the current network index
- name: cli_command
  value:
    name: get_dc_limits
    handler: getDutyCycleLimits
    help: Get duty cycle limits.
- name: cli_command
  value:
    name: get_dc_state
    handler: getDutyCycleState
    help: Get duty cycle state.
- name: cli_command
  value:
    name: get_ext_bmask
    handler: getExtendedSecurityBitmaskCommand
    help: Prints the current extended security bitmask
- name: cli_command
  value:
    name: get_security
    handler: getSecurityCommand
    help: Prints the current security settings
- name: cli_command
  value:
    name: get_short_id
    handler: getBindingShortId
    help: returns short id of node with that index in the binding table
    argument:
    - type: uint16
- name: cli_command
  value:
    name: groups
    handler: displayGroupsCommand
    help: Display APS groups
- name: cli_command
  value:
    name: hash_key
    handler: hashKey
    help: Prints the hashed key for the passed device.
    argument:
    - type: hex
    - type: hex
  condition:
  - zigbee_simulation
- name: cli_command
  value:
    name: help
    handler: helpCommand
    help: Print the list of commands
- name: cli_command
  value:
    name: ieee_addr_req
    handler: ieeeAddressRequestCommand
    help: Sends a unicast/broadcast ZDO ieee address request
    argument:
    - type: uint16
    - type: uint8
    - type: uint16
- name: cli_command
  value:
    name: ieee_address
    handler: addressRequestCommand
    help: Send a ZDO IEEE address request
    argument:
    - type: uint16
    - type: uint8
- name: cli_command
  value:
    name: join
    handler: joinNetworkCommand
    help: Join a network as router
    argument:
    - type: uint8
    - type: uint16
    - type: int8
- name: cli_command
  value:
    name: join_end
    handler: joinNetworkCommand
    help: Join a network as RxOnWhenIdle end  device
    argument:
    - type: uint8
    - type: uint16
    - type: int8
- name: cli_command
  value:
    name: join_list
    handler: joinListAddCommand
    help: 'To add: 1, delete: 0, clear: 10, print: 20 with optional arg for {EUI64}.'
    argument:
    - type: uint8
    - type: hexopt
- name: cli_command
  value:
    name: join_method
    handler: setJoinMethod
    help: Set the method used for joining
    argument:
    - type: uint8
- name: cli_command
  value:
    name: join_quietly
    handler: joinQuietlyCommand
    help: Joins a network without association or rejoin
    argument:
    - type: uint8
    - type: int8
    - type: hex
    - type: uint16
    - type: uint8
    - type: uint16opt
- name: cli_command
  value:
    name: join_sleepy
    handler: joinNetworkCommand
    help: Join a network as a sleepy end device
    argument:
    - type: uint8
    - type: uint16
    - type: int8
- name: cli_command
  value:
    name: joinlistrequest
    handler: joinListRequestCommand
    help: send a request
    argument:
    - type: uint8
- name: cli_command
  value:
    name: key_switch
    handler: keySwitchCommand
    help: Sends a network broadcast to switch to the new key
- name: cli_command
  value:
    name: key_update
    handler: keyUpdateCommand
    help: Sets the Alt NWK key and sends that out to the specified target
    argument:
    - type: uint16
    - type: hex
- name: cli_command
  value:
    name: keys
    handler: keysCommand
    help: Print the key table
    argument:
    - type: stringopt
- name: cli_command
  value:
    name: leave
    handler: leaveNetworkCommand
    help: Tell local node to Leave the network
- name: cli_command
  value:
    name: leave_with_options
    handler: leaveWithOptionsNetworkCommand
    help: Tell local node to Leave the network with options
    argument:
    - type: uint8
- name: cli_command
  value:
    name: libs
    handler: printAllLibraryStatus
    help: Prints the status of all Ember stack libraries
  unless:
  - zigbee_core_cli
- name: cli_command
  value:
    name: link_key
    handler: linkKeyCommand
    help: Set a link key entry in the table
    argument:
    - type: hex
      help: partner EUI64
    - type: hex
      help: key data
- name: cli_command
  value:
    name: lpde
    handler: lpdEventCommand
    help: set lpd event time
    argument:
    - type: uint16
  condition:
  - phy_dual
- name: cli_command
  value:
    name: mac_cert_mode
    handler: enableMacCertficationTestMode
    help: 'Enable 802.15.4 mac certification test mode, 1 : enable 0: disable. It is not persistent across reboots.'
    argument:
    - type: uint8
- name: cli_command
  value:
    name: make_end_device_sleepy
    handler: makeEndDeviceSleepy
    help: Toggles an end device between sleepy and always-on. 0 makes it sleepy, 1 makes it always on
    argument:
    - type: uint8
- name: cli_command
  value:
    name: many_to_one
    handler: manyToOneCommand
    help: Send a many-to-one route request
    argument:
    - type: uint8
      help: boolean indicating is_high_ram_concentrator
    - type: uint8
      help: request radius
- name: cli_command
  value:
    name: match_desc
    handler: sendMatchRequestCommand
    help: Send a Match Descriptor Request
    argument:
    - type: uint16
      help: target short id
    - type: uint16
      help: profile id
    - type: hex
      help: supported incoming cluster list
    - type: hex
      help: supported outgoing cluster list
    - type: uint16opt
      help: aps options
- name: cli_command
  value:
    name: modify_network_timeout_internal
    handler: modifyNetworkTimeoutInternally
    help: modify timeout request internally
    argument:
    - type: uint16
    - type: uint8
    - type: uint8
- name: cli_command
  value:
    name: msg_buffer
    handler: msgCommand
