package: zigbee
description: This component queries new devices for their endpoints and clusters to record information in the Device Database component. Devices are queried when they send a device-identifying message, such as a Device Announcement.
label: Device Query Service
quality: production
id: zigbee_device_query_service
category: Zigbee|Utility
provides:
- name: zigbee_device_query_service
requires:
- name: zigbee_device_database
- name: zigbee_concentrator
config_file:
- path: app/framework/plugin/device-query-service/config/device-query-service-config.h
source:
- path: app/framework/plugin/device-query-service/device-query-service.c
- path: app/framework/plugin/device-query-service/device-query-service-cli.c
  condition:
  - cli
include:
- path: app/framework/plugin/device-query-service
  file_list:
  - path: device-query-service.h
template_contribution:
- name: component_catalog
  value: zigbee_device_query_service
- name: zigbee_af_callback
  value:
    callback_type: event_init
    function_name: sl_zigbee_af_device_query_service_init_cb
- name: zigbee_af_callback
  value:
    callback_type: local_data_init
    function_name: sl_zigbee_af_device_query_service_init_cb
- name: cli_group
  value:
    group: plugin
    name: device-query-service
    help: device-query-service related commands.
- name: cli_command
  value:
    group: device-query-service
    name: status
    handler: sli_zigbee_af_device_query_service_status_command
    help: Prints the current status of the device query service.
- name: cli_command
  value:
    group: device-query-service
    name: enable
    handler: sli_zigbee_af_device_query_service_enable_disable_command
    help: Enables the device query service.
- name: cli_command
  value:
    group: device-query-service
    name: disable
    handler: sli_zigbee_af_device_query_service_enable_disable_command
    help: Disables the device query service.
- name: cli_command
  value:
    group: device-query-service
    name: discover
    handler: sli_zigbee_af_device_query_service_discover_command
    help: Begins discovery of device. If device has already been discovered, it is deleted from the Device Database component and re-added for discovery
    argument:
    - type: hex
      help: The EUI of the device to begin discovery for
- name: zigbee_af_callback
  value:
    callback_type: pre_zdo_message_received
    function_name: sli_zigbee_af_device_query_pre_zdo_message_received
documentation:
  docset: zigbee
  document: zigbee-af-api/device-query-service
metadata:
  sbom:
    license: MSLA
root_path: zigbee
