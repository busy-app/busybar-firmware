package: zigbee
description: Component to force device to sleep and wake up
id: zigbee_force_sleep_and_wakeup
label: Force sleep and wake up
category: Zigbee
quality: production
provides:
- name: zigbee_force_sleep_and_wakeup
source:
- path: app/framework/plugin/force-sleep-wakeup/force-sleep-wakeup.c
- path: stack/internal/src/stubs/force_sleep_wakeup_stack_interface_internal_weak_stubs.c
- path: stack/internal/src/baremetal/force_sleep_wakeup_stack_interface_baremetal_wrapper.c
  unless:
  - zigbee_use_ipc
- path: stack/internal/src/ipc/force_sleep_wakeup_stack_interface_ipc_command_messages.c
  condition:
  - zigbee_use_ipc
include:
- path: app/framework/plugin/force-sleep-wakeup
  file_list:
  - path: force-sleep-wakeup.h
- path: stack/include
  file_list:
  - path: force_sleep_wakeup_stack_interface.h
- path: stack/internal/inc
  file_list:
  - path: force_sleep_wakeup_stack_interface_internal_def.h
- path: stack/internal/src/ipc
  file_list:
  - path: force_sleep_wakeup_stack_interface_ipc_command_messages.h
    condition:
    - zigbee_use_ipc
template_contribution:
- name: component_catalog
  value: zigbee_force_sleep_and_wakeup
- name: zigbee_af_callback
  value:
    callback_type: event_init
    function_name: sli_zigbee_af_force_sleep_wakeup_init_callback
- name: cli_command
  value:
    name: force-sleep
    handler: sli_zigbee_app_framework_force_sleep_cli_handler
metadata:
  sbom:
    license: MSLA
root_path: zigbee
