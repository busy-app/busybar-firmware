{# GET_VALUE #}
void sl_zigbee_af_ezsp_get_value_command_cb(sl_zigbee_af_plugin_ezsp_value_command_context_t* context)
{
{%- set found = false %}

{%- for cb in zigbee_ncp_callback %}
{%- if cb['callback_type'] == "get_value" %}
{%- set found = true %}
{{ cb['function_name'] }}(context);
{%- endif %}
{%- endfor %}

{%- if not found %}
(void)context;
{%- endif %}
}

