id: zigbee_arm64
label: Zigbee ARM64
package: zigbee
category: Zigbee
quality: production
description: This plugin contains defines to build Zigbee apps against ARM64.

provides:
- name: arm64v8
- name: zigbee_arm64

requires:
- name: linux_arch_aarch64

validation_helper:
- path: component/scripts/zigbee_linux_arch_validation.lua

documentation:
  docset: zigbee
  document: zigbee-af-api/arm64
metadata:
  sbom:
    license: MSLA
root_path: zigbee
