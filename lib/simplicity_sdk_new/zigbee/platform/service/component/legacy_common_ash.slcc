id: legacy_common_ash
label: Legacy Common ASH
package: zigbee
category: Services|Ember Legacy
description: Legacy Ember ASH implementation common to both NCP and Host.
quality: production
metadata:
  sbom:
    license: MSLA
root_path: zigbee/platform/service/legacy_common_ash
provides:
- name: legacy_common_ash
requires:
- name: component_catalog
- name: legacy_hal
source:
- path: src/ash-common.c
include:
- path: inc
  file_list:
  - path: ash-common.h
  - path: ash-protocol.h
config_file:
- path: config/legacy_common_ash_config.h
template_contribution:
- name: component_catalog
  value: legacy_common_ash
