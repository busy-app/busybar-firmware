id: legacy_hal_host
label: Legacy HAL Host
package: zigbee
category: Services|Ember Legacy
quality: production
metadata:
  sbom:
    license: MSLA
ui_hints:
  visibility: never
description: Legacy Ember HAL for Linux/Mac/Windows host machines.
provides:
- name: legacy_hal_host
requires:
- name: component_catalog
- name: emlib_core
source:
- path: platform/service/legacy_hal/src/micro_host.c
  unless:
  - zigbee_host_simulation
- path: platform/service/legacy_hal/src/system-timer.c
  unless:
  - zigbee_host_simulation
- path: platform/service/legacy_hal/src/random.c
  unless:
  - zigbee_host_simulation
- path: platform/service/legacy_hal/src/crc.c
include:
- path: platform/service/legacy_hal/inc/
  file_list:
  - path: micro_host.h
  - path: crc.h
  - path: random.h
  - path: platform-header.h
  - path: hal.h
  - path: hal/hal.h
  - path: micro-common.h
  - path: micro-types.h
  - path: micro.h
  - path: serial.h
  - path: serial/serial.h
  - path: led.h
  - path: button.h
  - path: em2xx-reset-defs.h
  # This component brings in prototypes for CTM routines, while ZB code defines/overrides defines them, since the host does not save tokens to flash
  # The sl_token_manager_defines.h file is needed to resolve macros for tokens, which are used on the host
- path: platform/service/token_manager/inc/
  file_list:
  - path: sl_token_manager_api.h
  - path: sl_token_manager_defines.h
- path: platform/service/token_manager/legacy/inc
  file_list:
  - path: sl_token_manufacturing_generic.h
config_file:
- path: platform/service/token_manager/config/sl_token_manager_config.h
define:
- name: PLATFORM_HEADER
  value: "\"platform-header.h\""
  unless:
  - zigbee_host_simulation
template_contribution:
  # This should be included here but right now Zigbee seems to be hardcoding
  # a call to halInit() so let's not do this twice.
  # - name: event_handler
  #   value:
  #     event: platform_init
  #     include: hal.h
  #     handler: halInit
- name: component_catalog
  value: legacy_hal_host
root_path: zigbee
