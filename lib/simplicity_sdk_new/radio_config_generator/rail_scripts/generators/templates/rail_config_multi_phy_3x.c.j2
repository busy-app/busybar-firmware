{%- for element in stackInfoEntry[:-1] -%}
  {{" 0x{0[0]:02x}, ".format(element | split32)}}
{%- endfor -%}
{{-"0x{0[0]:02x} ".format(stackInfoEntry|last | split32)-}}
};
{%- endfor %}
#endif // SL_RAIL_RADIO_CONFIG_ENABLE_STACK_INFO
{% endif %}

