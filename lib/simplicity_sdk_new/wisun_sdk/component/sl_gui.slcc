id: "sl_gui"
label: "Graphical User Interface"
package: "wisun_sdk"
description: "The component provides a Graphical User Interface on top of the display service."
category: "Wi-SUN|Wi-SUN Services"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "wisun_sdk/component/gui"
provides:
- name: sl_gui

source:
- path: "sl_gui.c"
- path: "sl_widget.c"

include:
- path: "."
  file_list:
  - "path": "sl_gui.h"
  - "path": "sl_widget.h"
config_file:
- path: "config/sl_gui_config.h"
- path: "config/sl_widget_config.h"

requires:
- name: "sl_display"
- name: "simple_button"
- name: "sl_string"

ui_hints:
  visibility: never

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
- name: component_catalog
  value: gui
