id: "sl_wisun_rtt_logger"
label: "Wi-SUN RTT Logger"
package: "wisun_sdk"
description: >
  This component provides a periodic Real-Time Transfer (RTT) logger over BLE SPP for Wi-SUN applications.
category: "Wi-SUN|Wi-SUN Services"
quality: "evaluation"
metadata:
  sbom:
    license: Zlib
root_path: "wisun_sdk/component/rtt_logger"
provides:
- name: "sl_wisun_rtt_logger"
source:
- path: "sl_wisun_rtt_logger.c"
include:
- path: "."
  file_list:
  - "path": "sl_wisun_rtt_logger.h"
requires:
- name: "sleeptimer"
- name: "sl_iostream_ble_spp"
config_file:
- path: "config/sl_wisun_rtt_logger_config.h"

ui_hints:
  visibility: never

#-------------- Template Contribution ----------------
template_contribution:
- name: "event_handler"
  value:
    event: "internal_app_init"
    include: "sl_wisun_rtt_logger.h"
    handler: "sl_wisun_rtt_logger_init"
#---------------- Component Catalog ------------------
- name: "component_catalog"
  value: "wisun_rtt_logger"
