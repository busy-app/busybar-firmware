id: "sl_wisun_led_driver"
label: "Wi-SUN LED driver"
package: "wisun_sdk"
description: "Provides thread-safe message queue based LED driver with periodical signals."
category: "Wi-SUN|Wi-SUN Services"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "wisun_sdk/component/led_driver"
provides:
- name: sl_wisun_led_driver

source:
- path: "sl_wisun_led_driver.c"

include:
- path: "."
  file_list:
  - "path": "sl_wisun_led_driver.h"

config_file:
- path: "config/sl_wisun_led_driver_config.h"

requires:
- name: simple_led

ui_hints:
  visibility: never

#-------------- Template Contribution ----------------
template_contribution:
- name: "event_handler"
  value:
    event: "internal_app_init"
    include: "sl_wisun_led_driver.h"
    handler: "sl_wisun_led_driver_init"
#---------------- Component Catalog ------------------
- name: component_catalog
  value: wisun_led_driver
