id: agents_md
label: AGENTS.md
package: base_sdk
description: >
  This component provides the AGENTS.md and AGENTS_SLAB.md files for the SDK.
  The AGENTS_SLAB.md file is generated based on the components present in a
  project.
category: Platform|Generative AI
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: agents_md
root_path: generative_ai
other_file:
- path: AGENTS.md
  project:
    transfer_ownership: true
template_file:
- path: template/AGENTS-SLAB.md.jinja
template_contribution:
- name: agents_slab
  value:
    id: agents_slab
    context: This template is generated by the AGENTS.md component.
  priority: -10000
