id: psa_crypto_sha224
package: security_mbedtls
label: SHA-224
description: >-
  This component provides support for the SHA-224 hash algorithm in PSA Crypto.
category: Platform|Security|PSA Crypto|Hashing
quality: production
provides:
- name: psa_crypto_sha224
- name: psa_hash_function
  allow_multiple: true
requires:
- name: psa_crypto_hash
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_SHA_224 1
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_ALG_SHA_224 1"
  condition: [mbedtls_sha224]
documentation:
  url: https://armmbed.github.io/mbed-crypto/html/api/ops/hashes.html#c.PSA_ALG_SHA_224
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
