id: psa_crypto_gcm
package: security_mbedtls
label: GCM
description: "This component provides support for the GCM authenticated encryption algorithm in PSA Crypto.\n\nNote: Silicon Labs' hardware can only handle IV's of the recommended length equal to 12 bytes. If support for other lengths is required, use the 'GCM with Non-Recommended IV Lengths' component."
category: Platform|Security|PSA Crypto|Authenticated Encryption
quality: production
provides:
- name: psa_crypto_gcm
requires:
- name: psa_crypto_aes
- name: sl_si91x_psa_aead
  condition: [device_si91x]
- name: sl_si91x_psa_wrap
  condition: [device_si91x]
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ALG_GCM 1
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_ALG_GCM 1"
  condition: [mbedtls_gcm]
documentation:
  url: https://armmbed.github.io/mbed-crypto/html/api/ops/aead.html#c.PSA_ALG_GCM
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
