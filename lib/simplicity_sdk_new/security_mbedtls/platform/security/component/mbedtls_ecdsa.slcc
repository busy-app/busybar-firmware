id: mbedtls_ecdsa
package: security_mbedtls
label: ECDSA
description: >-
  This component provides support for signature generation and verification with
  ECDSA using Mbed TLS.
category: Platform|Security|Mbed TLS|Signatures
quality: production
provides:
- name: mbedtls_ecdsa
requires:
- name: mbedtls_ecc
- name: mbedtls_asn1
- name: psa_crypto_ecdsa
  condition: [psa_crypto]
recommends:
- id: mbedtls_sha256
  vendor: silabs
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_ECDSA_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
