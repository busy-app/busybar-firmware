id: mbedtls_sha512
package: security_mbedtls
label: SHA-512
description: >-
  This component provides support for SHA-512 hash functions using Mbed TLS.
category: Platform|Security|Mbed TLS|Hashing
quality: production
provides:
- name: mbedtls_sha512
- name: mbedtls_hash_function
  allow_multiple: true
- name: mbedtls_sha_function
  allow_multiple: true
requires:
- name: mbedtls_hash
- name: psa_crypto_sha512
  condition: [psa_crypto]
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SHA512_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
