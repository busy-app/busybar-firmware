id: mbedtls_ccm
package: security_mbedtls
label: CCM
description: >-
  This component provides support for authenticated encryption and decryption
  in CCM mode for block ciphers using Mbed TLS.
category: Platform|Security|Mbed TLS|Authenticated Encryption
quality: production
provides:
- name: mbedtls_ccm
requires:
- name: mbedtls_cipher
- name: mbedtls_block_cipher
- name: mbedtls_core
- name: psa_crypto_ccm
  condition: [psa_crypto]
recommends:
- id: mbedtls_aes
  vendor: silabs
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_CCM_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
