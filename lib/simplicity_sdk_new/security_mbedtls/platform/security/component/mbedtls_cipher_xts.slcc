id: mbedtls_cipher_xts
package: security_mbedtls
label: XTS Mode
description: >-
  This component provides support for XTS cipher modes in mbed TLS.
category: Platform|Security|Mbed TLS|Encryption
quality: production
provides:
- name: mbedtls_cipher_xts
requires:
- name: mbedtls_block_cipher
recommends:
- id: mbedtls_aes
  vendor: silabs
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_CIPHER_MODE_XTS
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
