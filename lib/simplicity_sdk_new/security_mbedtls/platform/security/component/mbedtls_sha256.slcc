id: mbedtls_sha256
package: security_mbedtls
label: SHA-256
description: >-
  This component provides support for SHA-256 hash functions using Mbed TLS.
category: Platform|Security|Mbed TLS|Hashing
quality: production
provides:
- name: mbedtls_sha256
- name: mbedtls_hash_function
  allow_multiple: true
- name: mbedtls_sha_function
  allow_multiple: true
requires:
- name: mbedtls_hash
- name: psa_crypto_sha256
  condition: [psa_crypto]
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_SHA256_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
