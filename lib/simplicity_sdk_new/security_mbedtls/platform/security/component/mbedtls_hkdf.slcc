id: mbedtls_hkdf
package: security_mbedtls
label: HKDF
description: >-
  This component provides support for key derivation using HKDF in Mbed TLS.
category: Platform|Security|Mbed TLS|Key Derivation
quality: production
provides:
- name: mbedtls_hkdf
requires:
- name: mbedtls_hmac
- name: psa_crypto_hkdf
  condition: [psa_crypto]
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_HKDF_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
