id: psa_crypto_ecc_secp192r1
package: security_mbedtls
label: secp192r1
description: >-
  This component adds support for the secp192r1 elliptic curve,
  a 192-bit prime field Weierstrass curve, in PSA Crypto.
category: Platform|Security|PSA Crypto|Elliptic Curves
quality: production
provides:
- name: psa_crypto_ecc_secp192r1
- name: psa_crypto_ecc_curve
  allow_multiple: true
requires:
- name: psa_crypto_ecc
- name: mbedtls_ecc_secp192r1
  condition: [device_si91x]
template_contribution:
- name: psa_crypto_config
  value: PSA_WANT_ECC_SECP_R1_192 1
- name: psa_crypto_builtin_config
  value: "MBEDTLS_PSA_BUILTIN_ECC_SECP_R1_192 1"
  condition: [mbedtls_ecc_secp192r1]
- name: mbedtls_config
  value: MBEDTLS_ECP_DP_SECP192R1_ENABLED
  condition: [mbedtls_uses_psa_crypto]
- name: mbedtls_mpi_max
  value: 24
  condition: [mbedtls_uses_psa_crypto]
documentation:
  url: https://armmbed.github.io/mbed-crypto/html/api/keys/types.html#c.PSA_ECC_FAMILY_SECP_R1
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
