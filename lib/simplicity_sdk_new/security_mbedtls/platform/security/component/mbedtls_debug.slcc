id: mbedtls_debug
package: security_mbedtls
label: Debug Helpers
description: >
  This component provides support for the debug APIs in Mbed TLS, provided
  by the debug.h file.
category: Platform|Security|Mbed TLS|Utilities
quality: production
provides:
- name: mbedtls_debug
requires:
- name: mbedtls_source
- name: mbedtls_hmac
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_DEBUG_C
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls
