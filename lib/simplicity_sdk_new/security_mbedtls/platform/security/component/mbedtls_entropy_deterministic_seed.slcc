id: mbedtls_entropy_deterministic_seed
package: security_mbedtls
label: Deterministic NV Seed Entropy Source
description: >-
  A deterministic non-volatile seed entropy source for randomness generation in
  Mbed TLS. This implementation provides a seed value that can be fed to a PRNG
  (Pseudo-Random Number Generator) for cryptographic operations.
category: Platform|Security|Mbed TLS|Randomness
quality: production
source:
- path: sl_component/sl_mbedtls_support/src/sl_entropy_nvseed_deterministic.c
provides:
- name: mbedtls_entropy_source
  allow_multiple: true
- name: mbedtls_entropy_deterministic_seed
requires:
- name: device_series_3
template_contribution:
- name: mbedtls_config
  value: MBEDTLS_ENTROPY_NV_SEED
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_C
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_NV_SEED_ALT
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_STD_NV_SEED_READ sli_nv_seed_read
- name: mbedtls_config
  value: MBEDTLS_PLATFORM_STD_NV_SEED_WRITE sli_nv_seed_write
metadata:
  sbom:
    reference: Zlib
root_path: security_mbedtls/platform/security
