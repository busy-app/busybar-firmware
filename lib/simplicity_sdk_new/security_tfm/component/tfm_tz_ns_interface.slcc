id: tfm_tz_ns_interface
package: security_tfm
label: Non-secure interface for TrustZone secure library or other applications.
description: 'This component provides tf-m source for tz_ns_interface '
category: Platform|Security|TrustZone
ui_hints:
  visibility: never
quality: production
provides:
- name: tfm_tz_ns_interface
include:
- path: interface/include
  file_list:
  - path: psa/client.h
  - path: psa/crypto.h
  - path: psa/crypto_client_struct.h
  - path: psa/crypto_compat.h
  - path: psa/crypto_driver_contexts_composites.h
  - path: psa/crypto_driver_contexts_primitives.h
  - path: psa/crypto_extra.h
  - path: psa/crypto_sizes.h
  - path: psa/crypto_struct.h
  - path: psa/crypto_platform.h
  - path: psa/crypto_types.h
  - path: psa/crypto_values.h
  - path: psa/error.h
  - path: psa/storage_common.h
  - path: psa_config.h
  - path: tfm_api.h
  - path: tfm_crypto_defs.h
  - path: tfm_ns_interface.h
metadata:
  sbom:
    reference: tfm_sbom
root_path: security_tfm
