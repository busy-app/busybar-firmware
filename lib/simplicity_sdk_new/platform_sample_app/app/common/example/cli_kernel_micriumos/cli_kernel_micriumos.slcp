project_name: cli_kernel_micriumos
package: platform
quality: production
label: Platform - CLI Kernel Micrium OS
description: >
  This example project demonstrates how to use the CLI driver using a Micrium OS Kernel.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Beginner"]
source:
  - path: app.c
  - path: cli.c
include:
  - path: .
    file_list:
      - path: app.h
      - path: cli.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: micriumos_kernel
  - id: cli
    instance: [inst]
  - id: simple_led_recommended_instance
  - id: sleeptimer
  - id: iostream_stdlib_config
  - id: iostream_retarget_stdio
  - id: iostream_recommended_console
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:led:1+
  - hardware:device:ram:20
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
