project_name: spidrv_eusart_slave_kernel_freertos
package: platform
quality: production
label: Platform - SPIDRV Slave on freeRTOS kernel using EUSART
description: >
  This example project demonstrates how to use the slave mode of the Serial Peripheral Interface driver in a FreeRTOS kernel task.
category: Example|Platform
filter:
  - name: "Device Type"
    value: ["SoC"]
  - name: "MCU"
    value: ["32-bit MCU"]
  - name: "Project Difficulty"
    value: ["Advanced"]
source:
  - path: app.c
  - path: spidrv_slave_freertos.c
include:
  - path: .
    file_list:
    - path: app.h
    - path: spidrv_slave_freertos.h
component:
  - id: sl_main
  - id: device_init
  - id: clock_manager
  - id: freertos
  - id: spidrv_eusart
    instance: [exp]
  - id: iostream_stdlib_config
  - id: iostream_retarget_stdio
  - id: iostream_recommended_stream
define:
  - name: DEBUG_EFM
readme:
  - path: readme.md
configuration:
  - name: SL_SPIDRV_EUSART_EXP_TYPE
    value: spidrvSlave
  - name: SL_SPIDRV_EUSART_EXP_SLAVE_START_MODE
    value: spidrvSlaveStartDelayed
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
ui_hints:
  highlight: readme.md
tag:
  - hardware:component:exp_header:spi
