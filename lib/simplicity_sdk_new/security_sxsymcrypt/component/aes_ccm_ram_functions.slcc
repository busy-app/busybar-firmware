id: aes_ccm_ram_functions
package: security_sxsymcrypt
description: >-
  Acceleration of AES-CCM by putting functions in RAM
label: Accelerate AES-CCM
category: Platform|Security|Hardware Acceleration Libraries
quality: production
ui_hints:
  visibility: never

provides:
- name: aes_ccm_ram_functions
  condition: [device_generic_family_sixx301]

requires:
- name: sxsymcrypt
- name: aes_common_ram_functions

define:
- name: SL_CODE_COMPONENT_AES_CCM
  value: aes_ccm

template_contribution:
- name: code_classification_components
  value: aes_ccm
- name: code_classification_selections
  value:
    component: aes_ccm
    class: security

metadata:
  sbom:
    license: Zlib
root_path: security_sxsymcrypt
