project_name: "connect_ncp"
label: "Connect - NCP"
package: "connect_sdk_sample_app"
description: "Connect: NCP Application for the SoC"
category: "Connect Examples"
quality: "production"

component:
  - id: sl_main
  - id: nvm3_lib
  - id: connect_app_framework_common
  - id: connect_stack_common
  - id: connect_aes_security
  - id: connect_mac_queue
  - id: connect_parent_support
  - id: connect_stack_counters
  - id: connect_poll
  - id: radio_config_simple_connect_singlephy
  - id: psa_crypto
  - id: connect_ncp
  - id: connect_cpc
  - id: cpc_secondary_recommended_uart_interface
  - id: iostream_cpc
  - id: iostream_retarget_stdio
  - id: bootloader_interface

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_HEAP_SIZE
    value: 8192
    condition:
      - device_family_efr32fg25
  - name: SL_CPC_RX_PAYLOAD_MAX_LENGTH
    value: 2048
    condition:
      - device_family_efr32fg25

source:
  - path: app.c

include:
  - path: "./"

other_file:
  - path: "../../script/connect_create_gbl_image.bat"
  - path: "../../script/connect_create_gbl_image.sh"
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

define:
  - name: SL_CATALOG_CONNECT_NCP_PRESENT
    value: 1

readme:
  - path: readme.md

#--------------------- HWFILTER ------------------------
tag:
  - hwfilter:board:hardware:has:vcom
  - hwfilter:board:hardware:has:pti
  - hwfilter:ram:23k
  - hwfilter:flash:165k
  - hwfilter:!board:brd4421a

filter:
  - name: "Wireless Technology"
    value: ["Connect"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Project Difficulty"
    value: ["Beginner"]
