project_name: connect_soc_switch
label: "Connect - SoC Switch"
package: "connect_sdk_sample_app"
description: >
  The purpose of this application is to demonstrate simple wireless
  communication between two or more boards using the Connect SDK. When combined
  with the Connect Light DMP sample application, it creates basic switch
  functionality. In this setup, the LEDs can be toggled on the Light node.
  Upon power-up, the Light (acting as the network coordinator) creates its own
  local network. The Switch modules (low-power end-nodes) can then join this
  network and control the Light node. If a local network is established using
  the CLI command, the Switch nodes can join using the join CLI command.
  From that point onward, the Light can be controlled by pressing the PB1 button
  on any connected Switch node.
category: Connect Examples
quality: production

#---------------- UC/UP components -------------------
component:
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: board_control
    condition: [hardware_board]
  - id: radio_config_simple_connect_singlephy
  - id: app_log
  - id: app_assert
  - id: token_manager
  - id: sl_rail_util_pti
  # Connect components
  - id: connect_debug_print
  - id: connect_app_framework_common
  - id: connect_stack_common
  - id: connect_psa_security_library
  - id: connect_mac_queue
  - id: connect_stack_counters
  - id: connect_poll
  - id: connect_parent_support
  - id: connect_frequency_hopping
  - id: sl_light_switch_core
  - id: simple_button
    instance:
      - btn0
      - btn1
#---------------------- CLI --------------------------
  - id: cli
    instance:
    - example
  - id: printf
  - id: iostream_recommended_stream
  - id: iostream_retarget_stdio
#------------Memory Protection Unit-------------------
  - id: mpu
#-------------- Restriction rules -------------------
  - id: restrictions_profile_connect
  - id: restrictions_profile_connect_ofdm
  - id: restrictions_profile_long_range
#-------------- Connect-RAIL DMP --------------------
  - id: rail_lib_multiprotocol
    condition:
      - sl_connect_rail_dmp
  - id: sl_rail_util_init
    instance:
      - inst0
    condition:
      - sl_connect_rail_dmp

#----------------- Require list ----------------------
requires:
  - name: a_radio_config
    condition:
      - device_is_module

#----------------- Project files ---------------------
include:
  - path: "."
    file_list:
      - path: "app_init.h"
      - path: "app_process.h"
source:
  - path: "app_init.c"
  - path: "app_process.c"
  - path: "app_cli.c"
    condition:
    - "cli"

other_file:
  - path: "../../../script/connect_create_gbl_image.bat"
  - path: "../../../script/connect_create_gbl_image.sh"
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

readme:
  - path: ../../../documentation/example/connect_dmp_light_switch/readme.md

#----------------- Project macros --------------------

#------------ Configuration overrides ----------------
configuration:
#------------ RAIL init, Channel Config --------------
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_CLI_LOCAL_ECHO
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlCtsAndRts"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
  - name: APP_LOG_PREFIX_ENABLE
    value: "0"
  - name: "SL_STACK_SIZE"
    value: "8192"

#-------------- Connect-RAIL DMP --------------------
  - name: "SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RX_PACKET_QUEUE_INST0_ENTRIES"
    value: "16"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RX_FIFO_INST0_BYTES"
    value: "128"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TX_FIFO_INST0_BYTES"
    value: "128"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOL_INST0_DEFAULT"
    value: "SL_RAIL_UTIL_PROTOCOL_PROPRIETARY"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOL_PROPRIETARY_INST0_INDEX"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_SUCCESS"
    value: "RAIL_RF_STATE_RX"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_ERROR"
    value: "RAIL_RF_STATE_RX"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENTS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_RECEIVED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_FRAME_ERROR_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_ABORTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_TIMEOUT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_PACKET_SENT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_ABORTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_BLOCKED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_STARTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_SCHEDULER_STATUS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOLS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RADIO_CONFIG_SUPPORT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_CALIBRATIONS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITIONS_INST0_ENABLE"
    value: "0"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_CALLBACKS_ASSERT_FAILED_OVERRIDE"
    value: "0"
    condition:
      - "sl_connect_rail_dmp"

#----------------- Watchdog  -------------------------
define:
  - name: SL_CONNECT_DISABLE_WATCHDOG

#--------------------- HWFILTER ------------------------
tag:
  - hwfilter:board:hardware:has:vcom
  - hwfilter:board:hardware:has:pti
  - hwfilter:ram:33k
  - hwfilter:flash:245k
  - hwfilter:board:hardware_board_supports_rf_band_2400
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
  - hwfilter:!board:brd4171a
  - hwfilter:!board:brd4176a
  - hwfilter:!board:brd4179b
  - hwfilter:!board:brd4180a
  - hwfilter:!board:brd4180b
  - hwfilter:!board:brd4181a
  - hwfilter:!board:brd4181b
  - hwfilter:!board:brd4181c
  - hwfilter:!board:brd4195a
  - hwfilter:!board:brd4195b
  - hwfilter:!board:brd4196a
  - hwfilter:!board:brd4196b
  - hwfilter:!board:brd4308c
  - hwfilter:!board:brd4309a
  - hwfilter:!board:brd4328a
  - hwfilter:!board:brd4328b
  - hwfilter:!board:brd4329a
  - hwfilter:!board:brd4332a

#-------------- Template Contribution ----------------
template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_command
    value:
      name: join
      handler: cli_join
      help: "Join the Switch to the network as a Sleepy End Device"
  - name: cli_command
    value:
      name: toggle_light
      handler: cli_toggle_light
      help: "Toggle the light on the Light node"
  - name: cli_command
    value:
      name: leave
      handler: cli_leave
      help: "Disconnect from the actual network"
  - name: cli_command
    value:
      name: reset
      handler: cli_reset
      help: "Reset the hardware"
  - name: cli_command
    value:
      name: info
      handler: cli_info
      help: "MCU ID, Network state, Node ID, PAN ID, Channel ID, etc."
  - name: cli_command
    value:
      name: set_pan_id
      handler: cli_set_pan_id
      help: "Set the PAN ID of the node"
      argument:
      - type: uint16
        help: "2 byte PAN ID"
  - name: cli_command
    value:
      name: set_channel
      handler: cli_set_channel
      help: "Set the communication channel"
      argument:
      - type: uint16
        help: "2 byte channel number"
  - name: cli_command
    value:
      name: set_tx_options
      handler: cli_set_tx_option
      help: "Set Tx options"
      argument:
      - type: uint8
        help: "Security(0x01) MAC Ack(0x02) High Prio(0x04)"
  - name: cli_command
    value:
      name: set_key
      handler: cli_set_security_key
      help: "Set security key"
      argument:
      - type: hex
        help: "Security key (size:EMBER_ENCRYPTION_KEY_SIZE)"
  - name: cli_command
    value:
      name: unset_key
      handler: cli_unset_security_key
      help: "Unset current security key"
#--------------------- Toolchain ------------------------
toolchain_settings:
  - option: optimize
    value: debug

filter:
  - name: "Wireless Technology"
    value: ["Connect"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]
