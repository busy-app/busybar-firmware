project_name: connect_soc_direct_mode_device
label: "Connect - SoC Direct Mode Device"
package: "connect_sdk_sample_app"
description: >
  The provided sample application facilitates direct commissioning of nodes and
  enables seamless data exchange between them through command line interface
  (CLI) commands. Developers can utilize this functionality to streamline
  communication and enhance interoperability within their networked systems.
category: Connect Examples
quality: production

#---------------- UC/UP components -------------------
component:
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: board_control
    condition: [hardware_board]
  - id: radio_config_simple_connect_singlephy
  - id: app_log
  - id: app_assert
  - id: component_catalog
  - id: sl_rail_util_pti
  # Connect components
  - id: sl_connect_config
  - id: connect_app_framework_common
  - id: connect_stack_common
  - id: connect_psa_security_library
  - id: connect_mac_queue
  - id: connect_stack_counters
  - id: connect_poll
  - id: connect_mailbox_server
  - id: connect_mailbox_client
  - id: token_manager
  - id: connect_frequency_hopping
#---------------------- CLI --------------------------
  - id: cli
    instance:
    - example
  - id: printf
  - id: iostream_recommended_stream
  - id: iostream_retarget_stdio
#------------Memory Protection Unit-------------------
  - id: mpu
#-------------- Restriction rules -------------------
  - id: restrictions_profile_connect
  - id: restrictions_profile_connect_ofdm
  - id: restrictions_profile_long_range
#-------------- Connect-RAIL DMP --------------------
  - id: rail_lib_multiprotocol
    condition:
      - sl_connect_rail_dmp
  - id: sl_rail_util_init
    instance:
      - inst0
    condition:
      - sl_connect_rail_dmp

#----------------- Provide list ----------------------
provides:
  - name: simple_connect_singlephy_application

#----------------- Require list ----------------------
requires:
  - name: a_radio_config
  - name: radio_config_simple_connect_singlephy_device_family_fgm23
    condition:
      - "device_family_fgm23"

#----------------- Project files ---------------------
include:
  - path: "."
    file_list:
      - path: "app_init.h"
      - path: "app_process.h"

source:
  - path: "app_init.c"
  - path: "app_process.c"
  - path: "app_cli.c"
    condition:
    - "cli"

other_file:
  - path: "../../script/connect_create_gbl_image.bat"
  - path: "../../script/connect_create_gbl_image.sh"
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

readme:
  - path: ../../documentation/example/connect_soc_direct_mode_device/readme.md

#----------------- Project macros --------------------

#------------ Configuration overrides ----------------
configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_CLI_LOCAL_ECHO
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlCtsAndRts"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
  - name: APP_LOG_PREFIX_ENABLE
    value: "0"
  - name: SL_STACK_SIZE
    value: "8192"

#-------------- Connect-RAIL DMP --------------------
  - name: "SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RX_PACKET_QUEUE_INST0_ENTRIES"
    value: "16"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RX_FIFO_INST0_BYTES"
    value: "128"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TX_FIFO_INST0_BYTES"
    value: "128"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOL_INST0_DEFAULT"
    value: "SL_RAIL_UTIL_PROTOCOL_PROPRIETARY"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOL_PROPRIETARY_INST0_INDEX"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_SUCCESS"
    value: "RAIL_RF_STATE_RX"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_ERROR"
    value: "RAIL_RF_STATE_RX"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENTS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_RECEIVED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_FRAME_ERROR_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_ABORTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_RX_TIMEOUT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_PACKET_SENT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_ABORTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_BLOCKED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_TX_STARTED_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_EVENT_SCHEDULER_STATUS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_PROTOCOLS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_RADIO_CONFIG_SUPPORT_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_CALIBRATIONS_INST0_ENABLE"
    value: "1"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_INIT_TRANSITIONS_INST0_ENABLE"
    value: "0"
    condition:
      - "sl_connect_rail_dmp"
  - name: "SL_RAIL_UTIL_CALLBACKS_ASSERT_FAILED_OVERRIDE"
    value: "0"
    condition:
      - "sl_connect_rail_dmp"

#----------------- Watchdog  -------------------------
define:
  - name: SL_CONNECT_DISABLE_WATCHDOG
#-------------- Template Contribution ----------------
template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_command
    value:
      name: commission
      handler: cli_commission
      help: "Form network and enable permit join"
      argument:
      - type: uint16
        help: "Node ID"
      - type: uint16
        help: "PAN ID"
      - type: uint16
        help: "Radio Channel"
      - type: int16
        help: "Transmit Power"
  - name: cli_command
    value:
      name: counter
      handler: cli_counter
      help: "Print out the passed stack counter"
      argument:
      - type: uint8
        help: "Counter type"
  - name: cli_command
    value:
      name: data
      handler: cli_data
      help: "Send message to the given destination Node ID"
      argument:
      - type: uint16
        help: "Destination Node ID"
      - type: hex
        help: "Payload (e.g. {AABB} even number of digits)"
  - name: cli_command
    value:
      name: info
      handler: cli_info
      help: "MCU ID, Network state, Node ID, PAN ID, Channel ID, etc."
  - name: cli_command
    value:
      name: leave
      handler: cli_leave
      help: "Forget the current network and revert to EMBER_NO_NETWORK"
  - name: cli_command
    value:
      name: reset
      handler: cli_reset
      help: "Reset the hardware"
  - name: cli_command
    value:
      name: set_channel
      handler: cli_set_channel
      help: "Set Connect channel"
      argument:
      - type: uint16
        help: "Channel ID"
  - name: cli_command
    value:
      name: set_key
      handler: cli_set_security_key
      help: "Set security key"
      argument:
      - type: hex
        help: "Security key (size:EMBER_ENCRYPTION_KEY_SIZE)"
  - name: cli_command
    value:
      name: unset_key
      handler: cli_unset_security_key
      help: "Unset current security key"
  - name: cli_command
    value:
      name: set_tx_options
      handler: cli_set_tx_option
      help: "Set Tx options"
      argument:
      - type: uint8
        help: "Security(0x01) MAC Ack(0x02) High Prio(0x04)"
  - name: cli_command
    value:
      name: start_energy_scan
      handler: cli_start_energy_scan
      help: "Scan the energy level on the given channel"
      argument:
      - type: uint8
        help: "Channel ID"
      - type: uint8
        help: "Number of samples"
  - name: cli_command
    value:
      name: toggle_radio
      handler: cli_toggle_radio
      help: "Turn ON/OFF the radio for RX"
      argument:
      - type: uint8
        help: "State to set Radio (OFF-0, ON-anyway)"
  - name: cli_command
    value:
      name: tx_test
      handler: cli_tx_test
      help: "Send packets to the given destination Node ID"
      argument:
      - type: uint8
        help: "Packet size"
      - type: uint8
        help: "Packet number"
      - type: uint16
        help: "Node ID"
  - name: cli_command
    value:
      name: tx_test_print_enable
      handler: cli_tx_test_print_enable
      help: "Turn ON/OFF printing the received TX test packets"
      argument:
      - type: uint8
        help: "State printing received TX packets (OFF-0, ON-anyway)"
#--------------------- HWFILTER ------------------------
tag:
  - hwfilter:board:hardware:has:vcom
  - hwfilter:board:hardware:has:pti
  - hwfilter:ram:32k
  - hwfilter:flash:240k
#--------------------- Toolchain ------------------------
toolchain_settings:
  - option: optimize
    value: debug

ui_hints:
  highlight:
    - path: readme.md
      focus: true

filter:
  - name: "Wireless Technology"
    value: ["Connect"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]
