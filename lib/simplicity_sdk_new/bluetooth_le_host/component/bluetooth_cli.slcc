id: "bluetooth_cli"
label: "Bluetooth_cli"
package: "bluetooth_le_host"
description: >
  This component provides a Command Line Interface (CLI) that enables
  applications running on external hosts to interact with the Bluetooth
  stack running on EFR devices in SoC mode.
  This component is intended for system testing purposes only.
  Do not use this component in production environments.
category: "Bluetooth|CLI"
quality: "experimental"
ui_hints:
  visibility: never

include:
- path: "inc/"
  file_list:
  - path: "sl_bt_cli.h"
source:
- path: "src/sl_bt_cli.c"
requires:
- name: "bluetooth_stack"
- name: printf
- name: "cli"
provides:
- name: "bluetooth_cli"
template_contribution:
- name: "bluetooth_on_event"
  value:
    include: "sl_bt_cli.h"
    function: "sl_bt_cli_on_event"
- name: cli_group
  value:
    name: bt_system
- name: cli_group
  value:
    name: bt_linklayer
