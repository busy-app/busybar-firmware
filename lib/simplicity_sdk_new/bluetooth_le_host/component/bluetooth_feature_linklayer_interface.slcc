id: "bluetooth_feature_linklayer_interface"
label: "linklayer_interface"
package: bluetooth_le_host
description: >
  This component provides access to low-level Bluetooth link layer functionality
  that is not available via higher-level APIs of the Bluetooth host stack. This
  includes enabling and configuring procedure event information reporting.
category: Bluetooth|Bluetooth Host (Stack)|Features with Commands and Events
quality: "production"
requires:
- name: "bluetooth_stack"
provides:
- name: "bluetooth_feature_linklayer_interface"
template_contribution:
- name: component_catalog
  value: bluetooth_feature_linklayer_interface
documentation:
  docset: bluetooth
  document: bluetooth-stack-api/sl-bt-linklayer
metadata:
  sbom:
    license: MSLA
library:
- path: build/gcc/cortex-m33/linklayer_interface/release/libble_host_linklayer_interface.a
  condition:
  - toolchain_gcc
  - cortexm33
  - bluetooth_feature_linklayer_interface
- path: build/iar/cortex-m33/linklayer_interface/release/libble_host_linklayer_interface.a
  condition:
  - toolchain_iar
  - cortexm33
  - bluetooth_feature_linklayer_interface
- path: build/llvm/cortex-m33/linklayer_interface/release/libble_host_linklayer_interface.a
  condition:
  - toolchain_llvm
  - cortexm33
  - bluetooth_feature_linklayer_interface
root_path: bluetooth_le_host
