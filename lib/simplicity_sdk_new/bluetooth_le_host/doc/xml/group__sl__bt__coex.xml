      <memberdef kind="function" id="group__sl__bt__coex_1gac9a999d3200c7426e38be561b609bc8c" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_coex_get_counters</definition>
        <argsstring>(uint8_t reset, size_t max_counters_size, size_t *counters_len, uint8_t *counters)</argsstring>
        <name>sl_bt_coex_get_counters</name>
        <param>
          <type>uint8_t</type>
          <declname>reset</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>max_counters_size</declname>
        </param>
        <param>
          <type>size_t *</type>
          <declname>counters_len</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>counters</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Read coexistence statistic counters from the device. Response contains the list of uint32 type counter values. Counters in the list are in following order: low priority requested, high priority requested, low priority denied, high priority denied, low-priority TX aborted, and high-priority TX aborted. Passing a non-zero value also resets counters.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">reset</parametername>
</parameternamelist>
<parameterdescription>
<para>Reset counters if parameter value is not zero. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">max_counters_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Size of output buffer passed in <computeroutput>counters</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">counters_len</parametername>
</parameternamelist>
<parameterdescription>
<para>On return, set to the length of output data written to <computeroutput>counters</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">counters</parametername>
</parameternamelist>
<parameterdescription>
<para>Coexistence statistic counters</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
