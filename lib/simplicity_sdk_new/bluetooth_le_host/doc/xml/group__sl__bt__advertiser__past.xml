        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_advertiser_past_transfer_over_pawr_advertiser</definition>
        <argsstring>(uint8_t transferring_advertising_set, uint16_t service_data, uint8_t advertising_set, uint8_t repeat_count, size_t subevents_len, const uint8_t *subevents)</argsstring>
        <name>sl_bt_advertiser_past_transfer_over_pawr_advertiser</name>
        <param>
          <type>uint8_t</type>
          <declname>transferring_advertising_set</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>service_data</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>advertising_set</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>repeat_count</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>subevents_len</declname>
        </param>
        <param>
          <type>const uint8_t *</type>
          <declname>subevents</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Transfer the synchronization information of an advertising set that is actively performing periodic advertising. The transfer happens over a Periodic Advertising with Responses (PAwR) train.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">transferring_advertising_set</parametername>
</parameternamelist>
<parameterdescription>
<para>The handle of the PAwR advertising set used to transfer the synchronization information to the synchronized devices. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">service_data</parametername>
</parameternamelist>
<parameterdescription>
<para>A value provided by the application for use by the peer device. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">advertising_set</parametername>
</parameternamelist>
<parameterdescription>
<para>Handle of the periodic advertising set to transfer </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">repeat_count</parametername>
</parameternamelist>
<parameterdescription>
<para>The number of times the synchronization information is sent on the specified subevents of <computeroutput>transferring_advertising_set</computeroutput>.<itemizedlist>
<listitem><para><bold>Range:</bold> 0x01 to 0xFF </para>
</listitem></itemizedlist>
</para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">subevents_len</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of data in <computeroutput>subevents</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">subevents</parametername>
</parameternamelist>
<parameterdescription>
<para>Array of subevent indexes in which to send the synchronization information. If a zero-length array is provided, the synchronization information is sent in all subevents of <computeroutput>transferring_advertising_set</computeroutput>.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
