        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_pawr_sync_set_sync_subevents</definition>
        <argsstring>(uint16_t sync, size_t subevents_len, const uint8_t *subevents)</argsstring>
        <name>sl_bt_pawr_sync_set_sync_subevents</name>
        <param>
          <type>uint16_t</type>
          <declname>sync</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>subevents_len</declname>
        </param>
        <param>
          <type>const uint8_t *</type>
          <declname>subevents</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Specify the subevents that this device will synchronize to on the specified PAwR train.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">sync</parametername>
</parameternamelist>
<parameterdescription>
<para>PAwR synchronization handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">subevents_len</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of data in <computeroutput>subevents</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">subevents</parametername>
</parameternamelist>
<parameterdescription>
<para>Array of subevent indexes to synchronize to</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
