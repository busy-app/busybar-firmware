      <memberdef kind="function" id="group__sl__bt__resource_1ga364e6338e65b335e0ebfcbbb600c1757" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_resource_get_status</definition>
        <argsstring>(uint32_t *total_bytes, uint32_t *free_bytes)</argsstring>
        <name>sl_bt_resource_get_status</name>
        <param>
          <type>uint32_t *</type>
          <declname>total_bytes</declname>
        </param>
        <param>
          <type>uint32_t *</type>
          <declname>free_bytes</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Get the present memory buffer usage status.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="out">total_bytes</parametername>
</parameternamelist>
<parameterdescription>
<para>The number of total bytes in the memory buffer </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">free_bytes</parametername>
</parameternamelist>
<parameterdescription>
<para>The number of free bytes in the memory buffer</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
