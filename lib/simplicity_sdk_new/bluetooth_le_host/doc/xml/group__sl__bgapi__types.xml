      <memberdef kind="define" id="group__sl__bgapi__types_1ga335896cc750f109d2b622a6254261c8d" prot="public" static="no">
        <name>SL_BGAPI_MSG_HEADER_FROM_ID_AND_LEN</name>
        <param><defname>evt_id</defname></param>
        <param><defname>payload_len</defname></param>
        <initializer>  ((uint32_t) (((uint32_t) (evt_id))                             \
               | (((uint32_t) (payload_len) &amp; 0x00FF) &lt;&lt; 8)      \
               | (((uint32_t) (payload_len) &amp; 0x0700) &gt;&gt; 8)))    \</initializer>
        <briefdescription>
<para>Construct a BGAPI message header from an event ID and payload length. </para>
        </briefdescription>
        <detaileddescription>
<para>It is the caller&apos;s responsibility to verify that the input values are within valid range.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">evt_id</parametername>
</parameternamelist>
<parameterdescription>
<para>The full event ID constant, for example <computeroutput>sl_bt_evt_system_boot_id</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">payload_len</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of the full BGAPI message payload</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The header as a <computeroutput>uint32_t</computeroutput> value </para>
</simplesect>
</para>
