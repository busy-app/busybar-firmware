      <memberdef kind="function" id="group__sl__bt__periodic__advertiser_1ga862241c104b48e65829ae257fae08bb4" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_periodic_advertiser_stop</definition>
        <argsstring>(uint8_t advertising_set)</argsstring>
        <name>sl_bt_periodic_advertiser_stop</name>
        <param>
          <type>uint8_t</type>
          <declname>advertising_set</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Stop the periodic advertising on an advertising set. Counterpart to <ref refid="group__sl__bt__periodic__advertiser_1gaf2a2688f53f25df2d1ba12a5f5fafbd3" kindref="member">sl_bt_periodic_advertiser_start</ref>.</para>
<para>This command does not affect the enable state of the legacy or extended advertising on the advertising set, i.e., the legacy or extended advertising is not stopped.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">advertising_set</parametername>
</parameternamelist>
<parameterdescription>
<para>Advertising set handle</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
