      <sectiondef kind="func">
      <memberdef kind="function" id="group__sl__bt__sync_1ga03017c6d7c17e5911886df498c1c6a33" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>sl_status_t</type>
        <definition>sl_status_t sl_bt_sync_set_reporting_mode</definition>
        <argsstring>(uint16_t sync, uint8_t reporting_mode)</argsstring>
        <name>sl_bt_sync_set_reporting_mode</name>
        <param>
          <type>uint16_t</type>
          <declname>sync</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>reporting_mode</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Set data reporting mode of the periodic advertising synchronization.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">sync</parametername>
</parameternamelist>
<parameterdescription>
<para>Periodic advertising synchronization handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">reporting_mode</parametername>
</parameternamelist>
<parameterdescription>
<para>Enum <ref refid="group__sl__bt__sync_1ga4d6dbc6ce7a4dfc5ba8e473253161d30" kindref="member">sl_bt_sync_reporting_mode_t</ref>. Specifies the mode for reporting data received in the periodic advertising train. Values:<itemizedlist>
<listitem><para><bold>sl_bt_sync_report_none (0x0):</bold> Data received in periodic advertising trains is not reported to the application.</para>
</listitem><listitem><para><bold>sl_bt_sync_report_all (0x1):</bold> Data received in periodic advertising trains is reported to the application.</para>
</listitem></itemizedlist>
</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SL_STATUS_OK if successful. Error code otherwise. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/var/lib/jenkins/github@3/bluetooth_le_host/build/native/ble_bgapi/inc/sl_bt_api.h" line="4367" column="13" declfile="/var/lib/jenkins/github@3/bluetooth_le_host/build/native/ble_bgapi/inc/sl_bt_api.h" declline="4367" declcolumn="13"/>
