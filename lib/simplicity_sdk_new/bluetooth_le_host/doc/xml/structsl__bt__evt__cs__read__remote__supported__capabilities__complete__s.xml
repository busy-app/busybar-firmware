        <qualifiedname>sl_bt_evt_cs_read_remote_supported_capabilities_complete_s::rtt_capability</qualifiedname>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>This value is a bitmask of flags to indicate which Round Trip Time (RTT) CS capabilities accuracy requirement in <computeroutput>rtt_aa_only_n</computeroutput>, <computeroutput>rtt_sounding_n</computeroutput>, and <computeroutput>rtt_random_payload</computeroutput>. Flags:<itemizedlist>
<listitem><para><bold>0x01, bit 0:</bold> 10 ns time-of-flight (ToF) precision requirement for <computeroutput>rtt_aa_only</computeroutput> if set; otherwise 150 ns ToF</para>
</listitem><listitem><para><bold>0x02, bit 1:</bold> 10 ns ToF precision requirement for <computeroutput>rtt_sounding</computeroutput> if set; otherwise 150 ns ToF</para>
</listitem><listitem><para><bold>0x04, bit 2:</bold> 10 ns ToF precision requirement for <computeroutput>rtt_random_payload</computeroutput> if set; otherwise 150 ns ToF </para>
</listitem></itemizedlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/var/lib/jenkins/github@3/bluetooth_le_host/build/native/ble_bgapi/inc/sl_bt_api.h" line="13697" column="12" bodyfile="/var/lib/jenkins/github@3/bluetooth_le_host/build/native/ble_bgapi/inc/sl_bt_api.h" bodystart="13697" bodyend="-1"/>
      </memberdef>
