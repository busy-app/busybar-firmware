project_name: zigbee_ncp_mp_spi
label: Zigbee - NCP MpNcpSpi
package: zigbee
category: Zigbee Application
quality: production
description: The multi-PAN application provides support to form two personal area networks  on same channel on single radio. This multi-PAN network coprocessor (NCP)  application supports communication with a host application over a SPI interface.  This NCP application can be built as configured, or optionally can be augmented  with customized extensions for initialization, main loop processing, event  definition/handling, and messaging with the host.
author: Silicon Laboratories, Inc.

component:
  - id: sl_main
  - id: iostream_usart
    instance:
      - vcom
  - id: iostream_vuart
  - id: zigbee_debug_print
  - id: zigbee_debug_basic
  - id: zigbee_debug_extended
  - id: zigbee_gp
  - id: zigbee_ncp_spi
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_security_link_keys
  - id: zigbee_r22_support
  - id: zigbee_multi_network
  - id: zigbee_multi_pan
  - id: zigbee_zll
  - id: clock_manager
  # Platform - enable LTO for gcc
  - id: toolchain_gcc_lto

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_CLI_MAX_INPUT_ARGUMENTS
    value: 16
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_MAX_END_DEVICE_CHILDREN
    value: 32
  - name: SL_ZIGBEE_PACKET_BUFFER_HEAP_SIZE
    value: SL_ZIGBEE_LARGE_PACKET_BUFFER_HEAP
  - name: EMBER_AF_PLUGIN_ZIGBEE_PRO_STACK_CHILD_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_KEY_TABLE_SIZE
    value: 12
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 600
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
define:
  - name: SL_ZIGBEE_CUSTOM_MAC_FILTER_TABLE_SIZE
    value: 15
include:
  - path: ./

source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app.c

readme:
  - path: ./readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: false

filter:
  - name: Wireless Technology
    value: [Zigbee]
  - name: Device Type
    value: [NCP]
  - name: Project Difficulty
    value: [Advanced]

tag:
  - hardware:component:exp_header:spi
  - hwfilter:device:device_supports_zigbee
  - hwfilter:!board:zb_boards_spi_incompatible
  - hwfilter:board:hardware_board_has_spi
  - hwfilter:!board:zb_boards_ncp_spi_incompatible
