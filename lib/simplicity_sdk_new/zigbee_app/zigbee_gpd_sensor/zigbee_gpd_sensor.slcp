project_name: zigbee_gpd_sensor
label: Zigbee - GPD Sensor
package: zigbee
category: Zigbee Application
quality: production

description: >
  This is a Green Power Sensor Device that pairs with a GP Combo or Sink device and sends gpd reports periodically.
author: Silicon Laboratories, Inc.

# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
include:
  - path: .
    file_list:
      - path: app_init.h
      - path: app_process.h

component:
#---------------- UC/UP components -------------------
  - id: sl_main
  - id: device_init
  - id: sleeptimer
  - id: rail_util_recommended
  - id: rail_util_init
    instance:
      - gpdrail
#---------------- User Buttons -----------------------
  - id: simple_button
    instance:
      - btn0
      - btn1
#---------------- User LEDs --------------------------
  - id: simple_led
    instance:
      - led0
      - led1
#---------------- mbedTLS ----------------------------
  - id: mbedtls_ccm
#---------------- NVM3 -------------------------------
  - id: nvm3_default
#---------------- CLI --------------------------------
  - id: cli
    instance:
      - gpdCli
  - id: zigbee_debug_print
  - id: iostream_recommended_console
#---------------- GPD Componenets --------------------
  - id: zigbee_gpd_af_cli
  - id: zigbee_gpd_application_support
  - id: zigbee_gpd_network_support
  - id: clock_manager
  # Platform - enable LTO for gcc
  - id: toolchain_gcc_lto

configuration:
  - name: SL_RAIL_UTIL_INIT_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_PROTOCOLS_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_PROTOCOL_GPDRAIL_DEFAULT
    value: SL_RAIL_UTIL_PROTOCOL_IEEE802154_2P4GHZ
  - name: SL_RAIL_UTIL_INIT_CALIBRATIONS_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_TEMPERATURE_NOTIFY_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_ONETIME_NOTIFY_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_TRANSITIONS_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_EVENTS_GPDRAIL_ENABLE
    value: 1
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_RECEIVED_GPDRAIL_ENABLE
    value: 1
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_CLI_LOCAL_ECHO
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: 1
    condition:
      - iostream_eusart
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE
    condition:
      - iostream_eusart
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_RX_WINDOW
    value: '8'
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_APP_INFO
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_APPS_GPD_MANUFACTURE_ID_PRESENT
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_APPS_GPD_MODEL_ID_PRESENT
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_GPD_SWITCH_INFO_PRESENT
    value: 0
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_GPD_APP_DESCRIPTION_FOLLOWS
    value: 1
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_APP_DEVICE_ID
    value: '0x12'
  - name: SL_ZIGBEE_AF_PLUGIN_APPS_SRC_ID
    value: '0x11223344'
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: SL_STACK_SIZE
    value: 1024
    condition:
      - freertos
      - device_series_2
  - name: SL_STACK_SIZE
    value: 16384
    condition:
      - device_series_3
  - name: SL_STACK_SIZE
    value: 512
    condition:
      - micriumos_kernel
      - device_series_2
  # Timer RTOS task priority needs to be one more than SL_BT_RTOS_LINK_LAYER_TASK_PRIORITY
  # BT uses event flags that require the timer task to be higher priority than all other RTOS tasks
  - name: configTIMER_TASK_PRIORITY
    value: 53
  - name: configMAX_TASK_NAME_LEN
    value: 30
  - name: SL_CLI_EXAMPLE_TASK_STACK_SIZE
    value: 600
    condition:
      - cmsis_rtos2
  # On series 3, the bootloader requires more stack to do context parsing of OTA images
  - name: SL_CLI_EXAMPLE_TASK_STACK_SIZE
    value: 1500
    condition:
      - device_series_3
  - name: SL_ZIGBEE_STACK_RTOS_TASK_STACK_SIZE
    value: 5800
    condition:
      - device_series_3
  - name: SL_ZIGBEE_APP_FRAMEWORK_RTOS_TASK_STACK_SIZE
    value: 6000
    condition:
      - device_series_3
  - name: SL_ZIGBEE_AF_PLUGIN_ZCL_CLUSTER_DEFER_ATTRIBUTE_WRITES_TO_NVM_MS
    value: 2000
    condition:
      - device_series_3

source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app_init.c
  - path: app_process.c
  - path: app_cli.c

#-------------- Template Contribution ----------------
template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_group
    value:
      name: sensor
      help: sensor related commands
  - name: cli_command
    value:
      name: report
      group: sensor
      handler: sl_zigbee_gpd_af_cli_sensor_report
      help: Sends a report out.
  - name: cli_command
    value:
      name: sleep
      group: sensor
      handler: sl_zigbee_gpd_af_cli_sensor_sleep
      help: sets gpd as a sleepy device.

readme:
  - path: ./readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: false

filter:
  - name: Wireless Technology
    value: [Zigbee]
  - name: Device Type
    value: [SoC]
  - name: Project Difficulty
    value: [Advanced]

tag:
  - hardware:device:ram:32
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
  - hwfilter:board:simple_led:led0
  - hwfilter:board:simple_led:led1
  - hardware:component:pti
  - hwfilter:!board:hardware:shares:button:led
  - hwfilter:device:device_supports_zigbee
  - hwfilter:!device:device_is_module
  - hwfilter:!device:device_series_3
