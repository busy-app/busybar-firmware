id: segger_systemview_micriumos
label: SEGGER SystemView for Micrium OS
package: segger
description: SEGGER SystemView sample for Micrium OS
category: Third Party|Segger|System View
quality: production
metadata:
  sbom:
    license: Segger
ui_hints:
  visibility: never
config_file:
