# This HAL applies only to series 3 devices.
id: hal_pixelrz
label: PIXELRZ
package: platform_core
description: >
  PIXELRZ peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_pixelrz.c
include:
- path: inc
  file_list:
  - path: sl_hal_pixelrz.h
provides:
- name: hal_pixelrz
requires:
- name: device
- name: device_has_pixelrz
- name: device_series_3
- name: hal_common
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-sixg301/pixelrz
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
