# This HAL applies to series 2 and 3 devices.
id: hal_system
label: SYSTEM
package: platform_core
description: >
  System peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_system.c
include:
- path: inc
  file_list:
  - path: sl_hal_system.h
  - path: sl_hal_system_generic.h
provides:
- name: hal_system
- name: hal_generic_system
  condition: [device_series_3]
requires:
- name: device
- name: hal_common
- name: cmsis_core
- name: hal_syscfg
- name: enum
- name: status
- name: sl_assert
- name: emlib_cmu
  condition: [device_sdid_240]
- name: se_manager
  condition: [device_generic_family_sixx301]
- name: se_manager_device_data
  condition: [device_generic_family_sixx301]
template_contribution:
- name: component_catalog
  value: hal_system
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/system
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/system
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/system
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/system
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/system
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/system
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/system
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/system
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/system
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/system
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
