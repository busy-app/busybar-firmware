# This HAL applies to series 2 and 3 devices.
id: hal_timer
label: TIMER
package: platform_core
description: >
  Timer/counter (TIMER) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_timer.c
include:
- path: inc
  file_list:
  - path: sl_hal_timer.h
provides:
- name: hal_timer
- name: hal_generic_timer
  condition: [device_series_3]
requires:
- name: device
- name: device_has_timer
- name: hal_common
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/timer
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/timer
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/timer
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/timer
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/timer
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/timer
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/timer
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/timer
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/timer
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/timer
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
