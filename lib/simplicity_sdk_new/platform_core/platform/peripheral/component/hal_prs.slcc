# This HAL applies to series 2 and 3 devices.
id: hal_prs
label: PRS
package: platform_core
description: >
  Peripheral Reflex System (PRS) Peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_prs.c
include:
- path: inc
  file_list:
  - path: sl_hal_prs.h
  - path: sl_hal_prs_enums.h
provides:
- name: hal_prs
  condition: [device_series_2]
- name: hal_prs
  condition: [device_generic_family_sixx301]
- name: hal_generic_prs
  condition: [device_generic_family_sixx301]
requires:
- name: device
- name: device_has_prs
- name: device_gpio
- name: hal_common
- name: status
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/prs
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/prs
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/prs
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/prs
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/prs
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/prs
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/prs
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/prs
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/prs
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/prs
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
