# This HAL applies to series 2 and 3 devices.
id: hal_pcnt
label: PCNT
package: platform_core
description: >
  Pulse Counter (PCNT) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_pcnt.c
include:
- path: inc
  file_list:
  - path: sl_hal_pcnt.h
provides:
- name: hal_pcnt
- name: hal_generic_pcnt
  condition: [device_series_3]
requires:
- name: device
- name: device_has_pcnt
- name: hal_common
- name: cmsis_core
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg23/pcnt
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/pcnt
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/pcnt
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/pcnt
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg28/pcnt
    condition: [device_sdid_235]
  - page: platform-peripheral-sixg301/pcnt
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
