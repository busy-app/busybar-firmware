# This HAL applies only to series 2 devices.
id: hal_keyscan
label: KEYSCAN
package: platform_core
description: >
  KEYSCAN Peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_keyscan.c
include:
- path: inc
  file_list:
  - path: sl_hal_keyscan.h
  - path: sl_hal_keyscan_compat.h
  - path: peripheral_keyscan.h
  - path: peripheral_keyscan_compat.h
provides:
- name: hal_keyscan
requires:
- name: device
- name: device_has_keyscan
- name: hal_generic_common
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg23/keyscan
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/keyscan
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg28/keyscan
    condition: [device_sdid_235]
root_path: platform_core/platform/peripheral
