# This HAL applies to series 2 and 3 devices.
id: hal_sysrtc
label: SYSRTC
package: platform_core
description: >
  System Real Time Counter (SYSRTC) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: hal_sysrtc
requires:
- name: device
- name: device_has_sysrtc
- name: hal_sysrtc_subsystem
- name: hal_generic_common
- name: cmsis_core
- name: enum
- name: code_classification
template_contribution:
- name: code_classification_components
  value: hal_sysrtc
define:
- name: SL_CODE_COMPONENT_HAL_SYSRTC
  value: hal_sysrtc
root_path: platform_core/platform/peripheral
