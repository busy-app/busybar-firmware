# This HAL applies to series 2 and 3 devices.
id: hal_letimer
label: LETIMER
package: platform_core
description: >
  Low Energy Timer (LETIMER) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_letimer.c
include:
- path: inc
  file_list:
  - path: sl_hal_letimer.h
provides:
- name: hal_letimer
- name: hal_generic_letimer
  condition: [device_series_3]
requires:
- name: device
- name: device_has_letimer
- name: hal_common
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/letimer
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/letimer
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/letimer
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/letimer
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/letimer
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/letimer
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/letimer
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/letimer
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/letimer
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/letimer
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
