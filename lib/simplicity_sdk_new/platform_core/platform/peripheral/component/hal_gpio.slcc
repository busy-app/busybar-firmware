# This HAL applies to series 2 and 3 devices.
id: hal_gpio
label: GPIO
package: platform_core
description: >
  General Purpose Input Output (GPIO) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_gpio.c
include:
- path: inc
  file_list:
  - path: sl_hal_gpio.h
provides:
- name: hal_gpio
  condition: [device_has_gpio]
- name: hal_generic_gpio
  condition: [device_series_3]
requires:
- name: device
- name: device_has_gpio
- name: hal_common
- name: device_gpio
- name: cmsis_core
- name: component_catalog
- name: code_classification
template_contribution:
- name: component_catalog
  value: gpio
- name: code_classification_components
  value: hal_gpio
define:
- name: SL_CODE_COMPONENT_HAL_GPIO
  value: hal_gpio
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/gpio
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/gpio
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/gpio
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/gpio
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/gpio
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/gpio
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/gpio
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/gpio
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/gpio
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/gpio
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
