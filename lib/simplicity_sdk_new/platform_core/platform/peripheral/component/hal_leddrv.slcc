# This HAL applies only to series 3 devices.
id: hal_leddrv
label: LEDDRV
package: platform_core
description: >
  LEDDRV peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_leddrv.c
include:
- path: inc
  file_list:
  - path: sl_hal_leddrv.h
provides:
- name: hal_leddrv
requires:
- name: device
- name: device_has_leddrv
- name: device_series_3
- name: hal_common
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-sixg301/leddrv
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
