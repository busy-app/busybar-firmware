# This HAL applies to series 2 devices.
id: hal_lcd
label: LCD
package: platform_core
description: >
  Liquid Crystal Display (LCD) peripheral API.
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_lcd.c
include:
- path: inc
  file_list:
  - path: sl_hal_lcd.h
provides:
- name: hal_lcd
requires:
- name: device
- name: device_has_lcd
- name: cmsis_core
- name: enum
- name: device_gpio
- name: hal_common
conflicts:
- name: device_series_3
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg23/lcd
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg26/lcd
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg28/lcd
    condition: [device_sdid_235]
root_path: platform_core/platform/peripheral
