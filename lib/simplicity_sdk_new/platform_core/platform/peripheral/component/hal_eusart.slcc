# This HAL applies to series 2 and 3 devices.
id: hal_eusart
label: EUSART
package: platform_core
description: >
  Universal asynchronous receiver/transmitter (EUSART) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_eusart.c
include:
- path: inc
  file_list:
  - path: sl_hal_eusart.h
provides:
- name: hal_eusart
- name: hal_generic_eusart
  condition: [device_series_3]
requires:
- name: device
- name: device_has_euart
- name: hal_common
- name: hal_prs
  condition: [device_cortexm]
- name: cmsis_core
  condition: [device_cortexm]
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg22/eusart
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/eusart
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/eusart
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/eusart
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/eusart
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/eusart
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/eusart
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/eusart
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/eusart
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
