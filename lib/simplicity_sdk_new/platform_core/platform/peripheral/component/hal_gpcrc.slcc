# This HAL applies to series 2 and 3 devices.
id: hal_gpcrc
label: GPCRC
package: platform_core
description: >
  General Purpose Cyclic Redundancy Check (GPCRC) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_gpcrc.c
include:
- path: inc
  file_list:
  - path: sl_hal_gpcrc.h
provides:
- name: hal_gpcrc
- name: hal_generic_gpcrc
  condition: [device_series_3]
requires:
- name: device
- name: device_has_gpcrc
- name: hal_common
- name: cmsis_core
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/gpcrc
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/gpcrc
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/gpcrc
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/gpcrc
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/gpcrc
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/gpcrc
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/gpcrc
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/gpcrc
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/gpcrc
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/gpcrc
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
