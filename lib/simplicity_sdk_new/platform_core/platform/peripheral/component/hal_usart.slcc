# This HAL applies only to series 2 devices.
id: hal_usart
label: USART
package: platform_core
description: >
  Universal synchronous/asynchronous receiver/transmitter (USART/UART) peripheral API
category: Platform|Peripheral
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: "src/sl_hal_usart.c"
include:
- path: "inc"
  file_list:
  - path: "sl_hal_usart.h"
provides:
- name: hal_usart
- name: hal_generic_usart
  condition: [device_series_3]
requires:
- name: device
- name: device_has_uart
- name: hal_common
- name: hal_prs
- name: cmsis_core
  condition: [device_cortexm]
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/usart
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/usart
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/usart
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/usart
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg26/usart
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/usart
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/usart
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/usart
    condition: [device_sdid_240]
root_path: platform_core/platform/peripheral
