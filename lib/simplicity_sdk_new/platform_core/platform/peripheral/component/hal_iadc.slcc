id: hal_iadc
# This HAL applies only to series 2 devices.
label: IADC
package: platform_core
description: >
  Incremental Analog to Digital Converter (IADC) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: "src/sl_hal_iadc.c"
include:
- path: "inc"
  file_list:
  - path: "sl_hal_iadc.h"
provides:
- name: hal_iadc
- name: hal_generic_iadc
requires:
- name: device
- name: device_has_iadc
- name: hal_common
- name: hal_gpio
- name: cmsis_core
- name: hal_system
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/iadc
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/iadc
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/iadc
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/iadc
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/iadc
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/iadc
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg27/iadc
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/iadc
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/iadc
    condition: [device_sdid_240]
root_path: platform_core/platform/peripheral
