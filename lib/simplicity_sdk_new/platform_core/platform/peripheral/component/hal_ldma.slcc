# This HAL applies to series 2 and 3 devices.
id: hal_ldma
label: LDMA
package: platform_core
description: >
  Linked Direct Memory Access (LDMA) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_ldma.c
include:
- path: inc
  file_list:
  - path: sl_hal_ldma.h
provides:
- name: hal_ldma
- name: hal_generic_ldma
  condition: [device_series_3]
requires:
- name: device
- name: device_has_ldma
- name: hal_common
- name: cmsis_core
- name: enum
- name: code_classification
template_contribution:
- name: code_classification_components
  value: hal_ldma
define:
- name: SL_CODE_COMPONENT_HAL_LDMA
  value: hal_ldma
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/ldma
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/ldma
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg23/ldma
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/ldma
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/ldma
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg27/ldma
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg28/ldma
    condition: [device_sdid_235]
  - page: platform-peripheral-efr32xg29/ldma
    condition: [device_sdid_240]
  - page: platform-peripheral-sixg301/ldma
    condition: [device_generic_family_sixx301]
root_path: platform_core/platform/peripheral
