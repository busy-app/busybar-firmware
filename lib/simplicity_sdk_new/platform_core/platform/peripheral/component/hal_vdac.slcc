  document:
  - page: platform-peripheral-efr32xg23/vdac
    condition: [device_sdid_210]
  - page: platform-peripheral-efr32xg24/vdac
    condition: [device_sdid_215]
  - page: platform-peripheral-efr32xg25/vdac
    condition: [device_sdid_220]
  - page: platform-peripheral-efr32xg26/vdac
    condition: [device_sdid_225]
  - page: platform-peripheral-efr32xg28/vdac
    condition: [device_sdid_235]
root_path: platform_core/platform/peripheral
