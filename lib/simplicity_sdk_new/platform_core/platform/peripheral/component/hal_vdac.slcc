# This HAL applies to series 2 and 3 devices.
id: hal_vdac
label: VDAC
package: platform_core
description: >
  Digital to Analog Converter (VDAC) Peripheral API.
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/sl_hal_vdac.c
include:
