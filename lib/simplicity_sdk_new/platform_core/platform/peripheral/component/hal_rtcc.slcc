# This HAL applies only to series 2 devices.
id: hal_rtcc
label: RTCC
package: platform_core
description: >
  Real Time Counter(RTCC) peripheral API
category: Platform|Peripheral|HAL
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: "src/sl_hal_rtcc.c"
include:
- path: "inc"
  file_list:
  - path: "sl_hal_rtcc.h"
provides:
- name: hal_rtcc
requires:
- name: device
- name: device_has_rtcc
- name: hal_common
- name: cmsis_core
- name: enum
documentation:
  docset: gecko-platform
  document:
  - page: platform-peripheral-efr32xg21/rtcc
    condition: [device_sdid_200]
  - page: platform-peripheral-efr32xg22/rtcc
    condition: [device_sdid_205]
  - page: platform-peripheral-efr32xg27/rtcc
    condition: [device_sdid_230]
  - page: platform-peripheral-efr32xg29/rtcc
    condition: [device_sdid_240]
root_path: platform_core/platform/peripheral
