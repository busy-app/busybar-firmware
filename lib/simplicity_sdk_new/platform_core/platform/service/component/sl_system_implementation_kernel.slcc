id: sl_system_implementation_kernel
label: System Setup kernel implementation (sl_system)
package: platform_core
category: Services|System Setup
ui_hints:
  visibility: never
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: sl_system_implementation_kernel
- name: sl_system_implementation
requires:
- name: interrupt_manager
  condition: [device_efx]
- name: device_init_core
  condition: [device_series_2]
- name: sl_system_kernel
- name: sl_system_init
- name: component_catalog
- name: kernel
- name: custom_main
conflicts:
- name: sl_main
documentation:
  docset: gecko-platform
  document: platform-service/system
description: |-
  The System Setup component provides a set of events that can be used by
  other components to register handlers that should be run when the system
  is initialized and is running. For a detailed list of the handlers that can be
  registered using the Event Handler API and a usage example, please refer to 
  the documentation.

  This component was replaced by System Setup Compatibility Layer for baremetal
  applications. This component now only supports applications using an RTOS
  and is deprecated. Replace this component with sl_main by sisdk-2026.6.
root_path: platform_core
