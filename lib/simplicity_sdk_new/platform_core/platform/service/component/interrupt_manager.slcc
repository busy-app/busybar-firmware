id: interrupt_manager
label: Interrupt Manager
package: platform_core
description: >
  This component provides different APIs to manage embedded interrupts.
  It allows devices to set the affinity of an interrupt, to enable/disable interrupts, set priority
  and copy the vector table in RAM.
category: Services|Interrupt Manager
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/service/interrupt_manager
include:
- path: inc
  file_list:
  - path: sl_interrupt_manager.h
- path: src
  file_list:
  - path: sli_interrupt_manager.h
provides:
- name: interrupt_manager
requires:
- name: interrupt_manager_arch
- name: device
- name: sl_assert
- name: sl_core
- name: status
- name: cmsis_core
- name: component_catalog
- name: interrupt_manager_vector_table_in_ram
  condition: [device_series_3]
template_contribution:
- name: component_catalog
  value: interrupt_manager
- name: event_handler
  value:
    event: platform_init
    include: sl_interrupt_manager.h
    handler: sl_interrupt_manager_init
  priority: -9998
  condition: [sl_system, kernel]
- name: code_classification_components
  value: interrupt_manager
define:
- name: SL_CODE_COMPONENT_INTERRUPT_MANAGER
  value: interrupt_manager
