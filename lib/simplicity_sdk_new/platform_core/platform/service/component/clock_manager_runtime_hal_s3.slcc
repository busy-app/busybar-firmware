package: platform_core
description: >
  Series 3 HAL for Clock Manager Runtime part
category: Services|Clock Manager
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
provides:
- name: clock_manager_runtime_hal
  condition: [device_generic_family_sixx301]
