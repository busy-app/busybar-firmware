id: iostream_rtt
package: platform_core
label: 'IO Stream: RTT'
description: >
  Instantiate the driver for using IO Stream over the SEGGER
  Real-Time Transfer (RTT) peripheral.
category: Services|IO Stream|Driver
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/service/iostream
provides:
- name: iostream_rtt
- name: iostream_transport
  allow_multiple: true
- name: iostream_console_support
  allow_multiple: true
requires:
- name: segger_rtt
- name: iostream
include:
- path: inc
  file_list:
  - path: sl_iostream_rtt.h
source:
- path: src/sl_iostream_rtt.c
template_contribution:
- name: iostream_instances
  value: rtt
- name: iostream_handles
  value: rtt
- name: event_handler
  value:
    event: iostream_instance_init_stage_1
    include: sl_iostream_rtt.h
    handler: sl_iostream_rtt_init
- name: iostream_instance_info
  value:
    include: sl_iostream_rtt.h
    handler: sl_iostream_instance_rtt_info
documentation:
  docset: gecko-platform
  document: platform-service/iostream-rtt
