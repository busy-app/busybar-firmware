id: iostream_debug
package: platform_core
label: IO Stream debug
description: Instantiate the driver for using IO Stream over the Single Wire Output (SWO) Stimulus 8 debug peripheral.
category: Services|IO Stream|Driver
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/service/iostream
provides:
- name: iostream_debug
- name: iostream_transport
  allow_multiple: true
- name: iostream_debug_support
  allow_multiple: true
requires:
- name: iostream
- name: debug_swo
- name: atomic
include:
- path: inc
  file_list:
  - path: sl_iostream_debug.h
  - path: sli_iostream_swo_itm_8.h
  - path: sl_iostream_swo_itm_8.h
source:
- path: src/sl_iostream_debug.c
- path: src/sl_iostream_swo_itm_8.c
template_contribution:
- name: event_handler
  value:
    event: iostream_instance_init_stage_1
    include: sl_iostream_debug.h
    handler: sl_iostream_debug_init
- name: iostream_instance_info
  value:
    include: sl_iostream_debug.h
    handler: sl_iostream_instance_debug_info
