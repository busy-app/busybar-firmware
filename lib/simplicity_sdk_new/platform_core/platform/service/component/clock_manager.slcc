source:
- path: src/sl_clock_manager_init.c
include:
- path: inc
  file_list:
  - path: sl_clock_manager_init.h
- path: src
  file_list:
  - path: sli_clock_manager_init_hal.h
define:
  # The Auto-Band feature requires the existence of a radio configuration file.
  # If this symbol is not defined, Auto-Band will be ignored and 9xx band used.
- name: SL_CLOCK_MANAGER_AUTO_BAND_VALID
  value: '1'
  condition:
  - a_radio_config
- name: SL_CLOCK_MANAGER_HFXO_STARTUP_TIME_MEASUREMENT_EN
  value: '1'
  condition:
  - device_series_3
  - power_manager
- name: SL_CLOCK_MANAGER_HFXO_STARTUP_TIME_DEFAULT_VALUE
  value: '22'
  condition:
  - device_series_3
  - power_manager
- name: SL_CLOCK_MANAGER_HFXO_STARTUP_TIME_MEASUREMENTS
  value: HFXO_CFG_NUMSTUPMEAS_MEASURE8
  condition:
  - device_series_3
  - power_manager
- name: SL_CLOCK_MANAGER_HFXO0LFCLK_SOURCE
  value: CMU_HFXO0LFCLKCTRL_CLKSEL_LFRCO
  condition:
  - device_series_3
  - power_manager
template_contribution:
- name: component_catalog
  value: clock_manager
- name: event_handler
  value:
    event: platform_init
    include: sl_clock_manager_init.h
    handler: sl_clock_manager_init
  priority: -9800
  condition: [sl_system, kernel]
- name: component_catalog
  value: clock_manager_ext_flash
  condition: [device_has_ext_mem]
validation_helper:
- path: clock_manager_validation.lua
  condition: [device_series_2]
- path: clock_manager_validation.lua
  condition: [device_generic_family_sixx301]
documentation:
  docset: gecko-platform
  document: platform-service/clock-manager
