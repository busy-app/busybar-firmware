  file_id: clock_manager_oscillator_config
  condition: [device_family_efr32fg22]
- path: config/EFX32XG22/38M/sl_clock_manager_oscillator_config.h
  file_id: clock_manager_oscillator_config
  condition: [efr32bg22c112f352gm32]
- path: config/EFX32XG22/38M/sl_clock_manager_oscillator_config.h
