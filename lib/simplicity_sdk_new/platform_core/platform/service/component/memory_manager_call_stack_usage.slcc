id: memory_manager_call_stack_usage
label: Memory manager call stack usage statistics
package: platform_core
description: >
  Instrument and calculate the call stack usage of an application.
  Incompatible with RTOS environments as each task has its own stack.
category: Services|Memory Manager
quality: evaluation
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/service/memory_manager
include:
- path: inc
  file_list:
  - path: slx_memory_manager_call_stack_usage.h
source:
- path: src/slx_memory_manager_call_stack_usage.c
requires:
- name: memory_manager
- name: device_cortexm
conflicts:
- name: kernel
provides:
- name: memory_manager_call_stack_usage
  condition: [device_cortexm]
template_contribution:
- name: component_catalog
  value: memory_manager_call_stack_usage
