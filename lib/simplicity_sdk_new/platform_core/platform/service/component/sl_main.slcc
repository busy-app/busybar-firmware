id: sl_main
label: System Setup (sl_main)
package: platform_core
category: Services|System Setup
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: sl_main
root_path: platform_core/platform/service/sl_main/
config_file:
- path: config/sl_main_start_task_config.h
  file_id: main_start_task_config
  condition: [kernel]
requires:
- name: interrupt_manager
  condition: [device_efx]
- name: sl_assert
- name: sl_main_init
- name: sl_main_process_action
- name: component_catalog
template_contribution:
- name: component_catalog
  value: sl_main
documentation:
  docset: gecko-platform
  document: platform-service/sl-main
description: |-
  The System Setup (sl_main) component manages the initialization phase of SiSDK embedded
  firmware. This component aggregates, organizes and executes all the different
  steps required for initializing the firmware so that every component in your
  .slcp file and their dependencies are in a ready state for proper execution.
  Application developers may also initialize different parts of their application
  by re-implementing hooks that are called at key points within the sl_main
  initialization sequence.


