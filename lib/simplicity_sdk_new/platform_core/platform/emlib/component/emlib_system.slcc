id: emlib_system
label: SYSTEM
package: platform_core
description: >
  System peripheral API.
category: Platform|Peripheral|EMLIB
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/em_system.c
include:
- path: inc
  file_list:
  - path: em_system.h
  - path: em_system_generic.h
provides:
- name: emlib_system
- name: hal_generic_system
  condition: [device_series_2]
requires:
- name: device
- name: emlib_common
- name: cmsis_core
- name: emlib_syscfg
  condition: [device_has_syscfg]
conflicts:
- name: device_series_3

documentation:
  docset: gecko-platform
  document:
  - page: platform-emlib-efr32xg21/system
    condition: [device_sdid_200]
  - page: platform-emlib-efr32xg22/system
    condition: [device_sdid_205]
  - page: platform-emlib-efr32xg23/system
    condition: [device_sdid_210]
  - page: platform-emlib-efr32xg24/system
    condition: [device_sdid_215]
  - page: platform-emlib-efr32xg25/system
    condition: [device_sdid_220]
  - page: platform-emlib-efr32xg26/system
    condition: [device_sdid_225]
  - page: platform-emlib-efr32xg27/system
    condition: [device_sdid_230]
  - page: platform-emlib-efr32xg28/system
    condition: [device_sdid_235]
  - page: platform-emlib-efr32xg29/system
    condition: [device_sdid_240]
root_path: platform_core/platform/emlib
