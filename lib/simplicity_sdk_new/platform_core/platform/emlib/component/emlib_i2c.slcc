requires:
- name: device
- name: device_has_i2c
- name: emlib_common
- name: cmsis_core
conflicts:
- name: device_series_3
documentation:
  docset: gecko-platform
  document:
  - page: platform-emlib-efr32xg21/i2c
    condition: [device_sdid_200]
  - page: platform-emlib-efr32xg22/i2c
    condition: [device_sdid_205]
  - page: platform-emlib-efr32xg23/i2c
    condition: [device_sdid_210]
  - page: platform-emlib-efr32xg24/i2c
    condition: [device_sdid_215]
  - page: platform-emlib-efr32xg25/i2c
    condition: [device_sdid_220]
  - page: platform-emlib-efr32xg26/i2c
    condition: [device_sdid_225]
  - page: platform-emlib-efr32xg27/i2c
    condition: [device_sdid_230]
  - page: platform-emlib-efr32xg28/i2c
    condition: [device_sdid_235]
  - page: platform-emlib-efr32xg29/i2c
    condition: [device_sdid_240]
root_path: platform_core/platform/emlib
