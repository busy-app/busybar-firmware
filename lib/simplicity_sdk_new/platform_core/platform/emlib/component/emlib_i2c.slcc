id: emlib_i2c
label: I2C
package: platform_core
description: >
  Inter-integrated Circuit (I2C) peripheral API.
category: Platform|Peripheral|EMLIB
quality: production
metadata:
  sbom:
    license: Zlib
source:
- path: src/em_i2c.c
include:
- path: inc
  file_list:
  - path: em_i2c.h
provides:
- name: emlib_i2c
- name: hal_generic_i2c
