id: emlib_core
label: CORE
package: platform_core
description: >
  API for critical and atomic sections.
category: Platform|Peripheral|EMLIB
quality: production
metadata:
  sbom:
    license: Zlib
include:
- path: inc
  file_list:
  - path: em_core.h
  - path: em_core_generic.h
  unless: [device_host]
- path: host/inc
  condition: [device_host]
  file_list:
  - path: em_core.h
  - path: em_core_generic.h
    condition: [device_host]
provides:
- name: emlib_core
requires:
- name: device
  condition: [device_cortexm]
- name: hal_generic_common
  condition: [device_cortexm]
- name: cmsis_core
  condition: [device_cortexm]
- name: sl_core
conflicts:
- name: device_series_3
template_contribution:
- name: component_catalog
  value: emlib_core
root_path: platform_core/platform/emlib
