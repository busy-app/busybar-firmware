id: cycle_counter
package: platform_core
label: Cycle Counter
description: >
  Data Watchpoint and Trace (DWT) cycle counter is a platform module that initializes
  the DWT hardware and allows to count execution cycles via a simple API.
category: Platform|Driver
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/cycle_counter
include:
- path: inc
  file_list:
  - path: sl_cycle_counter.h
source:
- path: src/sl_cycle_counter.c
requires:
- name: status
- name: device_has_dwt
provides:
- name: cycle_counter
template_contribution:
- name: event_handler
  value:
    event: driver_init
    include: sl_cycle_counter.h
    handler: sl_cycle_counter_enable
  priority: -20
- name: component_catalog
  value: cycle_counter
