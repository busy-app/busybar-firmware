id: coulomb_counter_efp
package: platform_core
label: Coulomb Counter EFP
description: Coulomb Counter EFP driver.
category: Platform|Driver
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/platform/driver/coulomb
source:
- path: src/sl_coulomb_counter_hal_efp.c
- path: src/sli_coulomb_counter_hal.h
include:
- path: inc
  file_list:
  - path: sl_coulomb_counter.h
requires:
- name: efp_driver
- name: slist
provides:
- name: coulomb_counter_driver_implementation
- name: coulomb_counter_efp
config_file:
- path: config/efp/sl_coulomb_counter_config.h
  file_id: sl_coulomb_counter_config
documentation:
  docset: gecko-platform
  document: platform-driver/coulomb-counter
