id: configuration_over_swo
package: platform_core
label: Configuration Over SWO
description: Configuration over SWO (COS) Component. Note that installing of this component would consume ~0.3ms additional startup time.
category: Platform|Board Drivers
quality: production
metadata:
  sbom:
    license: Zlib
root_path: platform_core/hardware/driver/configuration_over_swo
provides:
- name: configuration_over_swo
requires:
- name: status
- name: enum
- name: debug_swo
include:
- path: inc
  file_list:
  - path: sl_cos.h
source:
- path: src/sl_cos.c
template_contribution:
- name: event_handler
  value:
    event: driver_init
    include: sl_cos.h
    handler: sl_cos_send_config
  priority: 9999
documentation:
  docset: gecko-platform
  document: platform-hardware-driver/cos


