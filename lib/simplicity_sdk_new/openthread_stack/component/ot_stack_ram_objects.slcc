id: ot_stack_ram_objects
label: Stack (Common)
package: openthread_stack
category: OpenThread
quality: production
description: This component selects OpenThread common stack objects to be placed in RAM.
provides:
- name: ot_stack_ram_objects
metadata:
  sbom:
    reference: ot_sbom_openthread
ui_hints:
  visibility: never

template_contribution:
- name: third_party_ram_objects
  unless: [toolchain_lto]
    # src/core/diags/factory_diags.cpp
  value: factory_diags
- name: third_party_ram_objects
  unless: [toolchain_lto]
    # src/core/thread/link_metrics.cpp
  value: link_metrics
- name: third_party_ram_objects
  unless: [toolchain_lto]
    # src/core/mac/mac.cpp
  value: mac
- name: code_classification_components
  condition: [toolchain_lto]
  value: openthread

include:
- path: include
  condition: [toolchain_lto, device_series_3]
  file_list:
  - path: sl_ot_code_classification_factory_diags.hpp
  - path: sl_ot_code_classification_link_metrics.hpp
  - path: sl_ot_code_classification_mac.hpp

define:
- name: SL_CODE_COMPONENT_OPENTHREAD
  value: openthread

requires:
- name: code_classification
- name: ot_headers

toolchain_settings:
- option: gcc_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_factory_diags.hpp"
- option: gcc_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_link_metrics.hpp"
- option: gcc_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_mac.hpp"
- option: llvm_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_factory_diags.hpp"
- option: llvm_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_link_metrics.hpp"
- option: llvm_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  unless: [ot_skip_code_classification]
  value: "-include sl_ot_code_classification_mac.hpp"
root_path: openthread_stack
