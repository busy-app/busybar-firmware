id: ot_ncp_spinel
label: NCP Spinel Library
package: openthread_stack
category: OpenThread
quality: production
description: This component provides the Spinel protocol library for both NCP and RCP implementations.
provides:
- name: ot_ncp_spinel
  # Exclude this component from code classification to prevent macro name conflicts
- name: ot_skip_code_classification
requires:
- name: ot_headers

root_path: openthread_stack/util/third_party/openthread/src

include:
- path: lib/spinel
  file_list:
  - path: coprocessor_type.h
  - path: logger.hpp
  - path: multi_frame_buffer.hpp
  - path: radio_spinel.hpp
  - path: radio_spinel_metrics.h
  - path: spi_frame.hpp
  - path: spinel.h
  - path: spinel_buffer.hpp
  - path: spinel_decoder.hpp
  - path: spinel_driver.hpp
  - path: spinel_encoder.hpp
  - path: spinel_encrypter.hpp
  - path: spinel_helper.hpp
  - path: spinel_interface.hpp
  - path: spinel_platform.h
  - path: spinel_prop_codec.hpp
  - path: openthread-spinel-config.h

source:
- path: lib/spinel/logger.cpp
- path: lib/spinel/radio_spinel.cpp
- path: lib/spinel/spinel.c
- path: lib/spinel/spinel_buffer.cpp
- path: lib/spinel/spinel_decoder.cpp
- path: lib/spinel/spinel_driver.cpp
- path: lib/spinel/spinel_encoder.cpp
- path: lib/spinel/spinel_helper.cpp
- path: lib/spinel/spinel_prop_codec.cpp

define:
- name: SPINEL_PLATFORM_HEADER
  value: '"spinel_platform.h"'
- name: OPENTHREAD_PROJECT_LIB_CONFIG_FILE
  value: '"sl_openthread_features_config.h"'
  unless: [ot_stack_ftd, ot_stack_mtd]
- name: OPENTHREAD_PROJECT_LIB_CONFIG_FILE
  value: '"sl_openthread_features_ncp_ftd_config.h"'
  condition: [ot_stack_ftd]
- name: OPENTHREAD_PROJECT_LIB_CONFIG_FILE
  value: '"sl_openthread_features_ncp_mtd_config.h"'
  condition: [ot_stack_mtd]

toolchain_settings:
- option: gcc_compiler_option
  value: -fno-strict-aliasing
  condition:
  - toolchain_lto
- option: llvm_compiler_option
  value: -fno-strict-aliasing
  condition:
  - toolchain_lto

template_contribution:
- name: component_catalog
  value: ot_ncp_spinel

metadata:
  sbom:
    reference: ot_sbom_openthread
