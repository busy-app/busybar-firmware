id: ot_radio_ram_objects
label: Radio
package: openthread_stack
category: OpenThread
quality: production
description: This component selects OpenThread radio-only objects to be placed in RAM.
provides:
- name: ot_radio_ram_objects
metadata:
  sbom:
    reference: ot_sbom_openthread
ui_hints:
  visibility: never

template_contribution:
- name: third_party_ram_objects
  unless: [toolchain_lto]
    # src/core/api/link_raw_api.cpp
  value: link_raw_api
- name: third_party_ram_objects
  unless: [toolchain_lto]
    # src/core/mac/sub_mac.cpp
  value: sub_mac
- name: code_classification_components
  condition: [toolchain_lto]
  value: openthread

include:
- path: include
  condition: [toolchain_lto]
  file_list:
  - path: sl_ot_code_classification_link_raw.hpp
  - path: sl_ot_code_classification_sub_mac.hpp

define:
- name: SL_CODE_COMPONENT_OPENTHREAD
  value: openthread

requires:
- name: code_classification
- name: ot_headers

toolchain_settings:
- option: gcc_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  value: "-include sl_ot_code_classification_link_raw.hpp"
- option: gcc_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  value: "-include sl_ot_code_classification_sub_mac.hpp"
- option: llvm_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  value: "-include sl_ot_code_classification_link_raw.hpp"
- option: llvm_c++_compiler_option
  condition: [toolchain_lto, device_series_3]
  value: "-include sl_ot_code_classification_sub_mac.hpp"
root_path: openthread_stack
