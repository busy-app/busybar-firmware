id: ot_stack_rcp
label: Stack (RCP)
package: openthread
category: OpenThread
quality: production
description: This component provides OpenThread Radio Co-Processor support
provides:
- name: ot_stack
- name: ot_rcp
requires:
- name: ot_ncp
- name: ot_radio
- name: ot_platform_abstraction
- name: ot_mbedtls
recommends:
- id: ot_platform_abstraction
  vendor: silabs
config_file:
- path: config/sl_openthread_features_config.h
include:
- path: include
  file_list:
  - path: sl_openthread_package_info.h
validation_helper:
- path: component/script/ot_log_validation.lua
define:
- name: SL_OPENTHREAD_STACK_FEATURES_CONFIG_FILE
  value: "\"sl_openthread_features_config.h\""
- name: OPENTHREAD_CONFIG_FILE
  value: "\"sl_openthread_package_info.h\""
- name: OPENTHREAD_RADIO
  value: 1
- name: OPENTHREAD_SPINEL_CONFIG_OPENTHREAD_MESSAGE_ENABLE
  value: 0
- name: OPENTHREAD_CONFIG_PLATFORM_KEY_REFERENCES_ENABLE
  value: 0
template_contribution:
- name: component_catalog
  value: openthread_stack_rcp
metadata:
  sbom:
    license: Zlib
root_path: openthread
