id: ot_platform_abstraction
label: Platform Abstraction
package: openthread
category: OpenThread
quality: production
description: This component provides the abstraction layer between the OpenThread stack and Silicon Labs platform. It also adds support for additional features such as Wi-Fi coex and RTOS support
provides:
- name: ot_platform_abstraction
- name: ot_platform_abstraction_efr32
requires:
- name: ot_platform_abstraction_core
- name: cmsis_rtos2
  condition:
  - kernel
- name: fem_util
  condition:
  - custom_board_has_fem
- name: ot_coex
  condition:
  - rail_util_coex
- name: ot_ant_div
  condition:
  - rail_util_ant_div
- name: ot_subghz_board_support
- name: ot_subghz_phy
  condition:
  - hardware_board_supports_ot_subghz
- name: gatt_configuration
  condition:
  - bluetooth_stack

config_file:
- path: config/sl_openthread_rtos_config.h
  condition:
  - kernel
- path: config/sl_openthread_subghz_config.h
  condition:
  - hardware_board_supports_ot_subghz
- path: config/sl_openthread_radio_config.h
  condition:
  - ot_platform_abstraction_source
toolchain_settings:
- option: preinclude
  value: sl_openthread_subghz_config.h
  condition:
  - hardware_board_supports_ot_subghz
include:
- path: platform-abstraction/rtos
  condition:
  - kernel
  file_list:
  - path: sl_ot_rtos_adaptation.h
source:
- path: platform-abstraction/rtos/sl_ot_rtos_adaptation.c
  condition:
  - kernel
library:
- path: build/gcc/cortex-m33/cmake/sl-openthread-library/Release/libsl_openthread.a
  condition:
  - toolchain_gcc
  - cortexm33
  unless:
  - toolchain_llvm
- path: build/llvm/cortex-m33/cmake/sl-openthread-library/Release/libsl_openthread.a
  condition:
  - toolchain_llvm
  - cortexm33
define:
- name: RADIO_CONFIG_DMP_SUPPORT
  value: 1
  condition:
  - rail_lib_multiprotocol
- name: OPENTHREAD_CONFIG_PLATFORM_RADIO_COEX_ENABLE
  value: 1
  condition:
  - rail_util_coex
- name: SL_OPENTHREAD_PHY_SELECT_STACK_SUPPORT
  value: 1
  condition:
  - sl_rail_util_ieee802154_phy_select

template_contribution:
- name: event_handler
  value:
    event: internal_app_init
    include: sl_ot_rtos_adaptation.h
    handler: sl_ot_rtos_stack_init
    priority: 9
  condition:
  - kernel
- name: event_handler
  value:
    event: internal_app_init
    include: sl_ot_rtos_adaptation.h
    handler: sl_ot_rtos_app_init
    priority: 10
  condition:
  - kernel
- name: event_handler
  value:
    event: stack_permanent_allocation
    include: sl_ot_rtos_adaptation.h
    handler: sl_ot_rtos_perm_allocation
  priority: 9
  condition: [sl_main, kernel]
- name: ot_init
  value: sl_ot_create_instance
  priority: 0
metadata:
  sbom:
    # Zlib covers the files from config.
    # MSLA covers libsl_openthread_cm33_gcc.a
    license: Zlib AND MSLA
root_path: openthread
