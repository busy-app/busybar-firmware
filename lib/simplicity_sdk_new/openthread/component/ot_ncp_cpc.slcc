id: ot_ncp_cpc
label: NCP CPC
package: openthread
category: OpenThread
quality: production
description: This component provides Co-Processor Communication (CPC) support over both NCP and RCP for an OpenThread stack. It requires that an OpenThread stack component be included with the project. If no OpenThread stack component is chosen, it will default to using the OpenThread stack for an RCP.
provides:
- name: ot_ncp_cpc
requires:
- name: ot_stack
- name: ot_ncp
- name: ot_ncp_vendor_extension
- name: cpc_secondary
- name: ot_coex
    # For now disable coex on series3 and NCP devices
  condition: [device_series_2, ot_rcp]
- name: sl_rail_util_ieee802154_fast_channel_switching
    # For now disable FCS on NCP devices
  condition: [rail_ieee802154_supports_rx_channel_switching, ot_rcp]
# For concurrent listening on xG26
- name: rail_util_dma
  condition:
  - device_sdid_225
# For concurrent listening on xG24
- name: rail_util_dma
  condition:
  - device_sdid_215
# For concurrent listening on xG21    
- name: rail_util_dma
  condition:
  - device_sdid_200
recommends:
- id: ot_stack_rcp
  vendor: silabs
include:
- path: platform-abstraction/ncp/
  file_list:
  - path: ncp_cpc.hpp
source:
- path: platform-abstraction/ncp/ncp_cpc.cpp
template_contribution:
- name: component_catalog
  value: 15_4_ncp
define:
- name: OPENTHREAD_CONFIG_NCP_HDLC_ENABLE
  value: 0
- name: OPENTHREAD_CONFIG_NCP_CPC_ENABLE
  value: 1
- name: OPENTHREAD_CONFIG_NCP_CPC_TX_CHUNK_SIZE
  value: 2048
validation_helper:
- path: component/script/ot_multipan_config_validation.lua
metadata:
  sbom:
    license: Zlib
root_path: openthread
