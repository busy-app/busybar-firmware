id: bootloader_interface_s2_trustzone
label: Bootloader Application Interface Trustzone for Series 2
package: bootloader_interface_trustzone
description: >
  The Bootloader Application Interface Trustzone component for Series 2
category: Platform|Bootloader
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/api/btl_interface_nsc.c
  condition: [trustzone_secure]
- path: platform/bootloader/api/btl_interface_ns.c
  condition: [trustzone_nonsecure]
provides:
- name: bootloader_interface_s2_trustzone
  condition: [device_series_2]
requires:
- name: tz_ns_interface
  condition: [trustzone_nonsecure]
- name: tz_iovec_check
  condition: [trustzone_secure]
- name: tz_sl_interface
  condition: [trustzone_nonsecure]
- name: sl_fault_injection_hardening
  condition: [trustzone_secure]

metadata:
  sbom:
    license: MSLA
root_path: bootloader_interface_trustzone
