project_name: ot-ncp-ftd-ble-rcp
label: Multiprotocol (OpenThread+BLE) - NCP
package: multiprotocol
description: >
  This multiprotocol Network Co-Processor (NCP) application enables concurrent OpenThread (Full Thread Device) and Bluetooth Low Energy (BLE) connectivity. The OpenThread stack runs on the co-processor (NCP), while BLE operates as a controller, with its host stack running on the main processor. 
  This architecture leverages Silicon Labs multiprotocol capabilities for seamless mesh networking (Thread) and point-to-point wireless communication (BLE). Communication between host and NCP uses the Co-Processor Communication protocol (CPC), acting as a protocol multiplexer and serial transport layer. 
  Host applications connect to the CPC daemon, which in turn connects to the EFR device via UART or EUSART. Refer to *docs.silabs.com Multiprotocol section - Multiprotocol on Linux Solution: Running Thread and Bluetooth Concurrently on a Linux Host with a Multiprotocol Network Co-Processor* for more information on host/co-processor integration and multiprotocol use cases.

category: OpenThread Examples
quality: production

component:
  - id: sl_main
  - id: ot_stack_ftd
  - id: ot_ncp_source
  - id: ot_ncp_cpc
  - id: cpc_secondary_driver_uart_usart
    instance: [vcom]
    condition: [device_series_2]
  - id: cpc_secondary_driver_uart_eusart
    instance: [vcom]
    condition: [device_series_3]
  - id: ot_crash_handler
  - id: rail_util_pti
  - id: bootloader_interface
  - id: freertos
  - id: freertos_heap_3
  - id: bluetooth_hci_cpc
  - id: bluetooth_controller
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_advertiser
  - id: bluetooth_feature_connection_phy_update
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_extended_advertiser
  - id: rail_lib_multiprotocol
  - id: ot_rtt_log
  - id: clock_manager
  - id: ot_reset_utils
  # Platform - Enable LTO for gcc by installing the following component
  - id: toolchain_gcc_lto
  - id: ot_cli_source

include:
  - path: .
    file_list:
    - path: app.h

source:
    - path: app.c

configuration:
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 3
  - name: SL_DEVICE_INIT_LFXO_TIMEOUT
    value: cmuLfxoStartupDelay_4KCycles
    condition: ["device_sdid_200"]
  - name: SL_DEVICE_INIT_LFXO_TIMEOUT
    value: cmuLfxoStartupDelay_4KCycles
    condition: ["device_sdid_205"]
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_CPC_DRV_UART_VCOM_BAUDRATE
    value: 115200
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition: [cpc_secondary_driver_uart_usart]
  - name: SL_CPC_DRV_UART_VCOM_FLOW_CONTROL_TYPE
    value: eusartHwFlowControlCtsAndRts
    condition: [cpc_secondary_driver_uart_eusart]
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_PLATFORM_DEFINED
    condition: [ot_rtt_log]
  - name: BUFFER_SIZE_UP
    value: 768
    condition: [ot_rtt_log]
  # This stack size is dependent on LTO optimization. In the cases, where LTO merges more than 1 functions in a single one
  # (includes inlining) causing the stack to increase. This project wide configuration, it is recommended to ensure this
  # configuration is updated with appropriate values based on the additional components installed and application code added.
  - name: SL_STACK_SIZE
    value: 6144
    condition: [toolchain_lto]
    unless: [freertos]
  - name: SL_STACK_SIZE
    value: 4608
    condition: [freertos]
    unless: [toolchain_lto]
  - name: SL_STACK_SIZE
    value: 5120
    condition: [toolchain_lto, freertos]
  - name: SL_STACK_SIZE
    value: 5120
    unless: [toolchain_lto, freertos]
  # Stack size config end
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 4608
    condition: [sl_main,freertos]
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 5120
    condition: [sl_main]
    unless: [freertos]
  - name: BUFFER_SIZE_DOWN
    value: 0
    condition: [ot_rtt_log]
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition: [iostream_usart]
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition: [iostream_eusart]
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 15
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 15
  - name: SL_OPENTHREAD_STACK_TASK_MEM_SIZE
    value: 7168
    condition: [toolchain_lto]
  - name: configTOTAL_HEAP_SIZE
    value: 16384
    condition: [toolchain_lto, freertos]
  - name: SL_BT_CONTROLLER_BUFFER_MEMORY
    value: 1024
    condition: [device_generic_family_efr32xg21]
  - name: SL_BTCTRL_RTOS_LINK_LAYER_TASK_STACK_SIZE
    value: 1100
    condition: [toolchain_lto, freertos]
    unless: [device_series_3]

define:
  - name: OPENTHREAD_CONFIG_RADIO_LINK_TREL_ENABLE
    value: 0
  # TODO: Uncomment this if enabling TREL above for ot-ncp-ftd-ble-rcp
  # due to a PSA issue with HKDF operations
  # - name: OPENTHREAD_CONFIG_PLATFORM_KEY_REFERENCES_ENABLE
  #  value: 0

template_contribution:
  - name: component_catalog
    value: bluetooth_ncp

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_supports_thread
  - hwfilter:!device:device_family_efr32mr21
  - toolchain:gcc

readme:
  - path: ./README-OT-NCP-BLE-RCP.md

filter:
  - name: "Wireless Technology"
    value: ["Thread", "Bluetooth"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Capability"
    value: ["Multiprotocol"]
  - name: "Project Difficulty"
    value: ["Advanced"]

ui_hints:
  highlight:
    - path: ./README-OT-NCP-BLE-RCP.md
      focus: true
