project_name: zigbee_ncp_ot_rcp_uart_gp_multi_rail
label: Zigbee - Zigbee NCP + OpenThread RCP + GP multi RAIL over UART link
package: multiprotocol
category: Zigbee Application
quality: production
description: This network co-processor (NCP) application supports concurrent multiprotocol (CMP) operation, running the Zigbee NCP alongside the OpenThread RCP. Communication with host applications is enabled using the Co-Processor Communication Protocol (CPC), which acts as a protocol multiplexer and serial transport layer. Host applications connect to the CPC daemon, which interfaces with the EFR via a UART link. The application integrates the multiple RAIL demo component (multirail-demo), enabling the use of a second RAIL handle to schedule pre-configured outgoing Green Power device frames (GPDF) in response to incoming bidirectional GPDFs with the rx-after-tx bit set. The Zigbee NCP can be built as configured or optionally extended with custom initialization, main loop processing, event handling, and host messaging features.

component:
  - id: sl_main
  - id: cpc_secondary
  - id: cpc_secondary_recommended_uart_interface
  - id: zigbee_debug_print
  - id: iostream_vuart
  - id: zigbee_pro_stack
  - id: zigbee_source_route
  - id: zigbee_gp
  - id: zigbee_r22_support
  - id: zigbee_security_link_keys
  - id: zigbee_zll
  - id: zigbee_system_common
  - id: zigbee_ncp_cpc
  - id: zigbee_debug_basic
  - id: zigbee_debug_extended
  - id: zigbee_multirail_demo
  - id: rail_mux
  - id: zigbee_xncp
  - id: clock_manager
  - id: zigbee_green_power_client
  - id: zigbee_green_power_server
  - id: zigbee_green_power_translation_table
  - id: zigbee_green_power_common
  - id: zigbee_green_power_adapter
  - id: zigbee_af_support
  - id: zigbee_green_power_combo_zap_config
  - id: zigbee_token_interface
  - id: ot_stack_rcp
  - id: ot_ncp_cpc
  - id: ot_rtt_log
  - id: rail_util_pti
  - id: bootloader_interface
  # Platform - enable LTO for gcc
  - id: toolchain_gcc_lto

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition:
      - iostream_eusart
  - name: SL_CLI_MAX_INPUT_ARGUMENTS
    value: 16
  - name: SL_ZIGBEE_BINDING_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_MAX_END_DEVICE_CHILDREN
    value: 32
  - name: SL_ZIGBEE_PACKET_BUFFER_HEAP_SIZE
    value: SL_ZIGBEE_LARGE_PACKET_BUFFER_HEAP
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 10
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 10
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: 0
  - name: EMBER_AF_PLUGIN_ZIGBEE_PRO_STACK_CHILD_TABLE_SIZE
    value: 32
  - name: SL_ZIGBEE_KEY_TABLE_SIZE
    value: 20
  - name: SL_CLI_EXAMPLE_IOSTREAM_HANDLE
    value: sl_iostream_vuart_handle
  - name: SL_ZIGBEE_GP_SINK_TABLE_SIZE
    value: 25
  - name: SL_ZIGBEE_GP_PROXY_TABLE_SIZE
    value: 25
  - name: SL_ZIGBEE_GP_INCOMING_FC_IN_SINK_TOKEN_TABLE_SIZE
    value: 25
#  - name: EMBER_AF_PLUGIN_NVM3_USER_REPACK_HEADROOM
#    value: 1
#  - name: EMBER_AF_PLUGIN_NVM3_CACHE_SIZE
#    value: 1000
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  - name: NVM3_DEFAULT_CACHE_SIZE
    value: 1000
  - name: SL_ZIGBEE_BROADCAST_TABLE_SIZE
    value: 21
  - name: SL_STACK_SIZE
    value: 3584
    condition:
      - micriumos_kernel
  - name: SL_STACK_SIZE
    value: 4096
    condition:
      - freertos
  - name: SL_ZIGBEE_OS_STACK_TASK_PRIORITY
    value: osPriorityNormal1
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_ADAPTER_USE_CUSTOM_ATTRIBUTE_SYSTEM
    value: 0
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_ADAPTER_USE_CUSTOM_GP_STACK
    value: 0
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_ADAPTER_USE_CUSTOM_AF_INTERFACE
    value: 0
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_ADAPTER_USE_CUSTOM_TOKEN_SYSTEM
    value: 0
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_ADAPTER_USE_CUSTOM_EVENT_SYSTEM
    value: 0
  - name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
    value: 0
  - name: OPENTHREAD_CONFIG_BORDER_AGENT_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_BORDER_ROUTER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COAP_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COAP_OBSERVE_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COAP_SECURE_API_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_COMMISSIONER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_DHCP6_CLIENT_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_DHCP6_SERVER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_DNSSD_SERVER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_JOINER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_REFERENCE_DEVICE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_SRP_SERVER_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_TMF_NETDATA_SERVICE_ENABLE
    value: 1
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_PLATFORM_DEFINED
  - name: OPENTHREAD_CONFIG_PLATFORM_KEY_REFERENCES_ENABLE
    value: 0
  - name: SL_LEGACY_HAL_WDOG_PERIOD
    value: wdogPeriod_256k
  - name: configTIMER_TASK_PRIORITY
    value: 53
  - name: configMAX_TASK_NAME_LEN
    value: 30
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16 # Should be >= OT radio rx buffer count.
  - name: SL_ZIGBEE_STACK_RTOS_TASK_STACK_SIZE
    value: 4096
  - name: SL_ZIGBEE_AF_PLUGIN_GREEN_POWER_TRANSLATION_TABLE_CUSTOMIZED_GPD_TRANSLATION_TABLE_SIZE
    value: 5

source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app.c

define:
  - name: SL_ZIGBEE_CUSTOM_MAC_FILTER_TABLE_SIZE
    value: 15
  - name: OS_CFG_COMPAT_INIT

readme:
  - path: ./readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: false

filter:
  - name: Wireless Technology
    value: [Zigbee, Thread]
  - name: Device Type
    value: [NCP, RCP]
  - name: Capability
    value: [Multiprotocol]
  - name: Project Difficulty
    value: [Advanced]
tag:
  - hardware:device:ram:96
  - hwfilter:device:device_supports_zigbee
  - hwfilter:device:device_supports_thread
  - hwfilter:!device:rm21z000f1024im32
  - hwfilter:!device:device_family_mgm22
  - hwfilter:ram:96k
  - toolchain:gcc
