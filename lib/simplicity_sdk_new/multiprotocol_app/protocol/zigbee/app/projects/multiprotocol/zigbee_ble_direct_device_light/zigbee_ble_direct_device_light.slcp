project_name: zigbee_ble_direct_device_light
label: Zigbee BLE - DirectDeviceLight
package: multiprotocol
category: Zigbee Application
quality: production
description: This is a sample application demonstrating a Zigbee Direct Device (ZDD) as part of a light application using dynamic multiprotocol (Zigbee + Bluetooth LE) and NVM3 for persistent storage.
author: Silicon Laboratories, Inc.

component:
  - id: sl_main
  - id: cli
    instance:
      - example
  - id: zigbee_debug_print
  - id: iostream_recommended_console
  - id: zigbee_debug_basic
  - id: zigbee_pro_stack_non_default_mac
  - id: zigbee_source_route
  - id: zigbee_stack_diagnostics
  - id: bluetooth_stack
  - id: gatt_configuration
  - id: bluetooth_feature_system
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: zigbee_gp
  - id: zigbee_zll
  - id: zigbee_zcl_framework_core
  - id: zigbee_zcl_cli
  - id: zigbee_core_cli
  - id: zigbee_application_bootloader
  - id: zigbee_groups_server
  - id: zigbee_identify
  - id: zigbee_on_off
  - id: zigbee_zll_on_off_server
  - id: zigbee_counters
  - id: zigbee_find_and_bind_target
  - id: zigbee_green_power_common
  - id: zigbee_green_power_client
  - id: zigbee_interpan
  - id: zigbee_zll_commissioning_common
  - id: zigbee_zll_commissioning_server
  - id: zigbee_concentrator
  - id: zigbee_address_table
  - id: zigbee_network_creator
  - id: zigbee_network_creator_security
  - id: zigbee_network_steering
  - id: zigbee_reporting
  - id: zigbee_zll_identify_server
  - id: zigbee_scenes
  - id: zigbee_zll_scenes_server
  - id: zigbee_basic
  - id: zigbee_zll_utility_server
  - id: zigbee_scan_dispatch
  - id: zigbee_security_link_keys
  - id: zigbee_direct_zdd
  - id: zigbee_direct_security_p256
  - id: zigbee_direct_security_curve25519
  - id: zigbee_direct_tunneling
  - id: zigbee_direct_cli
  - id: simple_led
    instance:
      - led0
      - led1
  - id: simple_button
    instance:
      - btn0
      - btn1
  - id: zigbee_display
    condition:
      - hardware_board_supports_wstk_lcd
  - id: clock_manager
  # Platform - enable LTO for gcc
  - id: toolchain_gcc_lto

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlCtsAndRts
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS
    condition:
      - iostream_eusart
  - name: SL_CLI_MAX_INPUT_ARGUMENTS
    value: 16
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE
    value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_COORDINATOR_OR_ROUTER
  - name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE
    value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 1
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 1
    condition:
      - iostream_eusart
  - name: SL_CLI_PROMPT_STRING
    value: "\"ZDDLight>\""
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 1
  - name: SL_BT_CONFIG_MAX_CONNECTIONS
    value: 1
  - name: SL_STACK_SIZE
    value: 1024
    condition:
      - freertos
      - device_series_2
  - name: SL_STACK_SIZE
    value: 16384
    condition:
      - device_series_3
  - name: SL_STACK_SIZE
    value: 512
    condition:
      - micriumos_kernel
      - device_series_2
  - name: SL_ZIGBEE_APP_FRAMEWORK_RTOS_TASK_STACK_SIZE
    value: 3000
  - name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
    value: 2000
  - name: SL_ZIGBEE_STACK_RTOS_TASK_STACK_SIZE
    value: 3800
  # Timer RTOS task priority needs to be one more than SL_BT_RTOS_LINK_LAYER_TASK_PRIORITY
  # BT uses event flags that require the timer task to be higher priority than all other RTOS tasks
  - name: configTIMER_TASK_PRIORITY
    value: 53
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: 0
  - name: SL_CLI_HELP_DESCRIPTION_ENABLED
    value: 0
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 32768
    condition:
      - device_series_2
  # If using zigbee_secure_key_storage we do not need to support backwards
  # compatibility because we have never deployed images with keys in PSA
  # As a result, these lines end up saving some code space
  - name: SL_PSA_ITS_SUPPORT_V1_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V2_DRIVER
    value: 0
  - name: SL_PSA_ITS_SUPPORT_V3_DRIVER
    value: 1
  # Disable app debug info by default
  # Enable it to see app debug info and ZDD RX/TX packets in details
  - name: SL_ZIGBEE_DEBUG_APP_GROUP_ENABLED
    value: 0
  - name: configMAX_TASK_NAME_LEN
    value: 30
  - name: SL_CLI_EXAMPLE_TASK_STACK_SIZE
    value: 600
    condition:
      - cmsis_rtos2
  # On series 3, the bootloader requires more stack to do context parsing of OTA images
  - name: SL_CLI_EXAMPLE_TASK_STACK_SIZE
    value: 1500
    condition:
      - device_series_3
  - name: SL_ZIGBEE_STACK_RTOS_TASK_STACK_SIZE
    value: 5800
    condition:
      - device_series_3
  - name: SL_ZIGBEE_APP_FRAMEWORK_RTOS_TASK_STACK_SIZE
    value: 6000
    condition:
      - device_series_3
  - name: SL_ZIGBEE_AF_PLUGIN_ZCL_CLUSTER_DEFER_ATTRIBUTE_WRITES_TO_NVM_MS
    value: 2000
    condition:
      - device_series_3

define:
  - name: OS_CFG_COMPAT_INIT
  # An example passcode to use for session key negotiation.
  # Customers specify their own passcode here.
  - name: SL_ZIGBEE_DIRECT_ZDD_DEFAULT_PASSCODE
    value: '{ 0x01, 0x02, 0x03, 0x04, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 }'

source:
  - path: main.c
    unless: [cmsis_rtos2]
  - path: app.c

config_file:
  - path: config/zcl/zcl_config.zap
    file_id: zap_configuration_file_id
    directory: zcl
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: config/gatt_configuration.btconf
    directory: btconf

include:
  - path: ./
  - path: ../../../../app/projects/multiprotocol/common/
    file_list:
      - path: sl_dmp_ui_stub.h
        unless:
          - hardware_board_supports_wstk_lcd

tag:
  - prebuilt_demo
  - hardware:has:lcd
  - hwfilter:!board:hardware:shares:button:led
  - hwfilter:board:simple_led:led0
  - hwfilter:board:simple_led:led1
  - hwfilter:flash:512k
  - hwfilter:ram:64k
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_supports_zigbee
  - hwfilter:!device:device_is_module
  - hwfilter:!device:rm21z000f1024im32
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
readme:
  - path: ./readme.md

ui_hints:
  highlight:
    - path: readme.md
      focus: false

filter:
  - name: Wireless Technology
    value: [Zigbee, Bluetooth]
  - name: Device Type
    value: [SoC]
  - name: Capability
    value: [Multiprotocol]
  - name: Project Difficulty
    value: [Advanced]
