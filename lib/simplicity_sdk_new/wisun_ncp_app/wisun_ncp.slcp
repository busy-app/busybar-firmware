project_name: wisun_ncp
label: Wi-SUN - NCP
description: >
  The Wi-SUN Network Co-Processor (NCP) application provides a complete Wi-SUN
  network interface implementation for embedded devices. This project implements
  a Network Co-Processor architecture where the Wi-SUN stack runs on a dedicated
  radio microcontroller, communicating with a host processor through UART or CPC
  (Co-Processor Communication) interfaces.
quality: production
package: wisun_ncp_app

component:
  - id: wisun_stack
  - id: wisun_stack_debug
  - id: wisun_stack_lfn
  - id: wisun_stack_ffn
  - id: wisun_default_radioconf
  - id: sl_main
  - id: device_init
  - id: freertos
  - id: sleeptimer
  - id: nvm3_default

requires:
  - name: memory_manager
  - name: wisun_ncp_recommended_interface

include:
  - path: ncp/
    file_list:
    - path: sl_wsncp_task.h
    - path: sl_wsncp_interface.h
    - path: sl_wsncp_buffer.h

source:
  - path: app.c
  - path: ncp/sl_wsncp_task.c
  - path: ncp/sl_wsncp_buffer.c

define:
  - name: DEBUG_EFM_USER
  # NCP Task Configuration
  - name: SL_WSNCP_TASK_STACK_SIZE
    value: 500
  # NCP Buffer Configuration
  - name: SL_WSNCP_BUFFER_SIZE
    value: 1500
  - name: SL_WSNCP_MAX_TIMEOUT_COUNT
    value: 1000

configuration:
  # CPC Interface Configuration
  - name: SL_CPC_RX_PAYLOAD_MAX_LENGTH
    value: 1500
    condition: [cpc_secondary]
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_VCOM_RX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary, cpc_secondary_driver_uart_usart]
  - name: SL_CPC_DRV_UART_VCOM_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary, cpc_secondary_driver_uart_usart]
  - name: SL_CPC_DRV_UART_VCOM_RX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary, cpc_secondary_driver_uart_eusart]
  - name: SL_CPC_DRV_UART_VCOM_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary, cpc_secondary_driver_uart_eusart]
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_UARTDRV_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlHwUart
    condition: [device_has_eusart]
  - name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlHwUart
    unless: [device_has_eusart]
  - name: CPU_CFG_TS_32_EN
    value: 1
  - name: OS_CFG_DBG_EN
    value: 1
  - name: OS_CFG_TS_EN
    value: 1
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: 1
  - name: OS_CFG_STAT_TASK_EN
    value: 1
  - name: OS_CFG_TASK_PROFILE_EN
    value: 1
  - name: OS_CFG_APP_HOOKS_EN
    value: 1
    condition: [micriumos_kernel]
  - name: SL_RAIL_UTIL_PTI_BAUD_RATE_HZ
    value: 3200000
  - name: SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_SELECTION
    value: "SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_OFDM"
    condition: [device_sdid_220]

toolchain_settings:
  - option: optimize
    value: size
    unless: [wisun_stack_debug]

readme:
  - path: doc/readme.md

other_file:
  - path: doc/readme_img0.png

template_contribution:
  - name: event_handler
    value:
      event: internal_app_init
      include: sl_wsncp_task.h
      handler: sl_wsncp_task_init

filter:
  - name: Wireless Technology
    value: [Wi-SUN]
  - name: Device Type
    value: [NCP]
  - name: Project Difficulty
    value: [Advanced]

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_wisun