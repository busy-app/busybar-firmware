id: "bluetooth_controller_rtos_adaptation"
label: "Bluetooth Core"
package: bluetooth_le_controller
description: >
  Bluetooth RTOS adaptation for running Bluetooth Controller with an RTOS Kernel.
category: Bluetooth|RTOS Adaptation
quality: "production"
ui_hints:
  visibility: never
root_path: bluetooth_le_controller/utils/rtos
config_file:
- path: "config/sl_btctrl_rtos_config.h"
  unless:
  - bluetooth_stack
include:
- path: "inc/"
  file_list:
  - path: "sl_btctrl_rtos.h"
  unless:
  - bluetooth_stack
source:
- path: "src/sl_btctrl_rtos.c"
  unless:
  - bluetooth_stack
requires:
- name: bluetooth_controller
template_contribution:
- name: event_handler
  value:
    event: stack_init
    include: "sl_btctrl_rtos.h"
    handler: "sl_btctrl_rtos_init"
  priority: -1000
  unless:
  - bluetooth_stack
provides:
- name: "bluetooth_controller_rtos_adaptation"
metadata:
  sbom:
    license: MSLA
