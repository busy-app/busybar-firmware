id: "bluetooth_feature_advertiser_past"
label: "Transfer periodic synchronization information for a local advertising set"
package: bluetooth_le_controller
description: >
  Transfer the synchronization information of a local active periodic
  advertising set to a remote device using Periodic Advertising Synchronization
  Transfer (PAST) over a connection.

  Use this component on the device that needs to initiate PAST to a remote
  device. To receive PAST from a remote device, use
  <bluetooth_feature_past_receiver>.
category: Bluetooth|Bluetooth LE Controller (Link Layer)|Features with Commands and Events
quality: "production"
requires:
- name: "bluetooth_controller"
- name: "bluetooth_feature_connection"
provides:
- name: "bluetooth_feature_advertiser_past"
template_contribution:
- name: component_catalog
  value: bluetooth_feature_advertiser_past
documentation:
  docset: bluetooth
  document: bluetooth-stack-api/sl-bt-advertiser-past
metadata:
  sbom:
    license: MSLA
root_path: bluetooth_le_controller
