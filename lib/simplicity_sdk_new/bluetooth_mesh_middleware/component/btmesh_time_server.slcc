id: "btmesh_time_server"
label: "Time Server"
package: bluetooth_mesh_middleware
description: >
  Used to support the control and reporting functionality of a node that
  tracks time. This component is prepared for integration into SOC applications.

  This is a No-Code component.
category: "Bluetooth Mesh|Models|Time and Scenes"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_time_server"
tag:
- No-Code

config_file:
- path: "config/sl_btmesh_time_server_config.h"
- path: btmesh_time_server.dcd
  directory: btmeshconf
source:
- path: "sl_btmesh_time_server.c"
include:
- path: ""
  file_list:
  - path: "sl_btmesh_time_server.h"
provides:
- name: "btmesh_time_server"
requires:
- name: "app_btmesh_util"
- name: "btmesh_role_init"
- name: "btmesh_stack_time_server"
recommends:
- id: "btmesh_provisionee"

  vendor: silabs
template_contribution:
- name: "btmesh_on_event"
  value:
    include: "sl_btmesh_time_server.h"
    function: "sl_btmesh_time_server_on_event"
  priority: -10

validation_helper:
- path: "../../script/validation/soc_ncp_compatibility.lua"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-time-server
