id: "btmesh_nlc_basic_lightness_controller"
label: "Basic Lightness Controller Profile"
package: bluetooth_mesh_middleware
description: >
  Basic Lightness Controller role in an NLC network. This component
  includes other components needed for an SoC application to
  act as a Basic Lightness Controller node in an NLC network, as
  well as components providing the relevant metadata for the role.
category: "Bluetooth Mesh|NLC"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_basic_lightness_controller"
tag:
- No-Code

provides:
- name: "btmesh_nlc_basic_lightness_controller"
requires:
- name: "btmesh_nlc_basic_lightness_controller_profile_metadata"
- name: "btmesh_lc_server"
- name: "btmesh_scene_server"
- name: "btmesh_generic_server"
recommends:
- id: "btmesh_generic_base"
  vendor: silabs
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-basic-lightness-controller
