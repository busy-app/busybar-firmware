  This component provides the relevant metadata so the Dimming Control
  NLC profile is included in DCD Page 2.
category: "Bluetooth Mesh|Profile Metadata"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_dimming_control_profile_metadata"
tag:
- No-Code

config_file:
- path: btmesh_nlc_dimming_control.profile
  directory: btmeshconf
provides:
- name: "btmesh_nlc_dimming_control_profile_metadata"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-dimming-control-profile-metadata
