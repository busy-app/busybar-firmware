    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_dimming_control"
tag:
- No-Code

provides:
- name: "btmesh_nlc_dimming_control"
requires:
- name: "btmesh_nlc_dimming_control_profile_metadata"
- name: "btmesh_generic_level_client_ext"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-dimming-control
