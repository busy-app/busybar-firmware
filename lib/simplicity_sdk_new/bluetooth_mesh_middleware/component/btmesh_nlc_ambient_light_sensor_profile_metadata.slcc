id: "btmesh_nlc_ambient_light_sensor_profile_metadata"
label: "Ambient Light Sensor Profile Metadata"
package: bluetooth_mesh_middleware
description: >
  This component provides the relevant metadata so the Ambient Light Sensor
  NLC profile is included in DCD Page 2.
category: "Bluetooth Mesh|Profile Metadata"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_ambient_light_sensor_profile_metadata"
tag:
- No-Code

config_file:
- path: btmesh_nlc_ambient_light_sensor.profile
  directory: btmeshconf
provides:
- name: "btmesh_nlc_ambient_light_sensor_profile_metadata"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-ambient-light-sensor-profile-metadata
