id: "btmesh_nlc_energy_monitor"
label: "Energy Monitor Sensor Profile"
package: "bluetooth_mesh_middleware"
description: >
  Energy monitor role in an NLC network. This component
  includes other components needed for an SoC application to
  act as a mock Energy monitor node in an NLC network, as
  well as components providing the relevant metadata for the role.
category: "Bluetooth Mesh|NLC"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_energy_monitor"
tag:
- No-Code

provides:
- name: "btmesh_nlc_energy_monitor"
requires:
- name: "btmesh_nlc_energy_monitor_profile_metadata"
- name: "btmesh_sensor_server"
- name: "btmesh_sensor_power_consumption"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-energy-monitor
