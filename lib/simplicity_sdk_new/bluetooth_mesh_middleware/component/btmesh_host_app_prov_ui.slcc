id: btmesh_host_app_prov_ui
label: BT Mesh Provisioner UI Application Component
package: bluetooth_mesh_middleware
description: >
  BT Mesh Provisioner UI Application component provides user interface
  functionality for provisioning applications in Bluetooth Mesh networks.
category: Bluetooth Mesh|Host
quality: production
metadata:
  sbom:
    license: Zlib
root_path: bluetooth_mesh_middleware/common/btmesh_host_app_prov_ui
include:
- path: .
  file_list:
  - path: btmesh_app_prov_ui.h
source:
- path: btmesh_app_prov_ui.c
provides:
- name: btmesh_host_app_prov_ui
requires:
- name: btmesh_stack_api_ncp_host
- name: btmesh_host_app_prov
- name: btmesh_host_app_remote_prov_ui
  condition:
  - btmesh_host_app_remote_prov
- name: component_catalog
- name: host_ncp
template_contribution:
- name: component_catalog
  value: btmesh_host_app_prov_ui
