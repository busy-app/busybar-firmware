id: "btmesh_nlc_basic_lightness_controller_profile_metadata"
label: "Basic Lightness Controller Profile Metadata"
package: bluetooth_mesh_middleware
description: >
  This component provides the relevant metadata so the Basic Lightness Controller
  NLC profile is included in DCD Page 2.
category: "Bluetooth Mesh|Profile Metadata"
quality: "production"
metadata:
  sbom:
    license: Zlib
root_path: "bluetooth_mesh_middleware/common/btmesh_nlc_basic_lightness_controller_profile_metadata"
tag:
- No-Code

config_file:
- path: btmesh_nlc_basic_lightness_controller.profile
  directory: btmeshconf
provides:
- name: "btmesh_nlc_basic_lightness_controller_profile_metadata"
documentation:
  docset: btmesh
  document: btmesh-service-api/btmesh-nlc-basic-lightness-controller-profile-metadata
