upgrade:
  - sdk:
      id: simplicity_sdk
      version: "2025.12.0"
    configuration:
      - script: bluetooth_mesh_middleware/script/migration/upgrade_btmesh_dma_channel_config_i2c.lua
        description: >
          Increment DMA channel count to support increased I2C DMA channel requirements.
          If the old DMA channel count is less than 8 (the default maximum), the count is incremented.
          +2 channels if i2c_core feature is provided because the new I2C driver supports asynchronous TX and RX using
          separate DMA channels.
  - sdk:
      id: simplicity_sdk
      version: "2025.6.0"
    configuration:
      - script: bluetooth_mesh_middleware/script/migration/upgrade_btmesh_dma_channel_config_iostream.lua
        description: >
          Increment DMA channel count to support increased iostream DMA channel requirements.
          If the old DMA channel count is less than 8 (the default maximum), the count is incremented.
          +1 channel if iostream_uart_common feature is provided because it requires a DMA channel for TX as well.
