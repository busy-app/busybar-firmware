---
project_name: bt_soc_dtm_micriumos
package: bluetooth_le_app
label: Bluetooth - SoC DTM Micrium OS
description: >
  This example implements the direct test mode (DTM) application for radio
  testing. DTM commands can be called via UART.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: micriumos_kernel
  - id: bluetooth_stack
  - id: gatt_configuration
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: bluetooth_feature_test
  - id: bluetooth_feature_afh
  - id: bluetooth_feature_aoa_transmitter
    condition:
      - device_supports_bluetooth_cte
  - id: bluetooth_feature_aoa_receiver
    condition:
      - device_supports_bluetooth_cte
      - device_supports_bluetooth_iq_sampling
      - device_supports_bluetooth_antenna_switching
      - hardware_board_has_rfswitch_aox
  - id: app_assert
  - id: memory_manager
  - id: board_control
  - id: iostream
  - id: mpu
  - id: sleeptimer
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c
  - path: dtm.c

include:
  - path: .
    file_list:
      - path: app.h
      - path: dtm.h

config_file:
  - path: config/dtm_config.h

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png

configuration:
  - name: SL_STACK_SIZE
    value: "2000"
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: "6500"
  - name: OS_CFG_TMR_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "0"
  - name: OS_CFG_TS_EN
    value: "0"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "1"
  - name: OS_CFG_STK_SIZE_MIN
    value: "48"
  - name: OS_CFG_Q_EN
    value: "1"
  - name: OS_CFG_MON_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_STK_CHK_EN
    value: "0"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "0"
  - name: OS_CFG_TASK_Q_EN
    value: "0"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

  # USART: VCOM = EXP
  - name: SL_IOSTREAM_USART_VCOM_PARITY
    value: "usartNoParity"
  - name: SL_IOSTREAM_USART_VCOM_STOP_BITS
    value: "usartStopbits1"
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlNone"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"

  # EUSART: VCOM = EXP
  - name: SL_IOSTREAM_EUSART_VCOM_PARITY
    value: "SL_IOSTREAM_EUSART_UART_NO_PARITY"
  - name: SL_IOSTREAM_EUSART_VCOM_STOP_BITS
    value: "SL_IOSTREAM_EUSART_UART_STOP_BITS_1"
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_NONE"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:!device:device_generic_family_efr32xg22

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
