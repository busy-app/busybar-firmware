project_name: bt_soc_app_ota_dfu
package: bluetooth_le_app
label: Bluetooth - SoC Application OTA DFU
description: >
  A minimal project structure, that serves as a starting point for custom
  Bluetooth applications that provides Over-The-Air device firmware update in
  user application runtime.
category: Bluetooth Examples
quality: production

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

component:
  - id: bluetooth_stack
  - id: gatt_configuration
  - id: gatt_service_device_information_override
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: rail_util_pti
  - id: simple_button
    instance:
      - btn0
  - id: app_assert
  - id: app_log
  - id: app_ota_dfu
  - id: mpu
  - id: app_timer
  - id: sl_main
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png
  - path: image/readme_img2.png
  - path: image/readme_img3.png
  - path: image/readme_img4.png
  - path: image/readme_img5.png

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"

post_build:
  - path: ../../postbuild_profile/bt_dfu_app_s2.slpb

tag:
  - companion:bootloader
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:!device:device_generic_family_efr32xg21
  - hwfilter:!device:device_generic_family_efr32xg22
  - hwfilter:!device:device_generic_family_efr32xg24
  - hwfilter:!device:device_generic_family_efr32xg26
  - hwfilter:!device:device_generic_family_efr32xg28
  - hwfilter:board:simple_button:btn0
  - hwfilter:flash:768k

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
