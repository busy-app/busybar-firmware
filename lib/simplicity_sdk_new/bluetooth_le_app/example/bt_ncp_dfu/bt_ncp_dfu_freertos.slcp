project_name: bt_ncp_dfu_freertos
package: bluetooth_le_app
label: Bluetooth - NCP DFU FreeRTOS
description: >
  Network Co-Processor (NCP) target application with device firmware update.
  Runs the Bluetooth stack dynamically and provides access to it via Bluetooth
  API (BGAPI) using UART connection. NCP mode makes it possible to run your
  application on a host controller or PC.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Project Difficulty"
    value: ["Beginner"]

component:
  - id: freertos
  - id: bootloader_interface
  - id: bluetooth_stack
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_extended_advertiser
  - id: bluetooth_feature_periodic_advertiser
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_nvm
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_sync
  - id: bluetooth_feature_system
  - id: bluetooth_feature_dynamic_gattdb
  - id: bluetooth_feature_test
  - id: ncp
  - id: ncp_user_cmd
  - id: uartdrv_usart
    instance:
      - vcom
    condition:
      - device_series_2
  - id: iostream_eusart
    instance:
      - vcom
    condition:
      - device_series_3
  - id: mpu
  - id: app_assert
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png
  - path: image/readme_img2.png

configuration:
  - name: SL_STACK_SIZE
    value: "2000"
  - name: configTOTAL_HEAP_SIZE
    value: "6000"
  - name: configTIMER_TASK_STACK_DEPTH
    value: "240"
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 4
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlHw
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

post_build:
  - path: ../../postbuild_profile/bt_dfu_app_s2.slpb
    condition:
      - device_series_2
  - path: ../../postbuild_profile/bt_dfu_app_s3.slpb
    condition:
      - device_series_3

tag:
  - companion:bootloader
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:!device:device_generic_family_efr32xg22

ui_hints:
  highlight:
    - path: readme.md
      focus: true
