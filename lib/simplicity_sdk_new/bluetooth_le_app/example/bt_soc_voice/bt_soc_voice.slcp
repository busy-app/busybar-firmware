project_name: bt_soc_voice
package: bluetooth_le_app
label: Bluetooth - SoC Voice
description: >
  Voice over Bluetooth Low Energy sample application. It is supported by
  Thunderboard Sense 2 and Thunderboard EFR32BG22 boards and demonstrates how to
  send voice data over GATT, which is acquired from the on-board microphones.
category: Bluetooth Examples
quality: production

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: app_log
  - id: app_assert
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: bluetooth_stack
  - id: board_control
  - id: cli
    instance:
      - example
  - id: clock_manager
  - id: device_init
  - id: gatt_configuration
  - id: gatt_service_device_information_override
  - id: memory_manager
  - id: mic_driver
  - id: rail_util_pti
  - id: sl_main
  - id: silabs_core_circular_queue
  - id: simple_button
    instance:
      - btn0
  - id: simple_led
    instance:
      - led0

source:
  - path: app.c
  - path: adpcm.c
  - path: filter.c
  - path: voice.c

include:
  - path: .
    file_list:
      - path: adpcm.h
      - path: filter.h
      - path: voice.h

readme:
  - path: readme.md

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png
  - path: image/readme_img2.png
  - path: image/readme_img3.png
  - path: image/readme_img4.png
  - path: image/readme_img5.png

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
    unless:
      - cli
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
    unless:
      - cli
  - name: SL_MIC_PDM_DSR
    value: "48"
    condition:
      - mic_pdm_driver
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: "224"

template_contribution:
  - name: cli_command
    value:
      name: sample_rate
      handler: cli_sample_rate
      help: "Set sample rate in kHz"
      shortcuts:
        - name: s
      argument:
        - type: uint8
          help: "Sample rate (8 or 16)"
    condition:
      - cli
  - name: cli_command
    value:
      name: channels
      handler: cli_channels
      help: "Set channel count"
      shortcuts:
        - name: c
      argument:
        - type: uint8
          help: "Channels (1 or 2)"
    condition:
      - cli
  - name: cli_command
    value:
      name: filter
      handler: cli_filter
      help: "Set filter status"
      shortcuts:
        - name: f
      argument:
        - type: uint8
          help: "Enable (1) / disable (0)"
    condition:
      - cli
  - name: cli_command
    value:
      name: encoding
      handler: cli_encoding
      help: "Set encoding status"
      shortcuts:
        - name: e
      argument:
        - type: uint8
          help: "Enable (1) / disable (0)"
    condition:
      - cli

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:board:simple_led:led0
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:hardware:has:microphone
  - hwfilter:!board:hardware:shares:button:led
  - hwfilter:!board:brd4184a
  - hwfilter:ram:32k

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
