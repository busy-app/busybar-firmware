project_name: bt_soc_csr_generator
package: bluetooth_le_app
label: Bluetooth - SoC Certificate Signing Request Generator (Secure Vault)
description: >
  Certificate generating firmware example. Software is generating the device
  EC key pair, the signing request for the device certificate, and other related
  data. The generated data can be read out by the Central Authority.
  This example utilizes Secure Vault for storing keys.

category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: bluetooth_stack
  - id: apploader
  - id: app_assert
  - id: app_log
  - id: nvm3_lib
  - id: nvm3_default
  - id: psa_crypto
  - id: psa_crypto_cmac
  - id: psa_crypto_ccm
  - id: psa_crypto_cipher_ecb
  - id: psa_crypto_ecdh
  - id: psa_crypto_ecdsa
  - id: psa_crypto_ecc_secp256r1
  - id: psa_its
  - id: psa_crypto_hmac
  - id: psa_crypto_sha256
  - id: psa_crypto_sha1
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: sleeptimer

source:
  - path: app.c
  - path: csr_generator.c
  - path: der.c

include:
  - path: .
    file_list:
      - path: csr_generator.h
      - path: der.h

config_file:
  - path: config/csr_generator_config.h

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png
  - path: image/readme_img2.png

configuration:
  - name: SL_STACK_SIZE
    value: "6200"
  - name: CSR_GENERATOR_KEY_LOCATION
    value: "PSA_KEY_LOCATION_SLI_SE_OPAQUE"  # Secure Vault
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "1"
    condition:
      - psa_crypto

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:device:device_security_vault
  - hwfilter:flash:512k
  - hwfilter:ram:64k

ui_hints:
  highlight:
    - path: readme.md
      focus: true
