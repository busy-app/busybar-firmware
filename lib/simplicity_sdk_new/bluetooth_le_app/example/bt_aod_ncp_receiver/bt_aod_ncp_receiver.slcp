project_name: bt_aod_ncp_receiver
package: bluetooth_le_app
label: Bluetooth AoD - NCP Receiver
description: >
  Network Co-Processor (NCP) target application extended with CTE Receiver
  support. It enables Angle of Departure (AoD) calculation. Use this application
  with Direction Finding Studio tools.
category: Bluetooth AoX Examples
quality: production

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: bluetooth_stack
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_extended_advertiser
  - id: bluetooth_feature_periodic_advertiser
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_dynamic_gattdb
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_nvm
  - id: bluetooth_feature_extended_scanner
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_sync
  - id: bluetooth_feature_periodic_sync
  - id: bluetooth_feature_sync_scanner
  - id: bluetooth_feature_system
  - id: bluetooth_feature_aod_receiver
  - id: ncp
  - id: uartdrv_usart
    instance:
      - vcom
  - id: mpu
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: app_assert

source:
  - path: app.c

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: 4
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlHw
  - name: SL_BT_CONFIG_MAX_PERIODIC_ADVERTISING_SYNC
    value: 8
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:device:device_supports_bluetooth_cte
  - hwfilter:device:device_supports_bluetooth_iq_sampling
  - hwfilter:ram:32k
