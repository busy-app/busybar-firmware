project_name: bt_soc_throughput_micriumos
package: bluetooth_le_app
label: Bluetooth - SoC Throughput Micrium OS
description: >
  This example tests the throughput capabilities of the device and can be used
  to measure throughput between 2 *EFR32* devices, as well as between a device
  and a smartphone using the 'Si Connect' mobile app, through the 'Throughput' demo tile.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: micriumos_kernel
  - id: memory_manager
  - id: bluetooth_stack
  - id: gatt_service_device_information_override
  - id: app_assert
  - id: app_log
  - id: mpu
  - id: simple_button
    instance:
      - btn0
      - btn1
  - id: throughput_peripheral
  - id: throughput_central
  - id: throughput_ui
    condition: [hardware_board_supports_wstk_lcd]
  - id: cli
    instance:
      - example
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: gatt_configuration.btconf
    directory: btconf

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.jpg
  - path: image/readme_img2.jpg
  - path: image/readme_img3.jpg
  - path: image/readme_img4.gif
  - path: image/readme_img5.jpg
  - path: image/readme_img6.jpg
  - path: image/readme_img7.jpg
  - path: image/readme_img8.png
  - path: image/readme_img9.png

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: LIB_MEM_CFG_HEAP_SIZE
    value: "6500"
  - name: OS_CFG_TMR_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "0"
  - name: OS_CFG_TS_EN
    value: "0"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "0"
  - name: OS_CFG_STK_SIZE_MIN
    value: "48"
  - name: OS_CFG_Q_EN
    value: "1"
  - name: OS_CFG_MON_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_EN
    value: "0"
  - name: OS_CFG_STAT_TASK_STK_CHK_EN
    value: "0"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "0"
  - name: OS_CFG_TASK_Q_EN
    value: "0"
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: "2"
  - name: SL_BOARD_ENABLE_DISPLAY
    value: "1"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
    unless:
      - cli
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
    unless:
      - cli
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

template_contribution:
  - name: cli_command
    value:
      name: switch_to_central
      handler: cli_switch_to_central
      help: "Switch to central"
    condition:
      - cli
  - name: cli_command
    value:
      name: switch_to_peripheral
      handler: cli_switch_to_peripheral
      help: "Switch to peripheral"
    condition:
      - cli

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:device:device_series_2
  - hwfilter:!device:device_generic_family_efr32xg22
  - hwfilter:board:simple_button:btn0
  - hwfilter:board:simple_button:btn1
  - hwfilter:flash:257k

ui_hints:
  highlight:
    - path: config/btconf/gatt_configuration.btconf
    - path: readme.md
      focus: true
