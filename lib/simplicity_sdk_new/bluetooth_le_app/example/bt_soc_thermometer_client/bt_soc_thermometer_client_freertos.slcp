project_name: bt_soc_thermometer_client_freertos
package: bluetooth_le_app
label: Bluetooth - SoC Thermometer Client FreeRTOS
description: >
  Implements a GATT Client that discovers and connects with up to 4 BLE devices
  advertising themselves as Thermometer Servers. It displays the discovery
  process and the temperature values received via UART.
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]

component:
  - id: freertos
  - id: memory_manager
  - id: bluetooth_stack
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_connection_role_central
  - id: bluetooth_feature_gatt
  - id: bluetooth_feature_legacy_scanner
  - id: bluetooth_feature_system
  - id: bluetooth_feature_power_control
  - id: rail_util_pti
  - id: cli
    instance:
      - example
  - id: app_log
  - id: app_assert
  - id: printf
  - id: mpu
  - id: sl_main
  - id: app_os_helper
  - id: clock_manager
  - id: device_init

source:
  - path: app.c

include:
  - path: .
    file_list:
      - path: app.h

readme:
  - path: readme.md

other_file:
  - path: image/readme_img0.png
  - path: image/readme_img1.png
  - path: image/readme_img2.png
  - path: image/readme_img3.png

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: configTOTAL_HEAP_SIZE
    value: "5000"
  - name: configTIMER_TASK_STACK_DEPTH
    value: "240"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
    condition:
      - cli
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "1"
    condition:
      - cli
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto

template_contribution:
  - name: cli_command
    value:
      name: hello
      handler: hello
      help: hello
    condition:
      - cli
  - name: cli_command
    value:
      name: toggle_print_tx_power
      handler: toggle_print_tx_power
      help: Toggle to print tx power
    condition:
      - cli

post_build:
  - path: ../../postbuild_profile/bt_common_s2.slpb
    condition: [device_series_2, bootloader_app_properties]

tag:
  - hwfilter:device:device_supports_bluetooth
  - hwfilter:!device:device_generic_family_efr32xg22

ui_hints:
  highlight:
    - path: readme.md
      focus: true
