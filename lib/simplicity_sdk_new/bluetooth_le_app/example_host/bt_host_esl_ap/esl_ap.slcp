  - path: ap_core_event_handlers_demo.py
  - path: ap_core_helpers.py
  - path: ap_core_pawr_responses.py
  - path: ap_core_scan.py
  - path: ap_ead.py
  - path: ap_json_helper.py
  - path: ap_logger.py
  - path: ap_response_parser.py
  - path: ap_sensor.py
  - path: ap_soft_timer.py
  - path: app.py
  - path: auto_importer.py
  - path: esl_command.py
  - path: esl_key_lib_test.py
  - path: esl_key_lib_wrapper.py
  - path: esl_key_lib.py
  - path: esl_lib_test.py
  - path: esl_lib_wrapper.py
  - path: esl_lib.py
  - path: esl_net_template.json
  - path: esl_tag_db.py
  - path: esl_tag.py
  - path: font.otf
  - path: image_converter.py
  - path: qrcode_generator.py
  - path: requirements.txt
  - path: image/apple.png
  - path: image/banana.png
  - path: image/bread.png
  - path: image/chicken.png
  - path: image/croissant.png
  - path: image/donut.png
  - path: image/hamburger.png
  - path: image/pineapple.png
  - path: image/pizza.png
  - path: image/skull.png
  - path: image/steak.png
