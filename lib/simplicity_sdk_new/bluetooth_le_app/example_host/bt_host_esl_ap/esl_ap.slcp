project_name: esl_ap
package: bluetooth_le_app
label: Bluetooth - ESL Access Point
description: >
  Bluetooth - ESL Access Point
category: Bluetooth Examples
quality: experimental

filter:
  - name: "Wireless Technology"
    value: ["Bluetooth"]
  - name: "Device Type"
    value: ["Host"]
  - name: "Project Difficulty"
    value: ["Advanced"]

component:
  - id: toolchain_gcc
  - id: native_host

source:
  - path: main.c

