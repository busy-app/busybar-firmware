id: app_em4h_reset
label: EM4H-Reset
package: platform_common_apps
description: >
  The EM4H-Reset component provides unlatch pin retention when returning from EM4.
  In order to have a constantly running oscillator with correct tuning values
  re-apply tuning value before unlatching.
category: Application|Utility
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: app_em4h_reset
requires:
- name: emlib_emu
- name: device
root_path: platform_common_apps/app/common/util/app_em4h
source:
- path: "app_em4h.c"
include:
- path: .
  file_list:
  - path: app_em4h.h
template_contribution:
- name: event_handler
  value:
    event: platform_init
    include: app_em4h.h
    handler: app_unlatch_pin_retention
  priority: -9980
- name: component_catalog
  value: app_em4h_reset
