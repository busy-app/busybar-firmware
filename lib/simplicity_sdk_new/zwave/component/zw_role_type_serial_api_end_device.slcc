id: zw_role_type_serial_api_end_device
label: Z-Wave Serial API End Device
category: Z-Wave|Role Types
description: >
  The Serial API End Device role type is specific to serial_api_end device and is intended for a end device to operate in any possible role type: always-on, FLiRS or never-listening.
  It is based on the always-on configuration but allows the application to enter sleep mode at runtime using a Serial API command.
  The ZAF_CONFIG_DEVICE_OPTION_MASK is automatically set to always-on by default by this component.
package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
define:
- name: ZAF_CONFIG_DEVICE_OPTION_MASK
  value: APPLICATION_NODEINFO_LISTENING
- name: ZAF_CONFIG_APP_ROLE_TYPE
  value: ZWAVEPLUS_INFO_REPORT_ROLE_TYPE_END_NODE_ALWAYS_ON
requires:
- name: zw_end_device
provides:
- name: zw_role_type_sleeping
- name: zw_role_type_serial_api_end_device
- name: zw_role_type
root_path: zwave
