id: zw_cc_basic
label: Basic Command Class Support
category: Z-Wave|Command Classes
description: >
  The Basic Command Class allows a controlling device to operate the primary functionality of another
  device without any further knowledge. Basic Command Class ensures a basic interoperability if no
  other Command Class is shared by two devices.

  This component provides support for Basic Command Class controlled by another device.

package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license

source:
- path: ZAF/CommandClasses/Basic/src/CC_Basic.c
include:
- path: ZAF/CommandClasses/Basic/inc/
  file_list:
  - path: CC_Basic.h
provides:
- name: zw_cc_basic
requires:
- name: zw_core
root_path: zwave
