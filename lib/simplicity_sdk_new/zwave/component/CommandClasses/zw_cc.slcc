id: zw_cc
label: Command Classes
category: Z-Wave|Command Classes
description: >
  Source files mandatory for end devices.
  This component contains source files from all command clases that cannot be removed from the app,
  regardless if specific command Class component has been installed or not.
package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license
ui_hints:
  visibility: never

include:
- path: ZAF/CommandClasses/Indicator/inc/
  file_list:
  - path: CC_Indicator.h
- path: ZAF/CommandClasses/DeviceResetLocally/
  file_list:
  - path: CC_DeviceResetLocally.h
source:
- path: ZAF/CommandClasses/Indicator/src/CC_Indicator_weak.c
- path: ZAF/CommandClasses/DeviceResetLocally/CC_DeviceResetLocally_weak.c
provides:
- name: zw_cc
requires:
- name: zw_core
root_path: zwave
