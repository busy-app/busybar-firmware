id: zaf_protocol_config
label: ZAF Protocol Configuration Component
category: Z-Wave|ZAF|Protocol Config
description: >
  This component contains the functionality to generate based on the configurations
  provided in the application the Application Node Info, Radio Configuration and
  Protocol Configuration.
  This component can be used by NCP and SOC applications and it is mandatory for
  all applications.
package: zwave
quality: production
metadata:
  sbom:
    reference: zw_sbom_license

include:
- path: "ZAF/ProtocolConfig/inc"
  file_list:
  - path: "zaf_protocol_config.h"
source:
- path: "ZAF/ProtocolConfig/src/zaf_protocol_config.c"
provides:
- name: zaf_protocol_config
root_path: zwave
