id: suds_doc
label: SUDS Documentation Component
package: security_mbedtls_source
quality: production
ui_hints:
  visibility: never
category: Platform|Security|SUDS Doc
description: This component provides additional source paths for offical psec api documentation. SUDS doxygen setup will by default parse each component in platform/security, and include referenced header files
include:
- path: doxygen/input
  file_list:
  - path: doc_encdec.h
  - path: doc_rng.h
  - path: doc_hashing.h
  - path: doc_ssltls.h
  - path: doc_tcpip.h
  - path: doc_x509.h
metadata:
  sbom:
    reference: mbedtls_sbom
root_path: security_mbedtls_source
