id: se_manager_device_data
label: Device Data
package: security_se_manager
description: >-
  SE Manager api for reading device data
category: Platform|Security|SE Manager
quality: production
ui_hints:
  visibility: never
source:
- path: src/sli_se_manager_device_data.c

include:
- path: inc
  file_list:
  - path: sli_se_manager_device_data.h

requires:
- name: se_manager
- name: device
- name: status
- name: device_series_3

provides:
- name: se_manager_device_data

metadata:
  sbom:
    license: Zlib
root_path: security_se_manager/platform/security/sl_component/se_manager
