id: ddp_cmd_psa_init
label: PSA Crypto DDP commands init
description: >
  Initialization helper for PSA Crypto DDP command set
package: bluetooth_le_middleware
category: Bluetooth|Application|Miscellaneous
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: bluetooth_le_middleware/common/ddp
provides:
- name: ddp_cmd_psa_init
requires:
- name: trustzone_unaware
- name: sl_fault_injection_hardening_source
- name: psa_crypto
- name: psa_builtin_key_support_cryptoacc
  condition: [device_has_cryptoacc, device_has_sepuf]
- name: psa_builtin_key_support_se
  condition: [device_has_semailbox]
include:
- path: inc
  file_list:
  - path: sl_ddp_cmd_psa_init.h
source:
- path: src/sl_ddp_cmd_psa_init.c
define:
- name: TFM_FIH_PROFILE_ON
- name: TFM_FIH_PROFILE_LOW
template_contribution:
- name: event_handler
  value:
    event: internal_app_init
    include: sl_ddp_cmd_psa_init.h
    handler: sl_ddp_cmd_psa_init
