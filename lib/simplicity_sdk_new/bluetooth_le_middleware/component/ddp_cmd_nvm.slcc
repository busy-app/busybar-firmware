id: ddp_cmd_nvm
label: DDP commands for NVM3
description: >
  This component provides a Dynamic Data Provisioning (DDP) command set
  for saving data in persistent storage using NVM3.
package: bluetooth_le_middleware
category: Bluetooth|Application|Miscellaneous
quality: production
metadata:
  sbom:
    license: Zlib
ui_hints:
  visibility: never
root_path: bluetooth_le_middleware/common/ddp
provides:
- name: ddp_cmd_nvm
requires:
- name: ddp
- name: nvm3_default
source:
- path: src/sl_ddp_cmd_nvm.c
other_file:
- path: script/ddp_cmd_nvm.py
  project:
    transfer_ownership: true
    directory: script
define:
- name: SL_DDP_CMD_NVM_SET
  value: 0
- name: SL_DDP_CMD_NVM_GET
  value: 1
template_contribution:
- name: ddp_command
  value:
    id: SL_DDP_CMD_NVM_SET
    handler: sl_ddp_cmd_nvm_set
- name: ddp_command
  value:
    id: SL_DDP_CMD_NVM_GET
    handler: sl_ddp_cmd_nvm_get
