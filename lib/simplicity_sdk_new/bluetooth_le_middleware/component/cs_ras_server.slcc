id: cs_ras_server
package: bluetooth_le_middleware
label: CS Ranging Service Server
description: >
  Channel Sounding (CS) Ranging Service (RAS) Server implements Server role of
  RAS GATT Service to provide Ranging Data to a RAS Client. Ranging Data is
  the CS Procedure results that are raised by the Bluetooth stack on device
  and can be requested by the RAS Client. Ranging Data can be used by the
  application on the device that is running the RAS Client to perform a
  distance estimation.
category: Bluetooth|Application|GATT Services
metadata:
  sbom:
    license: Zlib
quality: production
root_path: bluetooth_le_middleware/common/cs_ras
include:
- path: common/inc
  file_list:
  - path: cs_ras_common.h
  - path: cs_ras_format_converter.h
- path: server/inc
  file_list:
  - path: cs_ras_server.h
  - path: cs_ras_server_internal.h
  - path: cs_ras_server_control_point.h
  - path: cs_ras_server_database.h
  - path: cs_ras_server_messaging.h
  - path: cs_ras_server_messaging_internal.h
  - path: cs_ras_server_log.h
source:
- path: server/src/cs_ras_server.c
- path: server/src/cs_ras_server_control_point.c
- path: server/src/cs_ras_server_database.c
- path: server/src/cs_ras_server_messaging.c
- path: common/src/cs_ras_format_converter.c
config_file:
- path: server/config/cs_ras_server_config.h
  file_id: cs_ras_server_config
- path: server/config/ras.xml
  file_id: cs_ras_server_gatt
  directory: btconf
  condition:
  - gatt_configuration
requires:
- name: bluetooth_api
- name: bluetooth_feature_gatt_server
  condition:
  - device_cortexm
- name: bluetooth_feature_connection
  condition:
  - device_cortexm
- name: host_bluetooth_connection_config
  condition:
  - device_host
- name: bluetooth_feature_sm
  condition:
  - device_cortexm
- name: bluetooth_feature_system
  condition:
  - device_cortexm
- name: sl_core
- name: sl_common
- name: slist
- name: app_queue
- name: app_timer
- name: power_manager
  condition:
  - device_cortexm
provides:
- name: cs_ras_server
template_contribution:
- name: event_handler
  value:
    event: internal_app_init
    include: cs_ras_server_internal.h
    handler: cs_ras_server_init
- name: ncp_local_evt_process
  value:
    include: cs_ras_server_internal.h
    handler: cs_ras_server_on_bt_event
  condition:
  - ncp
- name: bluetooth_on_event
  value:
    include: cs_ras_server_internal.h
    function: cs_ras_server_on_bt_event
  unless:
  - ncp
- name: event_handler
  value:
    event: internal_app_process_action
    include: cs_ras_server_internal.h
    handler: cs_ras_server_step
- name: power_manager_handler
  value:
    event: is_ok_to_sleep
    include: cs_ras_server_internal.h
    handler: cs_ras_server_is_ok_to_sleep
  condition:
  - power_manager
  unless:
  - kernel
- name: power_manager_handler
  value:
    event: sleep_on_isr_exit
    include: cs_ras_server_internal.h
    handler: cs_ras_server_sleep_on_isr_exit
  condition:
  - power_manager
  unless:
  - kernel
documentation:
  docset: bluetooth
  document: bluetooth-service-api/cs-ras-server
