id: bt_post_build
package: bluetooth_le_middleware
label: BLE Post Build
description: Post build scripts for BLE applications.
category: Bluetooth|Application|Firmware Update
metadata:
  sbom:
    license: Zlib
quality: deprecated
root_path: bluetooth_le_middleware/script
tag:
- No-Code
other_file:
- path: create_bl_files.bat
  condition:
  - device_series_2
  - bootloader_app_properties
  project:
    transfer_ownership: true
- path: create_bl_files.sh
  condition:
  - device_series_2
  - bootloader_app_properties
  project:
    transfer_ownership: true
- path: create_bl_files_s3.sh
  condition:
  - device_series_3
  - bootloader_app_properties
  project:
    transfer_ownership: true
- path: create_bl_files.py
  condition:
  - device_series_2
  - bootloader_app_properties
  project:
    transfer_ownership: true
provides:
- name: bt_post_build
documentation:
  docset: bluetooth
  document: bluetooth-service-api/bt-post-build
