id: bt_fp_aoa
label: Bluetooth Feature Pack - AoA
package: bluetooth_le_middleware
description: >
  This component is deprecated, its sole purpose is to support backward
  compatibility with example projects that use it. Please use Bluetooth
  AoA feature components directly.
category: Bluetooth|Application|Miscellaneous
metadata:
  sbom:
    license: Zlib
quality: deprecated
requires:
- name: bluetooth_stack
- name: gatt_configuration
- name: bluetooth_feature_aoa_transmitter
  condition:
  - device_supports_bluetooth_cte
- name: bluetooth_feature_aoa_receiver
  condition:
  - device_supports_bluetooth_cte
  - device_supports_bluetooth_iq_sampling
  - device_supports_bluetooth_antenna_switching
  - hardware_board_has_rfswitch
ui_hints:
  visibility: never
root_path: bluetooth_le_middleware
