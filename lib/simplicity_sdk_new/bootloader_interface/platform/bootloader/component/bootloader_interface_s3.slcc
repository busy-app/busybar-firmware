id: bootloader_interface_s3
label: Bootloader Application Interface Series 3
package: bootloader_interface
description: >
  Bootloader Application Interface component for Series 3.
category: Platform|Bootloader
quality: production
ui_hints:
  visibility: never
source:
- path: platform/bootloader/series3/api/btl_interface.c
- path: platform/bootloader/series3/api/btl_interface_storage.c
include:
- path: platform/bootloader/series3/core
- path: platform/bootloader/series3
  file_list:
  - path: core/btl_util.h
- path: platform/bootloader/series3/api
  file_list:
  - path: btl_interface.h
  - path: btl_interface_parser.h
  - path: btl_interface_storage.h
- path: platform/bootloader
- path: platform/bootloader/api
  file_list:
  - path: application_properties.h
  - path: btl_reset_info.h
  - path: btl_errorcode.h
provides:
- name: bootloader_interface_common
  condition: [device_series_3]
- name: bootloader_interface_s3
requires:
- name: device_series_3
- name: cmsis_core
- name: device
- name: component_catalog
- name: trustzone_security_state
- name: bootloader_app_properties
- name: se_manager
- name: btl_interface_osal
  condition: [cmsis_rtos2]
- name: btl_interface_bootloadinfo
- name: btl_utils_image_parser
template_contribution:
- name: bootloader_interface_enable
  value: 1
- name: component_catalog
  value: gecko_bootloader_interface
- name: event_handler
  value:
    event: platform_init
    include: btl_interface.h
    handler: bootloader_init
  priority: -8000
  unless: [trustzone_nonsecure]
# Series-3
- name: bootloader_size
  value: 32768
metadata:
  sbom:
    license: MSLA
documentation:
  docset: mcu-bootloader
  document: group-Interface
root_path: bootloader_interface
