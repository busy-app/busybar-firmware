id: bgapi_service_api
label: API files for BGAPI Service
package: bgapi_protocol
description: >
  Provides the API files for BGAPI Service. This component is used internally by
  Silicon Labs components that need the API headers but don't require that the
  implementation is included in the device. An application should not directly
  include this component. Include one or more of the BGAPI Service feature
  components to select the APIs that the application requires.
category: Bluetooth|Bluetooth Host (Stack)
quality: production
ui_hints:
  visibility: never
include:
- path: inc
  file_list:
  - path: sl_bgapi_service_api.h
other_file:
- path: api/sl_bgapi_service.xapi
provides:
- name: bgapi_service_api
template_contribution:
- name: component_catalog
  value: bgapi_service_api
metadata:
  sbom:
    license: Zlib AND MSLA
root_path: bgapi_protocol
