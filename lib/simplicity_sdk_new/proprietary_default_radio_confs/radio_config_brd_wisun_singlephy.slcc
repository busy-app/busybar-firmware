id: radio_config_brd_wisun_singlephy
label: Custom Radio Configuration for wisun singlephy application based on boards
package: proprietary_default_radio_confs
description: Triggers Radio Configurator UI for setting a proper based on radio boards
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: radio_config_brd_wisun_singlephy
- name: a_radio_config
ui_hints:
  visibility: never
template_contribution:
- name: component_catalog
  value: radio_config_simple_wisun_singlephy
config_file:


# xG23 NA_1_1b
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg23/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_210, hardware_board_default_rf_band_915]

# xG23 EU_1_1a
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg23/EU_1_1a/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_210, hardware_board_default_rf_band_868]

# xG23 CN_1_1b
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg23/CN_1_1b/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_210, hardware_board_default_rf_band_470]


# xG25 NA_1_1b
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg25/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_220, hardware_board_default_rf_band_915]

# xG25 EU_1_1a
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg25/EU_1_1a/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_220, hardware_board_default_rf_band_868]

# xG25 CN_1_1b
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg25/CN_1_1b/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_220, hardware_board_default_rf_band_470]

# xG28 NA_1_1b
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg28/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition: [device_sdid_235]

# radio settings based on IC chips
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg25/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition:
  - device_generic_family_efr32xg25
  unless:
  - hardware_board
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg28/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition:
  - device_generic_family_efr32xg28
  unless:
  - hardware_board
- path: WiSUN/brd_wisun_singlephy/device_generic_family_efr32xg23/NA_1_1b/radio_settings.radioconf
  directory: rail
  condition:
  - device_generic_family_efr32xg23
  unless:
  - hardware_board
root_path: proprietary_default_radio_confs
