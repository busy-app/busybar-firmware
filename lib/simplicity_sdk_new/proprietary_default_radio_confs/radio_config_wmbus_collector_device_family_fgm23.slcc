id: radio_config_wmbus_collector_device_family_fgm23
label: Custom Radio Configuration for Range Test Dualband Ocelot
package: proprietary_default_radio_confs
description: Triggers Radio Configurator UI for setting a proper (Application - Die - RF Band) Custom Radio Configurator
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: radio_config_wmbus_collector_device_family_fgm23
- name: a_radio_config
  allow_multiple: true
ui_hints:
  visibility: never
template_contribution:
- name: component_catalog
