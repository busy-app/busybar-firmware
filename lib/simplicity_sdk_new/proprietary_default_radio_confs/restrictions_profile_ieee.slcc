id: restrictions_profile_ieee802154
label: Restrictions - IEEE802154 Profile
package: proprietary_default_radio_confs
description: Component provides profile_ieee802154.restriction configuration files by logic
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
root_path: proprietary_default_radio_confs/restrictions
requires:
- name: rail_lib
- name: device_has_radio

#------- Set provided component name
provides:
- name: restrictions_profile_ieee802154

#-------- Include restriction config json file --------
#
# IEEE802154 Profile restrictions
#
config_file:
- path: profile_ieee802154.restriction
  directory: rail

#-------- Hides Component for user in Studio ---------
ui_hints:
  visibility: never


