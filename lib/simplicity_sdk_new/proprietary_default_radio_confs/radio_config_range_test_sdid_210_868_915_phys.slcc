id: radio_config_range_test_sdid_210_868_915_phys
label: Custom Radio Configuration for Range Test Dualband Ocelot
package: proprietary_default_radio_confs
description: Triggers Radio Configurator UI for setting a proper (Application - Die - RF Band) Custom Radio Configurator
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
provides:
- name: radio_config_range_test_sdid_210_868_915_phys
- name: a_radio_config
  allow_multiple: true
ui_hints:
  visibility: never
template_contribution:
- name: component_catalog
  value: radio_config_range_test_double_ocelot
- name: component_catalog
  value: radio_config_simple_rail_singlephy
config_file:
- path: Base/simple_rail_singlephy/device_generic_family_efr32xg23/rf_band_868/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - device_has_radio_subghz
  - device_generic_family_efr32xg23
  unless:
  - device_has_radio_2g4hz
  - device_has_radio_dualband
  - hardware_board_rb
  - hardware_board_tb
  - hardware_board_stk
  - device_supports_zwave
  - device_is_module
  - device_generic_family_efr32xg21
- path: Base/simple_rail_singlephy/device_generic_family_efr32xg23/rf_band_868/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - device_has_radio_subghz
  - device_generic_family_efr32xg23
  - device_supports_zwave
  unless:
  - device_has_radio_2g4hz
  - device_has_radio_dualband
  - hardware_board_rb
  - hardware_board_tb
  - hardware_board_stk
- path: Base/simple_rail_singlephy/device_generic_family_efr32xg23/rf_band_434/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_default_rf_band_434
  - device_generic_family_efr32xg23
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
  - device_supports_zwave
- path: Base/simple_rail_singlephy/device_generic_family_efr32xg23/rf_band_434/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_default_rf_band_434
  - device_generic_family_efr32xg23
  - device_supports_zwave
- path: Range_Test_sdid_210_868_915/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_supports_rf_band_868
  - hardware_board_supports_rf_band_915
  - device_generic_family_efr32xg23
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
- path: Range_Test_sdid_210_868_915/radio_settings.radioconf
  file_id: radio_configuration_settings
  directory: rail
  condition:
  - hardware_board_supports_rf_band_868
  - hardware_board_supports_rf_band_914
  - device_generic_family_efr32xg23
  unless:
  - device_is_module
  - device_generic_family_efr32xg21
root_path: proprietary_default_radio_confs
