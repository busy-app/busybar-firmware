id: restrictions_profile_sun
label: Restrictions - SUN Profile
package: proprietary_default_radio_confs
description: Component provides sun_profile.restriction configuration files by logic
category: Platform|Radio Configuration
quality: production
metadata:
  sbom:
    license: Zlib
root_path: proprietary_default_radio_confs/restrictions
requires:
- name: "rail_lib"
- name: "device_has_radio"

#------- Set provided component name
provides:
- name: restrictions_profile_sun

#-------- Include restriction config json file --------
#
# SUN profile RAIL restrictions
#
config_file:
- path: profile_sun.restriction
  directory: rail
  condition:
  - device_generic_family_efr32xg25

#-------- Hides Component for user in Studio ---------
ui_hints:
  visibility: never


