project_name: rail_soc_simple_trx_ncp_spi
label: "RAIL - NCP Simple TRX with CPC Support (SPI)"
package: "rail_sdk_sample_app"
description: >
  The Silicon Labs RAIL - NCP Simple TRX with CPC Support (SPI) sample
  application seamlessly integrates RAIL (Radio Abstraction Interface Layer)
  with CPC (Co-Processor Communication) via the SPI interface. In this example,
  the NCP (Network Co-Processor) device communicates with the host using CPC
  channels over SPI. The application initializes RAIL for a single PHY radio
  configuration, enabling transmit and receive operations. It serves as a
  foundational starting point for building more complex network protocols,
  leveraging the CPC feature for efficient communication between the host and
  the co-processor. Whether designing wireless mesh networks, sensor networks,
  or custom protocols, the Simple TRX with CPC Support (SPI) provides a
  practical foundation.
category: RAIL Examples
quality: production

#---------------- UC/UP components -------------------
component:
  - id: sl_main
  - id: clock_manager
  - id: device_init
  - id: board_control
    condition: [hardware_board]
  - id: sl_rail_util_init
    instance:
      - inst0
  - id: sl_rail_util_compatible_pa
  - id: radio_config_simple_rail_singlephy
  - id: sl_rail_sdk_packet_assistant
  - id: sl_rail_sdk_packet_asm
  - id: sl_rail_sdk_simple_assistance
#------------Memory Protection Unit-------------------
  - id: mpu
#--------------------- CPC -----------------------
  - id: sl_rail_sdk_simple_cpc_spi
#-------------- Restriction rules -------------------
  - id: restrictions_profile_base
  - id: restrictions_profile_connect
  - id: restrictions_profile_long_range
  - id: restrictions_profile_wisun_fan_1_0
  - id: restrictions_profile_wisun_fan_1_1
  - id: restrictions_profile_wisun_han
  - id: restrictions_profile_wisun_ofdm
  - id: restrictions_profile_connect_ofdm
  - id: restrictions_profile_sun
  - id: restrictions_profile_sidewalk
  - id: restrictions_profile_ieee802154_bpsk
#-----------------Series 3 OS-------------------------
  - id: freertos
    condition: [device_series_3]
#---------------Code Classification------------------
  - id: code_classification
#----------------- Require list ----------------------
requires:
  - name: a_radio_config
  - name: sl_rail_sdk_fifo_size
  - name: sl_rail_sdk_channel_selector
  - name: sl_rail_sdk_simple_os
    condition:
      - "kernel"
  - name: radio_config_singlephy_device_family_fgm23
    condition:
      - "device_family_fgm23"
  - name: simple_button
  - name: simple_led

#----------------- Project files ---------------------
include:
  - path: ../rail_soc_simple_trx/
    file_list:
    - path: app_init.h
    - path: app_process.h

source:
  - path: ../rail_soc_simple_trx/app_init.c
  - path: ../rail_soc_simple_trx/app_process.c
  - path: ../rail_soc_simple_trx/app_cli.c
    condition:
      - cli

readme:
  - path: ../../../documentation/example/rail_soc_simple_trx_ncp/readme_spi.md

other_file:
  - path: "hw_filter_tags.yaml"
    condition:
      - "add_hw_filter_to_project"

#------------ Configuration overrides ----------------
configuration:
  - name: SL_STACK_SIZE
    value: "2048"
#------------- FreeRTOS OS        --------------------
  - name: configMINIMAL_STACK_SIZE
    value: "1024"
#------------- Micrium OS / SystemView --------------------
  - name: CPU_CFG_TS_32_EN
    value: "1"
  - name: OS_CFG_DBG_EN
    value: "1"
  - name: OS_CFG_TS_EN
    value: "1"
  - name: OS_CFG_SCHED_ROUND_ROBIN_EN
    value: "1"
  - name: OS_CFG_STAT_TASK_EN
    value: "1"
  - name: OS_CFG_TASK_PROFILE_EN
    value: "1"
#------------- RAIL init, Project --------------------
  - name: SL_RAIL_UTIL_INIT_INIT_COMPLETE_CALLBACK_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_RADIO_CONFIG_SUPPORT_INST0_ENABLE
    value: "1"
#------------- RAIL init, FIFOs ---------------
  - name: SL_RAIL_UTIL_INIT_RX_FIFO_INST0_BYTES
    value: "256"
  - name: SL_RAIL_UTIL_INIT_TX_FIFO_INST0_BYTES
    value: "256"
#------------- RAIL init, Protocol -------------------
  - name: SL_RAIL_UTIL_INIT_PROTOCOLS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_PROTOCOL_INST0_DEFAULT
    value: "SL_RAIL_UTIL_PROTOCOL_PROPRIETARY"
#------------- Disable RAIL not needed protocols -----
  - name: SL_RAIL_UTIL_PROTOCOL_BLE_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_IEEE802154_2P4GHZ_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_IEEE802154_GB868_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_ZWAVE_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_PROTOCOL_SIDEWALK_ENABLE
    value: "0"
#------------- RAIL init, Calibrations ---------------
  - name: SL_RAIL_UTIL_INIT_CALIBRATIONS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_TEMPERATURE_NOTIFY_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_CALIBRATION_ONETIME_NOTIFY_INST0_ENABLE
    value: "1"
#------------- RAIL init, Auto Transitions -----------
  - name: SL_RAIL_UTIL_INIT_TRANSITIONS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_TX_SUCCESS
    value: "RAIL_RF_STATE_RX"
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_TX_ERROR
    value: "RAIL_RF_STATE_RX"
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_SUCCESS
    value: "RAIL_RF_STATE_RX"
  - name: SL_RAIL_UTIL_INIT_TRANSITION_INST0_RX_ERROR
    value: "RAIL_RF_STATE_RX"
#------------- RAIL init, Data Format ----------------
  - name: SL_RAIL_UTIL_INIT_DATA_FORMATS_INST0_ENABLE
    value: "1"
#------------- RAIL init, Radio Events ---------------
  - name: SL_RAIL_UTIL_INIT_EVENTS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_PREAMBLE_LOST_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_RECEIVED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_ADDRESS_FILTERED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_FRAME_ERROR_INST0_ENABLE
    value: "0"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_PACKET_ABORTED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_PACKET_SENT_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_ABORTED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_BLOCKED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_FIFO_OVERFLOW_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_UNDERFLOW_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_CHANNEL_BUSY_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_TX_SCHEDULED_RX_TX_STARTED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_RX_SCHEDULED_RX_MISSED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_TX_SCHEDULED_TX_MISSED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_CONFIG_UNSCHEDULED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_CONFIG_SCHEDULED_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_SCHEDULER_STATUS_INST0_ENABLE
    value: "1"
  - name: SL_RAIL_UTIL_INIT_EVENT_CAL_NEEDED_INST0_ENABLE
    value: "1"
#------------- RAIL init, PA ---------------
  - name: SL_RAIL_UTIL_PA_SELECTION_SUBGHZ
    value: "RAIL_TX_POWER_MODE_SUBGIG_POWERSETTING_TABLE"
    condition: [device_generic_family_efr32xg25]
  - name: SL_RAIL_UTIL_PA_SELECTION_OFDM
    condition: [device_generic_family_efr32xg25]
    value: "RAIL_TX_POWER_MODE_OFDM_PA_POWERSETTING_TABLE"
#------------- RFFPLL init ----------------
  - name: SL_CLOCK_MANAGER_RFFPLL_BAND
    value: "1"
    condition:
      - "device_generic_family_efr32xg25"
      - "hardware_board_default_rf_band_470"
  - name: SL_CLOCK_MANAGER_RFFPLL_BAND
    value: "0"
    condition:
      - "device_generic_family_efr32xg25"
      - "hardware_board_default_rf_band_450"
#------------- Other project settings ----------------
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_CLI_LOCAL_ECHO
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: "usartHwFlowControlCtsAndRts"
  - name: SL_IOSTREAM_EUSART_VCOM_CONVERT_BY_DEFAULT_LF_TO_CRLF
    value: "(1)"
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition:
      - device_series_2
  - name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: "SL_IOSTREAM_EUSART_UART_FLOW_CTRL_CTS_RTS"
    condition:
      - device_series_3
  - name: APP_LOG_PREFIX_ENABLE
    value: "0"

#-------------- Template Contribution ----------------
template_contribution:
#------------------ CLI commands ---------------------
  - name: cli_command
    value:
      name: info
      handler: cli_info
      help: Unique ID of the MCU
    condition:
      - "cli"
  - name: cli_command
    value:
      name: send
      handler: cli_send_packet
      help: Send a packet
    condition:
      - "cli"
  - name: cli_command
    value:
      name: receive
      handler: cli_receive_packet
      help: Turn ON/OFF received message forwarding on CLI
      argument:
      - type: uint8
        help: ON/OFF
    condition:
      - "cli"

#--------------------- Toolchain ------------------------
toolchain_settings:
  - option: optimize
    value: debug

ui_hints:
  highlight:
    - path: "config/rail/radio_settings.radioconf"
    - path: "readme.md"
      focus: true

#--------------------- HWFILTER ------------------------
tag:

  - hwfilter:board:hardware:has:vcom
  - hwfilter:board:hardware:has:pti
  - hwfilter:board:simple_led:led0
  - hwfilter:board:simple_button:btn0
  - hwfilter:!board:hardware:shares:button:led
  - hwfilter:ram:11k
  - hwfilter:flash:169k
  - hwfilter:!device:device_generic_family_efr32xg21
  - hwfilter:!device:device_family_zgm23
  - hwfilter:!board:brd2600a
  - hwfilter:!device:device_family_mgm26
  - hwfilter:!device:device_family_mgm27
  - hwfilter:!device:device_family_bgm24
  - hwfilter:!device:device_family_mgm24
  - hwfilter:!board:brd4183b
  - hwfilter:!board:brd2608a
  - hwfilter:!board:brd2703a
  - hwfilter:!board:brd2705a
  - hwfilter:!board:brd2709a
  - hwfilter:!board:brd2710a
  - hwfilter:!board:brd2719a
  - hwfilter:!board:brd4108a
  - hwfilter:!board:brd4118a
  - hwfilter:!board:brd4120a
  - hwfilter:!board:brd4121a
  - hwfilter:!board:brd4183a
  - hwfilter:!board:brd4183c
  - hwfilter:!board:brd4400a
  - hwfilter:!board:brd4400b
  - hwfilter:!board:brd4400c
  - hwfilter:!board:brd4401a
  - hwfilter:!board:brd4401b
  - hwfilter:!board:brd4401c
  - hwfilter:!board:brd4403a
  - hwfilter:!board:brd4403b
  - hwfilter:!board:brd4403c
  - hwfilter:!board:brd4421a


filter:
  - name: "Wireless Technology"
    value: ["RAIL"]
  - name: "Device Type"
    value: ["NCP"]
  - name: "Project Difficulty"
    value: ["Beginner"]
