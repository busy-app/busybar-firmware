project_name: wisun_rcp
label: Wi-SUN - RCP
description: >
  The Wi-SUN RCP (radio coprocessor) application provides a radio interface to a
  Linux host. It is meant to be paired with wsbrd (Wi-SUN Network
  implementation for Linux) to run as a Linux border router device.
package: wisun_rcp_app
category: Wi-SUN Examples
quality: production


component:
  - id: wisun_stack_debug
  - id: iostream_rtt
  - id: iostream_retarget_stdio
  - id: wisun_default_radioconf
  - id: wisun_rcp_app
  - id: cpc_secondary_recommended_uart_interface
    condition: [cpc_secondary]

configuration:
  - name: SL_CPC_RX_PAYLOAD_MAX_LENGTH
    value: 2038
    condition: [cpc_secondary]
  - name: SL_CPC_TX_QUEUE_ITEM_MAX_COUNT
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_VCOM_RX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_VCOM_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_EXP_RX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_EXP_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_MIKROE_RX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_UART_MIKROE_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_RX_BUFFER_MAX_COUNT
    value: 3
    condition: [cpc_secondary, cpc_secondary_driver_spi]
  - name: SL_CPC_DRV_SPI_EXP_RX_QUEUE_SIZE
    value: 3
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_SPI_EXP_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_SPI_MIKROE_RX_QUEUE_SIZE
    value: 3
    condition: [cpc_secondary]
  - name: SL_CPC_DRV_SPI_MIKROE_TX_QUEUE_SIZE
    value: 2
    condition: [cpc_secondary]
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: OS_CFG_APP_HOOKS_EN
    value: 1
    condition: [micriumos_kernel]
  - name: OS_CFG_DBG_EN
    value: 1
    condition: [micriumos_kernel]
  - name: SL_RAIL_UTIL_PTI_BAUD_RATE_HZ
    value: 3200000
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2048
  - name: SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_SELECTION
    value: "SL_RAIL_UTIL_SFM_SEQUENCER_SUN_MODULATIONS_OFDM"
    condition: [device_sdid_220]

toolchain_settings:
  - option: optimize
    value: size
    unless: [wisun_stack_debug]

readme:
  - path: doc/readme.md

other_file:
  - path: doc/readme_img0.png
  - path: doc/readme_img1.png

ui_hints:
  highlight:
    - path: doc/readme.md
      focus: true

tag:
  - prebuilt_demo
  - hwfilter:device:device_supports_wisun

filter:
  - name: Wireless Technology
    value: [Wi-SUN]
  - name: Device Type
    value: [RCP]
  - name: Project Difficulty
    value: [Advanced]
