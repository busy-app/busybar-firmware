Import("env")

LIB_FOLDER = "lvgl_addons"

env.Append(
    CPPPATH=[
        Dir(LIB_FOLDER).srcnode(),
    ],
    LINT_SOURCES=[
        Dir(LIB_FOLDER).srcnode(),
    ],
)

libenv = env.Clone(FW_LIB_NAME=LIB_FOLDER)
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CPPDEFINES=[
        "LV_LVGL_H_INCLUDE_SIMPLE",
    ]
)

sources = []
sources += libenv.Glob(LIB_FOLDER + "/fonts/src/*.c", source=True)
sources += libenv.Glob(LIB_FOLDER + "/themes/*.c", source=True)
sources += libenv.Glob(LIB_FOLDER + "/fs/*.c", source=True)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
