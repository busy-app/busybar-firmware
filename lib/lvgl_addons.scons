Import("env")

LIB_FOLDER = "lvgl_addons"

FONTS_FOLDER = LIB_FOLDER + "/fonts"
THEMES_FOLDER = LIB_FOLDER + "/themes"
STORAGE_FOLDER = LIB_FOLDER + "/fs"

env.Append(
    CPPPATH=[
        Dir(LIB_FOLDER).srcnode(),
    ],
    LINT_SOURCES=[
        Dir(THEMES_FOLDER).srcnode(),
        Dir(STORAGE_FOLDER).srcnode(),
    ],
)

libenv = env.Clone(FW_LIB_NAME=LIB_FOLDER)
libenv.ApplyLibFlags()

libenv.AppendUnique(
    CPPDEFINES=[
        "LV_LVGL_H_INCLUDE_SIMPLE",
    ]
)

sources = []
sources += libenv.Glob(FONTS_FOLDER + "/src/*.c", source=True)
sources += libenv.Glob(THEMES_FOLDER + "/*.c", source=True)
sources += libenv.Glob(STORAGE_FOLDER + "/*.c", source=True)

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
