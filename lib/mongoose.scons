Import("env")

env.Append(
    CPPPATH=[
        "#/lib/mongoose",
    ],
    CCFLAGS=[
        "-Wno-double-promotion",  # TODO:
        "-Wno-redundant-decls",
    ],
)

libenv = env.Clone(FW_LIB_NAME="mongoose")
libenv.ApplyLibFlags()

sources = [
    "mongoose/mongoose.c",
]

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
