App(
    appid="update_cli",
    name="update",
    apptype=FlipperAppType.CLICMD,
    sources=[
        "update_cli.c",
        "sl_updater/sl_updater.c",
        "helpers/fkermit.c",
    ],
    entry_point="update_cli_command",
    requires=["storage", "updater", "cli_commands_target_specific"],
)

App(
    appid="update_executor",
    name="UpdateExecutorSvc",
    apptype=FlipperAppType.SERVICE,
    sources=[
        "update_executor/update_executor.c",
        "update_executor/worker/*.c",
        "update_executor/scenes/*.c",
        "sl_updater/sl_updater.c",
        "helpers/fkermit.c",
        "session/*.c",
    ],
    entry_point="update_executor_srv",
    requires=[
        "gui",
        "storage",
        "font_registry",
    ],
    stack_size=2 * 1024,
    order=300,
    targets=["f20", "f21", "f22"],
)

App(
    appid="updater",
    name="UpdaterSvc",
    apptype=FlipperAppType.SERVICE,
    sources=[
        "updater.c",
        "settings/*.c",
        "helpers/rps.c",
        "helpers/update_parser.c",
        "update_checker/*.c",
        "session/*.c",
    ],
    entry_point="updater_srv",
    requires=[
        "storage",
        "power_srv",
        "network",
        "cli_commands_target_specific",
    ],
    stack_size=4 * 1024,
    order=310,
    targets=["f20", "f21", "f22"],
)

App(
    appid="update_ui",
    name="UpdateUI",
    apptype=FlipperAppType.STARTUP,
    sources=[
        "update_ui/update_ui.c",
        "update_ui/scenes/*.c",
    ],
    entry_point="update_ui_startup",
    requires=[
        "gui",
        "updater",
    ],
    stack_size=1 * 1024,
    order=320,
    targets=["f20", "f21", "f22"],
)
