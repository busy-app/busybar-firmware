App(
    appid="system_apps",
    name="Applications not shown in menus",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "apps_menu",
        "message",
        "sl_update_start",
    ],
    targets=["f20", "f21"],
)

App(
    appid="system_apps",
    name="Basic applications for system menu",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "system_apps_on_start",
    ],
    targets=["f64"],
)

App(
    appid="system_apps_on_start",
    name="On start hooks",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "wifi_cli_test_start",
        "wifi_calibration_start",
        "wifi_rf_test_start",
        "wifi_test_start",
        "ble_test_start",
        "ble_ibeacon_start",
        "ble_per_test_start",
        "ble_usart_echo_start",
        "crypto_test_start",
        "nvm3_test_start",
    ],
    targets=["f64"],
)
