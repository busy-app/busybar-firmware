App(
    appid="sysctl",
    apptype=FlipperAppType.STARTUP,
    entry_point="sysctl_on_system_start",
    sources=["sysctl.c", "settings/*.c"],
    provides=["sysctl_cmd"],
    stack_size=2 * 1024,
    order=35,
    targets=["f20", "f21", "f22"],
)

App(
    appid="sysctl_cmd",
    name="sysctl",
    apptype=FlipperAppType.CLICMD,
    entry_point="cli_command_sysctl",
    sources=["sysctl_cli.c"],
    requires=["sysctl"],
    targets=["f20", "f21", "f22"],
)
