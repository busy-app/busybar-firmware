App(
    appid="cli",
    name="CliSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="cli_srv",
    cdefines=["SRV_CLI"],
    stack_size=4 * 1024,
    order=30,
    sdk_headers=["cli.h", "cli_vcp.h"],
    targets=["f20"],
    sources=[
        "cli_u5.c",
        "cli_command_gpio.c",
        "cli_commands_u5.c",
        "cli_command_display.c",
        "cli_command_status_lights.c",
    ],
)
