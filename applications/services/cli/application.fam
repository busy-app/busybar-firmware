App(
    appid="cli",
    name="CliSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="cli_srv",
    cdefines=["SRV_CLI"],
    stack_size=4 * 1024,
    order=30,
    sdk_headers=["cli.h", "cli_vcp.h"],
    targets=["f20", "f21"],
    sources=[
        "cli.c",
        "cli_commands.c",
        "cli_command_gpio.c",
        "cli_command_display.c",
        "cli_command_status_lights.c",
        "cli_command_light_sensor.c",
        "cli_command_audio.c",
        "cli_command_sl_cli.c",
        "cli_command_factory_reset.c",
    ],
)
