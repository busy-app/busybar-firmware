App(
    appid="ble",
    name="BleSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="ble_srv",
    stack_size=4 * 1024,
    order=140,
    targets=["f64", "f65"],
    requires=["intercom", "nvm"],
    sources=[
        "ble.c",
        "ble_system_command.c",
        "ble_system_command_917.c",
        "ble_command_engine.c",
        # worker
        "worker/ble_worker.c",
        "worker/ble_worker_util.c",
        "worker/_nwp_callbacks/ble_nwp_core_callbacks.c",
        "worker/event_processor/ble_event_handlers_gap.c",
        "worker/event_processor/ble_event_handlers_gatt.c",
        "worker/event_processor/ble_event_handlers_smp.c",
        "worker/event_processor/ble_incoming_nwp_event.c",
        "worker/event_processor/ble_incoming_nwp_event_processor.c",
        "worker/transport/ble_receiver.c",
        "worker/transport/ble_transmitter.c",
        "worker/transport/ble_transmitter_indicate.c",
        "worker/transport/ble_transmitter_set.c",
        "worker/device/ble_advertise.c",
        "worker/device/ble_connection.c",
        "worker/device/ble_device.c",
        "worker/device/ble_device_base.c",
        "worker/device/ble_security.c",
        "worker/device/ble_service_registry.c",
        # service
        "service/ble_characteristic.c",
        "service/ble_service.c",
        "service/ble_service_config.c",
        "service/ble_service_frame.c",
        "service/target/ble_service_target_917.c",
        "service/gap_and_gatt/generic_access.c",
        "service/gap_and_gatt/generic_access_917.c",
        "service/gap_and_gatt/generic_attribute.c",
        "service/device_info/ble_service_device_info.c",
        "service/battery/ble_service_battery.c",
        "service/battery/ble_service_battery_917.c",
        "service/uart/ble_service_uart.c",
        "util/ble_canary.c",
    ],
)

App(
    appid="ble",
    name="BleSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="ble_srv",
    cdefines=["SRV_BLE"],
    stack_size=2 * 1024,
    order=140,
    targets=["f20", "f21", "f22"],
    requires=["intercom"],
    sources=[
        "ble.c",
        "ble_api.c",
        "ble_system_command.c",
        "ble_system_command_u5.c",
        "ble_command_engine.c",
        "http/ble_http_repeater.c",
        "streaming/ble_streaming.c",
        # settings
        "settings/interface_v1.c",
        "settings/settings.c",
        # service
        "service/ble_characteristic.c",
        "service/ble_service.c",
        "service/ble_service_config.c",
        "service/ble_service_frame.c",
        "service/gap_and_gatt/generic_access.c",
        "service/gap_and_gatt/generic_access_u5.c",
        "service/gap_and_gatt/generic_attribute.c",
        "service/target/ble_service_target_u5.c",
        "service/device_info/ble_service_device_info.c",
        "service/battery/ble_service_battery.c",
        "service/battery/ble_service_battery_u5.c",
        "service/uart/ble_service_uart.c",
        "util/ble_canary.c",
    ],
)
