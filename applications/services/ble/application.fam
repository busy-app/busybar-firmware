App(
    appid="ble",
    name="BleSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="ble_srv",
    stack_size=4 * 1024,
    order=140,
    targets=["f64"],
    requires=["intercom"],
    sources=[
        "ble.c",
        "ble_command_917.c",
        "worker/*.c",
        "service/*.c",
        "service/target/ble_service_target_917.c",
        "service/device_info/*.c",
        "service/battery/ble_service_battery.c",
        "service/battery/ble_service_battery_917.c",
        "service/uart/*.c",
    ],
)

