App(
    appid="cli_commands_common",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "uptime_cmd",
        "log_cmd",
        "top_cmd",
        "free_cmd",
        "free_blocks_cmd",
        "echo_cmd",
    ],
)

App(
    appid="uptime_cmd",
    name="uptime",
