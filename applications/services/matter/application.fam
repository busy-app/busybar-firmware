App(
    appid="matter",
    name="MatterSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="matter_srv",
    stack_size=8 * 1024,
    order=200,
    targets=["f64"],
    requires=[
        "intercom",
        "wifi",
        "nvm",
    ],
    sources=[
        "matter_f64.cpp",
    ],
)

App(
    appid="matter",
    name="MatterSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="matter_srv",
    stack_size=4 * 1024,
    order=250,
    targets=["f20", "f21"],
    requires=["intercom"],
    provides=["matter_cli"],
    sources=[
        "matter.c",
    ],
)

App(
    appid="matter_cli",
    name="matter",
    apptype=FlipperAppType.CLICMD,
    entry_point="matter_cli_command",
    stack_size=2 * 1024,
    targets=["f20", "f21"],
    requires=["matter"],
    sources=[
        "matter_cli.c",
    ],
)
