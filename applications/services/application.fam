App(
    appid="basic_services",
    name="Basic services",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "audio",
        "storage",
        "cli",
        "cli_socket",
        "input",
        "gui",
        "lottie",
        "desktop",
        "loader",
        "front_display",
        "back_display",
        "usb_srv",
        "web_server",
        "power_srv",
        "intercom",
        "wifi",
        "sockets",
        "status_lights",
        "light_sensor",
        "power_popup",
    ],
    targets=["f20", "f21"],
)

App(
    appid="basic_services",
    name="Basic services",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        "cli",  # Enabled in "hwtest" fw config (FIRMWARE_APP_SET)
        "input",
    ],
    targets=["f64"],
)

App(
    appid="intercom_services",
    name="U5<>917 intercom services",
    apptype=FlipperAppType.METAPACKAGE,
    provides=[
        # "intercom",  # Enabled in default fw config
        # "wifi",  # Enabled by "sockets"
        "sockets",
        "status_lights",
    ],
    targets=["f64"],
)
