App(
    appid="power_srv",
    name="PowerSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="power_srv_app",
    stack_size=2 * 1024,
    provides=[
        "power_srv_start",
    ],
    sdk_headers=["power_service/power.h"],
    order=80,
    targets=["f20", "f21"],
)

App(
    appid="power_srv_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="power_on_system_start",
    requires=["power_srv"],
    order=80,
)
