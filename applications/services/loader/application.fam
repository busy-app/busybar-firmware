App(
    appid="loader",
    name="LoaderSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="loader_srv",
    cdefines=["SRV_LOADER"],
    stack_size=2 * 1024,
    order=120,
    targets=["f20", "f21", "f22"],
    sources=["loader.c"],
    provides=["loader_cmd"],
)

App(
    appid="loader_cmd",
    name="loader",
    apptype=FlipperAppType.CLICMD,
    entry_point="loader_cli_command",
    requires=["loader"],
    sources=["loader_cli.c"],
)
