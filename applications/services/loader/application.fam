App(
    appid="loader",
    name="LoaderSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="loader_srv",
    cdefines=["SRV_LOADER"],
    stack_size=2 * 1024,
    order=90,
    targets=["f20"],
    sources=["loader.c"],
    provides=["loader_start"],
)

App(
    appid="loader_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="loader_on_system_start",
    requires=["loader"],
    sources=["loader_cli.c"],
    order=90,
)
