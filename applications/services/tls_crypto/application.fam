App(
    appid="tls_crypto",
    name="TlsCryptoSrv",
    apptype=FlipperAppType.STARTUP,
    entry_point="tls_crypto_startup",
    order=20,
    targets=["f20", "f21", "f22"],
    stack_size=1024 * 1,
    sources=[
        "tls_crypto.c",
        "tls_crypto_common.c",
    ],
)

App(
    appid="tls_crypto",
    name="TlsCryptoSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="tls_crypto_srv",
    requires=["intercom"],
    stack_size=1 * 1024,
    order=90,
    targets=["f64", "f65"],
    sources=[
        "tls_crypto_backend.c",
        "tls_crypto_common.c",
    ],
)

App(
    appid="tls_crypto_test_cmd",
    name="tls_crypto_test",
    apptype=FlipperAppType.CLICMD,
    entry_point="cli_command_tls_crypto_test",
    requires=["tls_crypto"],
    targets=["f20", "f21", "f22"],
    sources=["tls_crypto_test.c"],
)
