App(
    appid="storage",
    name="StorageSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="storage_srv",
    stack_size=1024 * 8,
    order=5,
    provides=["storage_start"],
    sources=[
        "filesystem_api.c",
        "storage_u5.c",
        "storage_external_api_u5.c",
        "storage_internal_api.c",
        "storage_glue.c",
        "storage_processing_u5.c",
        "storage_sd_api.c",
        "storage_posix_api.c",
        "storages/storage_ext_sdmmc.c",
    ],
    targets=["f20", "f21"],
)

App(
    appid="storage_start",
    apptype=FlipperAppType.STARTUP,
    entry_point="storage_on_system_start",
    requires=["storage"],
    order=90,
    targets=["f20", "f21"],
    sources=["storage_cli_u5.c"],
)
