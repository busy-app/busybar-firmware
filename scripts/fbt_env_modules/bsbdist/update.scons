from enum import IntFlag

Import("U5_ENV", "SIL_ENV", "DIST_ENV")


# Must match UpdateManifestSecurityFlag in update_manifest.h
class UpdateManifestSecurityFlag(IntFlag):
    NwpSigned = 1 << 0
    M4Signed = 1 << 1
    NwpEncrypted = 1 << 2
    M4Encrypted = 1 << 3
    U5Encrypted = 1 << 4


dist_env = DIST_ENV
u5_env = U5_ENV
sil_env = SIL_ENV
fw_env = u5_env["FW_ENV"]

# Environment with update bundle builder, configured with common bundle parameters
_fw_version_json = fw_env.get("FW_VERSION_JSON")
bundle_env = dist_env.Clone(
    tools=["bsb_update_bundle"],
    BUNDLE_TARGET_HW=u5_env.subst("$TARGET_HW"),
    BUNDLE_STAGE=u5_env["UPD_ENV"]["FW_BIN"][0],
    BUNDLE_DFU=fw_env["FW_DFU"][0],
    BUNDLE_SIL_FW=sil_env["FW_ENV"]["FW_RPS"][0],
    **({"BUNDLE_VERSION_JSON": _fw_version_json} if _fw_version_json else {}),
)

# Common dependencies shared by all bundle variants
base_deps = [
    u5_env["UPD_ENV"]["FW_BIN"],
    fw_env["FW_DFU"],
    sil_env["FW_ENV"]["FW_RPS"],
    *([_fw_version_json] if _fw_version_json else []),
]

# --- Full update bundle (with resources + radio firmware) ---

full_env = bundle_env.Clone(
    BUNDLE_RESOURCES=fw_env["RESOURCES_ROOT"],
    BUNDLE_SIL_RADIO_FW=dist_env.Real(sil_env["SI917_NWP_STACK"]),
)

update_tar = full_env.UpdateBundle(
    fw_env.File("${BUILD_DIR}/update_${F_TARGET_HW}"),
    [],
)
Depends(update_tar, base_deps + [fw_env["FW_RESOURCES_MANIFEST"]])

update_tgz = bundle_env.CompressBundle(
    fw_env.File("${BUILD_DIR}/update_${F_TARGET_HW}.tgz"),
    update_tar,
)

bundle_env.FlashOverHttp("flash_usb", update_tgz)
bundle_env.FlashOverHttp("flash_usb_tar", update_tar)

# --- Minimal update bundle (no resources, no radio firmware) ---

min_update_tar = bundle_env.UpdateBundle(
    fw_env.File("${BUILD_DIR}/min_update_${F_TARGET_HW}"),
    [],
)
Depends(min_update_tar, base_deps)

min_update_tgz = bundle_env.CompressBundle(
    fw_env.File("${BUILD_DIR}/min_update_${F_TARGET_HW}.tgz"),
    min_update_tar,
)

bundle_env.FlashOverHttp("flash_usb_min", min_update_tgz)
bundle_env.FlashOverHttp("flash_usb_min_tar", min_update_tar)

# --- Recovery bundle (with resources + radio firmware + bkp resources) ---

bkp_env = full_env.Clone(
    BUNDLE_BKP_RESOURCES=fw_env["BKP_RESOURCES_ROOT"],
)

bkp_tar = bkp_env.UpdateBundle(
    fw_env.File("${BUILD_DIR}/bkp_${F_TARGET_HW}"),
    [],
)
Depends(
    bkp_tar,
    base_deps + [fw_env["FW_RESOURCES_MANIFEST"], fw_env["FW_BKP_RESOURCES"]],
)

update_bkp_tgz = bundle_env.CompressBundle(
    fw_env.File("${BUILD_DIR}/bkp_${F_TARGET_HW}.tgz"),
    bkp_tar,
)

# --- Dist folder ---

dist_flavor = "".join(
    ["C" if u5_env["COMPACT"] else "", "D" if u5_env["DEBUG"] else ""]
)

dist_dir_path = "${PROJECT_ROOT}/dist/${F_TARGET_HW}"
if dist_flavor:
    dist_dir_path += f"-{dist_flavor}"

dist_dir = u5_env.Dir(dist_dir_path)


def _dist_file(name, ext):
    return dist_dir.File(
        u5_env.subst(f"busybar-${{F_TARGET_HW}}-{name}-${{DIST_SUFFIX}}.{ext}")
    )


installs = [
    # Update bundles
    InstallAs(_dist_file("update", "tgz"), update_tgz),
    InstallAs(_dist_file("bkp", "tgz"), update_bkp_tgz),
    # U5 firmware artifacts
    InstallAs(_dist_file("firmware", "elf"), fw_env["FW_ELF"][0]),
    InstallAs(_dist_file("firmware", "dfu"), fw_env["FW_DFU"][0]),
    InstallAs(_dist_file("firmware", "bin"), fw_env["FW_BIN"][0]),
    # Updater artifacts
    InstallAs(_dist_file("updater", "elf"), u5_env["UPD_ENV"]["FW_ELF"][0]),
    InstallAs(_dist_file("updater", "bin"), u5_env["UPD_ENV"]["FW_BIN"][0]),
    # Silabs artifacts
    InstallAs(_dist_file("sil_firmware", "rps"), sil_env["FW_ENV"]["FW_RPS"][0]),
    InstallAs(_dist_file("sil_firmware", "elf"), sil_env["FW_ENV"]["FW_ELF"][0]),
    InstallAs(_dist_file("sil_nwp", "rps"), sil_env["FW_ENV"]["SI917_NWP_STACK"]),
]

_openapi_dist = InstallAs(_dist_file("openapi", "yaml"), fw_env["FW_OPENAPI_YAML"])
installs.append(_openapi_dist)

Default(installs)

dist_env.Alias("openapi_dist", _openapi_dist)

dist_env.Alias("update_bundle", update_tar)
dist_env.Alias("dist", installs)

# --- Signed builds (local keystore signing or signing-service signing) ---

sil_sign_keystore = sil_env.subst("${SI917_SIGN_KEYSTORE}")
sil_sign_service_url = sil_env.subst("${SI917_SIGN_SERVICE_URL}")
sil_sign_service_token = sil_env.subst("${SI917_SIGN_SERVICE_TOKEN}")
sil_sign_service_profile = sil_env.subst("${SI917_SIGN_SERVICE_PROFILE}")

service_signing_configured = any(
    [
        sil_sign_service_url,
        sil_sign_service_token,
        sil_sign_service_profile,
    ]
)
service_signing_enabled = all(
    [
        sil_sign_service_url,
        sil_sign_service_token,
        sil_sign_service_profile,
    ]
)

if service_signing_configured and not service_signing_enabled:
    raise ValueError(
        "SI917 signing service requires SI917_SIGN_SERVICE_URL, "
        "SI917_SIGN_SERVICE_TOKEN, and SI917_SIGN_SERVICE_PROFILE"
    )

if sil_sign_keystore or service_signing_enabled:
    sign_env = dist_env.Clone(
        tools=["fwsign_silabs"],
        SI917_SIGN_KEYSTORE=sil_sign_keystore,
        SI917_SIGN_SERVICE_URL=sil_sign_service_url,
        SI917_SIGN_SERVICE_TOKEN=sil_sign_service_token,
        SI917_SIGN_SERVICE_PROFILE=sil_sign_service_profile,
        COMMANDER_CLI=sil_env.subst("${COMMANDER_CLI}"),
    )

    # Sign firmware RPS
    signed_fw_rps = sign_env.RPSSign(
        fw_env.File("${BUILD_DIR}/sil_firmware_signed.rps"),
        sil_env["FW_ENV"]["FW_RPS"][0],
    )

    # Sign NWP stack RPS
    signed_nwp_rps = sign_env.RPSSign(
        fw_env.File("${BUILD_DIR}/sil_nwp_signed.rps"),
        dist_env.File(sil_env["SI917_NWP_STACK"]),
    )

    # Signed update bundle (full, with resources + signed Silabs firmwares)
    signed_bundle_env = bundle_env.Clone(
        BUNDLE_SIL_FW=signed_fw_rps[0],
        BUNDLE_RESOURCES=fw_env["RESOURCES_ROOT"],
        BUNDLE_SIL_RADIO_FW=signed_nwp_rps[0],
        BUNDLE_SECURITY_FLAGS=str(
            int(
                UpdateManifestSecurityFlag.NwpSigned
                | UpdateManifestSecurityFlag.M4Signed
            )
        ),
    )

    signed_update_tar = signed_bundle_env.UpdateBundle(
        fw_env.File("${BUILD_DIR}/update_signed_${F_TARGET_HW}"),
        [],
    )
    Depends(
        signed_update_tar,
        base_deps + [fw_env["FW_RESOURCES_MANIFEST"], signed_fw_rps, signed_nwp_rps],
    )

    signed_update_tgz = bundle_env.CompressBundle(
        fw_env.File("${BUILD_DIR}/update_signed_${F_TARGET_HW}.tgz"),
        signed_update_tar,
    )

    # Signed recovery bundle (full + bkp resources + signed Silabs firmwares)
    signed_bkp_env = signed_bundle_env.Clone(
        BUNDLE_BKP_RESOURCES=fw_env["BKP_RESOURCES_ROOT"],
    )

    signed_bkp_tar = signed_bkp_env.UpdateBundle(
        fw_env.File("${BUILD_DIR}/bkp_signed_${F_TARGET_HW}"),
        [],
    )
    Depends(
        signed_bkp_tar,
        base_deps
        + [
            fw_env["FW_RESOURCES_MANIFEST"],
            fw_env["FW_BKP_RESOURCES"],
            signed_fw_rps,
            signed_nwp_rps,
        ],
    )

    signed_bkp_tgz = bundle_env.CompressBundle(
        fw_env.File("${BUILD_DIR}/bkp_signed_${F_TARGET_HW}.tgz"),
        signed_bkp_tar,
    )

    signed_installs = [
        InstallAs(_dist_file("update_signed", "tgz"), signed_update_tgz),
        InstallAs(_dist_file("bkp_signed", "tgz"), signed_bkp_tgz),
        InstallAs(_dist_file("sil_firmware_signed", "rps"), signed_fw_rps),
        InstallAs(_dist_file("sil_nwp_signed", "rps"), signed_nwp_rps),
    ]

    dist_env.Alias("dist_signed", signed_installs)

    bundle_env.FlashOverHttp("flash_usb_signed", signed_update_tgz)
    bundle_env.FlashOverHttp("flash_usb_signed_tar", signed_update_tar)
