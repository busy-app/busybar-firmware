Import("FW_ENV")
fwenv = FW_ENV

from SCons.Util import splitext
from fbt.version import get_git_commit_unix_timestamp

fwenv.SetDefault(BKP_RESOURCES_ROOT=fwenv.Dir("${BUILD_DIR}/resources_bkp"))

fw_assets_env = fwenv.Clone(tools=["bsb_assets"])

if fwenv.get("IS_BASE_FIRMWARE", False):
    assets_dir = fwenv.Dir("${BUILD_DIR}/resources_bkp")
    resources_dist = []

    # Animations
    anim_src_files = fwenv.GlobRecursive("*.zip", Dir("#/assets_bkp/animations/"))

    for f in anim_src_files:
        file_node = assets_dir.File(
            f.Dir(".").name + "/animations/" + splitext(f.name)[0] + ".anim"
        )
        resources_dist.extend(fw_assets_env.AnimationConverter(file_node, f))

    fwenv.Replace(FW_BKP_RESOURCES=resources_dist)
