Import("FW_ENV")
fwenv = FW_ENV

import os
from SCons.Util import splitext
from fbt.version import get_git_commit_unix_timestamp

fwenv.SetDefault(RESOURCES_ROOT=fwenv.Dir("${BUILD_DIR}/resources"))

fw_assets_env = fwenv.Clone(tools=["bsb_assets"])


def convert_sounds(src_dir, dst_dir):
    src_files = fwenv.GlobRecursive("*.wav", Dir(src_dir + "sounds/"))
    converted = []

    for f in src_files:
        app_name = "" if (f.Dir(".").name == "sounds") else (f.Dir(".").name + "/")
        file_node = dst_dir.File(app_name + "sounds/" + splitext(f.name)[0] + ".snd")
        converted.append(fw_assets_env.AudioConverter(file_node, f))

    return converted


def convert_animations(src_dir, dst_dir):
    src_files = fwenv.GlobRecursive("*.zip", Dir(src_dir + "animations/"))
    converted = []

    for f in src_files:
        app_name = "" if (f.Dir(".").name == "animations") else (f.Dir(".").name + "/")
        file_node = dst_dir.File(
            app_name + "animations/" + splitext(f.name)[0] + ".anim"
        )
        converted.append(fw_assets_env.AnimationConverter(file_node, f))

    return converted


def convert_themes(src_dir, dst_dir):
    src_files = fwenv.GlobRecursive("*.zip", Dir(src_dir + "themes/"))
    converted = []

    for f in src_files:
        app_name = "" if (f.Dir(".").name == "themes") else (f.Dir(".").name + "/")
        file_node = dst_dir.File(
            app_name + "themes/" + splitext(f.name)[0] + "/bg.anim"
        )

        converted.append(fw_assets_env.AnimationConverter(file_node, f))

    return converted


def convert_images(src_dir, dst_dir):
    src_files = fwenv.GlobRecursive("*.png", Dir(src_dir + "images/external/"))
    converted = []

    for f in src_files:
        app_name = "" if (f.Dir(".").name == "external") else (f.Dir(".").name + "/")
        file_node = dst_dir.File(app_name + "images/" + splitext(f.name)[0] + ".image")
        converted.append(fw_assets_env.ImageConverter(file_node, f, FORMAT="BIN"))

    return converted


def convert_fonts(src_dir, dst_dir):
    # TODO: perform conversion from ttf once `lv_font_conv` arrives to the toolchain
    src_files = fwenv.GlobRecursive("*.font", Dir(src_dir + "fonts/"))
    converted = []

    for f in src_files:
        app_name = "" if (f.Dir(".").name == "fonts") else (f.Dir(".").name + "/")
        file_node = dst_dir.File(app_name + "fonts/" + splitext(f.name)[0] + ".font")
        converted.append(fw_assets_env.FontConverter(file_node, f))

    return converted

def compresses(src_file):
    import gzip as gz_module
    import io

    if src_file.suffix not in [".html", ".js", ".css", ".svg", ".ttf", ".ico"]:
        return False
    src_path = src_file.rfile().abspath
    with open(src_path, "rb") as f:
        data = f.read()
    buf = io.BytesIO()
    with gz_module.GzipFile(fileobj=buf, mode="wb", mtime=0) as gz_f:
        gz_f.write(data)
    return len(buf.getvalue()) < len(data)


def convert_web_assets(src_dir, dst_dir):
    import SCons.Node.FS

    src_root = Dir(src_dir).abspath
    dst_root = Dir(dst_dir).abspath

    src_files = fwenv.GlobRecursive("*", Dir(src_dir))
    converted = []

    for src_file in src_files:
        if not isinstance(src_file, SCons.Node.FS.File):
            continue
        rel_path = os.path.relpath(src_file.abspath, src_root)
        if compresses(src_file):
            target_file = fw_assets_env.File(os.path.join(dst_root, rel_path) + ".gz")
            converted.append(fw_assets_env.Gzip(target_file, src_file))
        else:
            target_file = fw_assets_env.File(os.path.join(dst_root, rel_path))
            converted.append(fw_assets_env.Copy(target_file, src_file))
    return converted

if fwenv.get("IS_BASE_FIRMWARE", False):
    app_assets_dir = fwenv.Dir("${BUILD_DIR}/apps_assets")
    shared_assets_dir = fwenv.Dir("${BUILD_DIR}/apps_assets/shared")

    resources_dist = []
    converters_app = [
        convert_sounds,
        convert_animations,
        convert_themes,
        convert_images,
        convert_fonts,
    ]
    converters_shared = [
        convert_sounds,
        convert_animations,
        convert_images,
        convert_fonts,
    ]

    for converter in converters_app:
        resources_dist += converter("#/assets/", app_assets_dir)

    for converter in converters_shared:
        resources_dist += converter("#/assets/shared/", shared_assets_dir)

    swagger_files = fw_assets_env.SwaggerGenerator(
        app_assets_dir.File("web_server/www/docs/index.html"),
        fw_assets_env.Real(
            app_assets_dir.File(
                "#/applications/services/web_server/resources/apps_assets/web_server/www/openapi.yaml"
            )
        ),
        SWAGGER_DIST_DIR=fw_assets_env.Dir("#assets/swagger").rdir(),
    )
    resources_dist.append(swagger_files)

    resources_dist.append(convert_web_assets("#assets/frontend-build/public", fwenv.Dir("${BUILD_DIR}/apps_assets/web_server/www")))

    # Resources & manifest for SD card
    resources_env = fwenv.Clone(tools=["fbt_resources"])
    resources_dist_nodes = resources_env.ResourcesDistBuilder(
        _EXTRA_DIST=[
            app_assets_dir,
        ]
    )
    manifest = resources_env.ManifestBuilder(
        "${RESOURCES_ROOT}/Manifest",
        source=resources_dist_nodes,
        GIT_UNIX_TIMESTAMP=get_git_commit_unix_timestamp(
            target_dir=fwenv.Dir("${PROJECT_ROOT}").abspath
        ),
    )
    fwenv.Replace(FW_RESOURCES_MANIFEST=manifest)
    Depends(manifest, resources_dist)

    Alias("resources", manifest)
