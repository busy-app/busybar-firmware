Import("FW_ENV")
fwenv = FW_ENV

from SCons.Util import splitext
from fbt.version import get_git_commit_unix_timestamp

fwenv.SetDefault(RESOURCES_ROOT=fwenv.Dir("${BUILD_DIR}/resources"))

fw_assets_env = fwenv.Clone(tools=["bsb_assets"])

def convert_sounds():
    src_files = fwenv.GlobRecursive("*.wav", Dir("#/assets/sounds/"))
    converted = []

    for f in src_files:
        file_node = assets_dir.File(
            f.Dir(".").name + "/sounds/" + splitext(f.name)[0] + ".snd"
        )
        converted.append(fw_assets_env.AudioConverter(file_node, f))

    return converted

def convert_animations():
    src_files = fwenv.GlobRecursive("*.zip", Dir("#/assets/animations/"))
    converted = []

    for f in src_files:
        file_node = assets_dir.File(
            f.Dir(".").name + "/animations/" + splitext(f.name)[0] + ".anim"
        )
        converted.append(fw_assets_env.AnimationConverter(file_node, f))

    return converted

def convert_themes():
    src_files = fwenv.GlobRecursive("*.zip", Dir("#/assets/themes/"))
    converted = []

    for f in src_files:
        file_node = assets_dir.File(
            f.Dir(".").name + "/themes/" + splitext(f.name)[0] + "/bg.anim"
        )

        converted.append(fw_assets_env.AnimationConverter(file_node, f))

    return converted

def convert_images():
    src_files = fwenv.GlobRecursive("*.png", Dir("#/assets/images/external"))
    converted = []

    for f in src_files:
        internal_name = splitext(f.name)[0]
        file_node = assets_dir.File(
            f.Dir(".").name + "/images/" + internal_name + ".bin"
        )
        converted.append(
            fw_assets_env.ImageConverter(
                file_node, f, IMAGE_FILE_FORMAT="BIN", IMAGE_INTERNAL_NAME=internal_name
            )
        )

    return converted

def convert_web_api():
    swagger_files = fw_assets_env.SwaggerGenerator(
        assets_dir.File("web_server/www/docs/index.html"),
        fw_assets_env.Real(
            assets_dir.File(
                "#/applications/services/web_server/resources/apps_assets/web_server/www/openapi.yaml"
            )
        ),
        SWAGGER_DIST_DIR=fw_assets_env.Dir("#assets/swagger").rdir(),
    )
    resources_dist.append(swagger_files)

    return fw_assets_env.Dir("#assets/frontend-build/public/").rdir()

def convert_fonts():
    # TODO: perform conversion from ttf once `lv_font_conv` arrives to the toolchain
    src_files = fwenv.GlobRecursive("*.font", Dir("#/assets/fonts"))
    converted = []

    for f in src_files:
        file_node = assets_dir.File(
            f.Dir(".").name + "/fonts/" + splitext(f.name)[0] + ".font"
        )
        converted.append(fw_assets_env.FontConverter(file_node, f))

    return converted


if fwenv.get("IS_BASE_FIRMWARE", False):
    assets_dir = fwenv.Dir("${BUILD_DIR}/apps_assets")

    resources_dist = []
    converters = [
        convert_sounds,
        convert_animations,
        convert_themes,
        convert_images,
        convert_fonts,
    ]
    for converter in converters:
        resources_dist += converter()

    # Resources & manifest for SD card
    resources_env = fwenv.Clone(tools=["fbt_resources"])
    resources_dist_nodes = resources_env.ResourcesDistBuilder(
        _EXTRA_DIST=[
            assets_dir,
            (convert_web_api(), "apps_assets/web_server/www"),
        ],
    )
    manifest = resources_env.ManifestBuilder(
        "${RESOURCES_ROOT}/Manifest",
        source=resources_dist_nodes,
        GIT_UNIX_TIMESTAMP=get_git_commit_unix_timestamp(
            target_dir=fwenv.Dir("${PROJECT_ROOT}").abspath
        ),
    )
    fwenv.Replace(FW_RESOURCES_MANIFEST=manifest)
    Depends(manifest, resources_dist)

    Alias("resources", manifest)
