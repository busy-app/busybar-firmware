Import("FW_ENV")
fwenv = FW_ENV

from SCons.Util import splitext
from fbt.util import GLOB_FILE_EXCLUSION

proto_env = fwenv.Clone(tools=["fbt_assets"], PROTO_BUILD_DIR="${BUILD_DIR}/proto", FW_LIB_NAME="proto")

proto_src = proto_env.GlobRecursive("*.proto", "#/assets/proto", exclude=GLOB_FILE_EXCLUSION)
proto_options = proto_env.GlobRecursive("*.options", "#/assets/proto", exclude=GLOB_FILE_EXCLUSION)
proto = proto_env.ProtoBuilder(proto_env["PROTO_BUILD_DIR"], proto_src)
proto_env.Depends(proto, proto_options)
Precious(proto)

proto_lib = proto_env.StaticLibrary("${FW_LIB_NAME}", proto)
proto_env.Install("${LIB_DIST_DIR}", proto_lib)

Alias("proto", proto_lib)
