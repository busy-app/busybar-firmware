              <name>CCK0DIR</name>
              <description>CCK0DIR</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>CCK1DIR</name>
              <description>CCK1DIR</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
