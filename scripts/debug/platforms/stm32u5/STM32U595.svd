                    <name>B_0xC</name>
                    <description>range 12 around 400�kHz</description>
                    <value>0xC</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0xD</name>
                    <description>range 13 around 200�kHz</description>
                    <value>0xD</value>
