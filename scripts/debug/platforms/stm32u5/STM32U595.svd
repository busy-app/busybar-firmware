                  <enumeratedValue>
                    <name>B_0x0</name>
                    <description>normal mode (standard slew rate)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_0x1</name>
                    <description>increased consumption to improve the slew rate</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
