# BUSY Bar Test Environment Configuration
# Copy this file to .env and update with your values

# === Application URLs ===
BASE_URL=http://busybar.local
CLOUD_URL=https://cloud.busy.app

# Alternative device access (if not using busybar.local)
# DEVICE_IP=10.0.4.20
# DEVICE_PORT=80

# === Browser Configuration ===
# Options: chromium, firefox, webkit
BROWSER=chromium
HEADLESS=false
SLOW_MO=0  # Milliseconds between actions (0 for normal speed)

# === Timeouts (seconds) ===
DEFAULT_TIMEOUT=30
NAVIGATION_TIMEOUT=60
ELEMENT_TIMEOUT=10

# === Test Execution ===
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=false
TRACE_ON_FAILURE=true
RETRY_COUNT=3
RETRY_DELAY=1

# === Environment ===
# Options: local, ci, staging, production
ENVIRONMENT=local
CI_MODE=false

# === Paths ===
SCREENSHOT_DIR=artifacts/screenshots
VIDEO_DIR=artifacts/videos
TRACE_DIR=artifacts/traces
LOG_DIR=artifacts/logs

# === Test Data ===
# WiFi Test Configuration
TEST_WIFI_SSID=TestNetwork
TEST_WIFI_PASSWORD=TestPassword123!

# Bluetooth Test Configuration
TEST_BLUETOOTH_DEVICE=TestDevice
TEST_BLUETOOTH_PIN=1234

# === Reporting ===
ALLURE_RESULTS_DIR=reports/allure-results
ALLURE_REPORT_DIR=reports/allure-report

# === API Configuration (if needed) ===
# API_BASE_URL=http://api.busybar.local
# API_KEY=your-api-key-here
# API_TIMEOUT=30

# === Database (if needed) ===
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=busybar_test
# DB_USER=test_user
# DB_PASSWORD=test_password

# === Logging ===
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_TO_FILE=true
LOG_FORMAT=detailed  # simple, detailed, json

# === Parallel Execution ===
PARALLEL_WORKERS=auto  # Number of parallel workers or 'auto'
PARALLEL_SCOPE=function  # function, class, module, session

# === Notifications (optional) ===
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# EMAIL_RECIPIENTS=test-team@example.com

# === Feature Flags ===
ENABLE_VIDEO_RECORDING=false
ENABLE_NETWORK_LOGGING=false
ENABLE_PERFORMANCE_METRICS=false
ENABLE_ACCESSIBILITY_CHECKS=false

# === Cloud Testing (optional) ===
# BROWSERSTACK_USERNAME=your-username
# BROWSERSTACK_ACCESS_KEY=your-key
# SAUCELABS_USERNAME=your-username
# SAUCELABS_ACCESS_KEY=your-key