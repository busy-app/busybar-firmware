{
    "cpu_flags": [
        "-mcpu=cortex-m33",
        "-mthumb",
        "-mfloat-abi=hard",
        "-mfpu=fpv5-sp-d16"
    ],
    "c_cpp_flags": [
        "-g",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wundef",
        "-Wno-error=deprecated-declarations",
        "-Wno-address-of-packed-member",
        "-Wredundant-decls",
        "-Wdouble-promotion",
        "-fdata-sections",
        "-ffunction-sections",
        "-fsingle-precision-constant",
        "-fno-math-errno"
    ],
    "c_flags": [
        "-std=gnu2x",
        "-Wstrict-prototypes"
    ],
    "cpp_flags": [
        "-std=c++20",
        "-fno-rtti",
        "-fno-use-cxa-atexit",
        "-fno-exceptions",
        "-fno-threadsafe-statics",
        "-ftemplate-depth=4096"
    ],
    "asm_flags": [
        "-x",
        "assembler-with-cpp",
        "-c"
    ],
    "linker_flags": [
        "-specs=nano.specs",
        "-mlittle-endian",
        "-Wl,--gc-sections",
        "-Wl,--no-warn-rwx-segment",
        "-Wl,--wrap,_malloc_r",
        "-Wl,--wrap,_free_r",
        "-Wl,--wrap,_calloc_r",
        "-Wl,--wrap,_realloc_r"
    ],
    "defines": [
        "STM32U595xx",
        [
            "HSE_VALUE",
            "16000000U"
        ],
        "USE_FULL_LL_DRIVER",
        "_GNU_SOURCE"
    ],
    "include_paths": [
        "src",
        "config",
        "fatfs",
        "furi_hal",
        "st",
        "st/include",
        "driver",
        "st_abomination",
        "lwip",
        "usb"
    ],
    "env_setup_scripts": [
        "#/bsb_common_env_init.scons",
        "#/core_libs_env_init.scons",
        "#/freertos_env_init.scons"
    ],
    "extra_tool_paths": [
        "../../scripts/fbt_tools"
    ],
    "sdk_headers": [],
    "sources": [
        "startup_stm32u595xx.s",
        "*/*.c"
    ],
    "linker_script_flash": "STM32U595xx_FLASH.ld",
    "linker_script_ram": "STM32U595xx_FLASH.ld",
    "linker_script_app": "application_ext.ld",
    "sdk_symbols": "api_symbols.csv",
    "platform_desc": "../../scripts/debug/platforms/stm32u595.json",
    "rtos_flavor": "freertos-cm33-ntz",
    "lib_modules": [
        "fw_updater_opts",
        "lib_base",
        "mlib",
        "cmsis",
        "freertos",
        "microtar",
        "mbedtls",
        "icon_assets",
        "toolbox",
        "tinyusb",
        "print",
        "fatfs",
        "lwip",
        "lvgl",
        "lvgl_fonts",
        "lvgl_themes",
        "network",
        "mongoose",
        "canvas_oled",
        "flipper_format",
        "flipper_application",
        "heatshrink",
        "bit_lib",
        "datetime",
        "targets",
        "furi",
        "drivers",
        "version",
        "ext_applications",
        "firmware_applications_f20"
    ],
    "fw_modules": [
        "fw_elf",
        "fw_artifacts",
        "fw_cdb",
        "sdk_extapps",
        "link_builddir"
    ],
    "dist_modules": [
        "elf_flash",
        "debug",
        "lint",
        "vscode_project",
        "subl_project",
        "cli"
    ],
    "extra_target_meta": {
        "debug_tags": [
            "rtos",
            "svd"
        ]
    }
}
