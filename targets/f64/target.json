{
    "cpu_flags": [
        "-mcpu=cortex-m4",
        "-mthumb",
        "-mfloat-abi=hard",
        "-mfpu=fpv4-sp-d16"
    ],
    "c_cpp_flags": [
        "-g",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-undef",
        "-Wno-error=deprecated-declarations",
        "-Wno-address-of-packed-member",
        "-Wno-redundant-decls",
        "-Wdouble-promotion",
        "-fdata-sections",
        "-ffunction-sections",
        "-fsingle-precision-constant",
        "-fno-math-errno"
    ],
    "c_flags": [
        "-std=gnu2x"
    ],
    "cpp_flags": [
        "-std=c++20",
        "-fno-rtti",
        "-fno-use-cxa-atexit",
        "-fno-exceptions",
        "-fno-threadsafe-statics",
        "-ftemplate-depth=4096"
    ],
    "asm_flags": [
        "-x",
        "assembler-with-cpp",
        "-c"
    ],
    "linker_flags": [
        "-specs=nano.specs",
        "-mlittle-endian",
        "-Wl,--gc-sections",
        "-Wl,--no-warn-rwx-segment",
        "-Wl,--wrap,_malloc_r",
        "-Wl,--wrap,_free_r",
        "-Wl,--wrap,_calloc_r",
        "-Wl,--wrap,_realloc_r"
    ],
    "defines": [
        "_GNU_SOURCE"
    ],
    "include_paths": [
        "config",
        "furi_hal",
        "inc"
    ],
    "env_setup_scripts": [
        "#/bsb_common_env_init.scons"
    ],
    "extra_tool_paths": [
        "../../scripts/fbt_tools"
    ],
    "sdk_header_paths": [],
    "sources": [
        "*/*.c"
    ],
    "linker_script_flash": "SiWG917M111_flash.ld",
    "variables_sconscript": "fbt_conf/si917_vars.scons",
    "platform_desc": "../../scripts/debug/platforms/siw917.json",
    "rtos_flavor": "freertos-cm4",
    "lib_modules": [
        "lib_base",
        "mlib",
        "cmsis",
        "sl_glue",
        "simplicity_sdk",
        "wiseconnect",
        "freertos",
        "print",
        "targets",
        "furi",
        "nanopb",
        "bsb_protobuf",
        "si917_toolbox",
        "si917_applications"
    ],
    "fw_modules": [
        "fw_elf",
        "fw_artifacts_silabs",
        "fw_cdb",
        "link_builddir"
    ],
    "dist_modules": [
        "sil917_flash",
        "debug",
        "lint",
        "vscode_project",
        "subl_project"
    ],
    "extra_target_meta": {
        "debug_tags": [
            "rtos",
            "svd"
        ]
    }
}
