from fbt_extra.util import find_variable_config

Import("FW_ENV", "VARS")

VARS.AddVariables(
    (
        "SI917_PORT",
        "Serial port for communication with the device's bootloader",
        "auto",
    ),
    (
        "SI917_NWP_STACK",
        "NWP stack to use for the SI917 target",
        "#core2_fw/SiWG917-B.2.13.5.2.0.5.rps",      # WARNING path overrided especially for factory branch
    ),
)

        # "#lib/wiseconnect/connectivity_firmware/standard/SiWG917-B.2.14.5.0.0.10.rps",
# Previous version for 917 ta:
# https://github.com/SiliconLabs/wiseconnect/tree/2f93cc44966f651c51cdd3d4b779d850fbf03d22/connectivity_firmware/standard


# Inject default values for this target into global variables
_fw_default_apps_config = {
    "default": [
        "basic_services",
        "intercom_services",
        "system_apps",
    ],
    "unit_tests": [
        "basic_services",
        "intercom_services",
        "system_apps",
    ],
    "hwtest": [
        "basic_services",
        "system_apps",
        "cli",
        "cli_uart",
    ],
    "917_crash": [
        "basic_services",
        "intercom_services",
        "system_apps",
        "crash",
    ],
    "recovery": [
        "basic_services",
        "intercom_services",
    ],
}

fw_apps_configs_option = find_variable_config(VARS, "FIRMWARE_APPS")
assert isinstance(fw_apps_configs_option.default, dict)
for key, value in _fw_default_apps_config.items():
    fw_apps_configs_option.default[key] = value


fw_appdirs_option = find_variable_config(VARS, "APPDIRS")
assert isinstance(fw_appdirs_option.default, list)
fw_appdirs_option.default.extend((("applications/system", False),))
