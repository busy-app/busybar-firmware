from fbt_extra.util import find_variable_config

Import("FW_ENV", "VARS")

# Inject default values for this target into global variables
_fw_default_apps_config = {
    "default": [
        "basic_services",
        "extended_services",
        "main_apps",
        "settings",
        "system_apps",
        "debug_apps",
    ],
    "unit_tests": [
        "basic_services",
        "extended_services",
        "settings",
        "system_apps",
        "main_apps",
        "debug_apps",
        "unit_tests",
    ],
    "917_crash": [
        "basic_services",
        "extended_services",
        "main_apps",
        "settings",
        "system_apps",
        "debug_apps",
    ],
    "recovery": [
        "basic_services",
        "recovery",
    ],
}

fw_apps_configs_option = find_variable_config(VARS, "FIRMWARE_APPS")
assert isinstance(fw_apps_configs_option.default, dict)
for key, value in _fw_default_apps_config.items():
    fw_apps_configs_option.default[key] = value


fw_appdirs_option = find_variable_config(VARS, "APPDIRS")
assert isinstance(fw_appdirs_option.default, list)
fw_appdirs_option.default.extend((("applications/system", True),))
fw_appdirs_option.default.extend((("applications/debug", False),))
fw_appdirs_option.default.extend((("applications/settings", False),))

Help("\nBuild variables:" + VARS.GenerateHelpText(FW_ENV), append=True)
